# Twilio voice-call brain — template. Copy to .env and fill in.
# The real .env is gitignored.

# From console.twilio.com — Account SID + Auth Token on the dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# A Twilio phone number you own (E.164 format, e.g. +18165551234).
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# The number to call. On a trial account this MUST be a Twilio-verified number.
MY_PHONE_NUMBER=+1XXXXXXXXXX

# From console.anthropic.com — separate from your Claude Code subscription, pay-per-token.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# The public wss:// URL cloudflared gives you, with /ws on the end.
PUBLIC_WS_URL=wss://your-subdomain.trycloudflare.com/ws

# Agent brain model. Sonnet handles tool orchestration far better than Haiku.
AGENT_MODEL=claude-sonnet-4-6

# PIN to unlock write actions over the phone (keypad or spoken). Blank = all writes locked.
VOICE_PIN=4242

# Text-to-speech voice. Provider: Google | Amazon | ElevenLabs. Amazon format Name-Engine.
TTS_PROVIDER=Amazon
TTS_VOICE=Matthew-Neural

# Numbers trusted for read access on inbound calls (comma-separated, E.164).
# Defaults to MY_PHONE_NUMBER if unset. Unknown callers must PIN even to read.
ALLOWED_CALLERS=+1XXXXXXXXXX

# Google Calendar MCP (optional). Defaults to phone/gcp-oauth.keys.json and
# phone/gcal-token.json. Calendar tools load only once the credentials file exists.
# Download a "Desktop app" OAuth client from Google Cloud as gcp-oauth.keys.json.
# GOOGLE_OAUTH_CREDENTIALS=/abs/path/to/gcp-oauth.keys.json
# GOOGLE_CALENDAR_MCP_TOKEN_PATH=/abs/path/to/gcal-token.json
