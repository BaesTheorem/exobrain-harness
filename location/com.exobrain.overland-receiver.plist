<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.exobrain.overland-receiver</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alexhedtke/.local/bin/mist-launch</string>
		<string>/Users/alexhedtke/.local/libexec/procname/overland-recv</string>
		<string>/Users/alexhedtke/Documents/Exobrain harness/location/receiver.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/overland-receiver.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/overland-receiver.log</string>
	<!-- Login Items shows the job under this app instead of its executable's name;
	     only honored because mist-launch is signed by the same team. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
	    <string>com.exobrain.mist-console</string>
	</array>
</dict>
</plist>
