<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.zulip-listener</string>
    <!-- claude_zulip.listener comes from the claude-zulip-kit package
         (github.com/BaesTheorem/claude-zulip-kit) installed in zulip/.venv: zulipmcp's
         listener plus catch-up after sleep and the usage ledger's limits. The venv
         python is spawned directly (no bash wrapper): a wrapper that execs a venv
         interpreter from ~/Documents fails macOS TCC under launchd. Sessions run as
         the full MIST: harness working directory, harness .mcp.json, no tool
         denylist (Alex's call, 2026-09-10); the policy in system-prompt.md is the
         guard rail. Everything after the bare "--" is passed through to the claude
         CLI. After editing this file: cp to ~/Library/LaunchAgents, then bootout +
         bootstrap. kickstart alone keeps the old arguments. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/alexhedtke/Documents/Exobrain harness/zulip/.venv/bin/python</string>
        <string>-m</string>
        <string>claude_zulip.listener</string>
        <string>--zuliprc</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/zulip/.zuliprc</string>
        <string>--mcp-config</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/.mcp.json</string>
        <string>--system-prompt</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/zulip/system-prompt.md</string>
        <string>--working-dir</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness</string>
        <string>--log-dir</string>
        <string>/Users/alexhedtke/Library/Logs/exobrain/zulip-sessions</string>
        <string>--state-dir</string>
        <string>/Users/alexhedtke/.claude/channels/zulip</string>
        <string>--limits</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/zulip/limits.json</string>
        <string>--</string>
        <string>--model</string>
        <string>claude-opus-5</string>
        <string>--max-budget-usd</string>
        <string>2</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/alexhedtke/.claude/channels/zulip</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alexhedtke/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>ZULIPMCP_TIMEZONE</key>
        <string>America/Chicago</string>
        <key>ZULIPMCP_LOG_DIR</key>
        <string>/Users/alexhedtke/Library/Logs/exobrain/zulip-sessions</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/zulip-listener.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/zulip-listener.log</string>
</dict>
</plist>
