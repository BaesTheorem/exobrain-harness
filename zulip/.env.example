# Alex's own Zulip account (org admin). Copy to .env (gitignored) and fill in.
ZULIP_SITE=https://your-org.zulipchat.com
ZULIP_EMAIL=you@example.com
# Personal settings -> Account & privacy -> API key, or `bin/zulip-admin fetch-key`
ZULIP_API_KEY=
# Only needed by fetch-key (password auth). Leave empty if you sign in with Google.
ZULIP_PASSWORD=
# Written by `bin/zulip-admin invite-link`; reused in the DM template.
ZULIP_INVITE_LINK=
