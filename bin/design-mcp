#!/usr/bin/env python3
"""design-mcp: a stdio MCP server that proxies Claude Design's own MCP endpoint.

Claude Code ships a native `Design` tool that talks to
POST https://api.anthropic.com/v1/design/mcp with the credential `/design-login`
stores, but that tool only loads behind a server-side feature flag. The endpoint
itself is a plain streamable-HTTP MCP server, so this proxy exposes it as a
stdio server any session can register:

    claude mcp add -s user claude-design -- /path/to/bin/design-mcp

Tools then appear as mcp__claude-design__<name>: list_projects, create_project,
get_claude_design_prompt, finalize_plan, write_files, read_file, list_files,
render_preview, get_conversation, list_comments, and the rest.

What the proxy adds on top of a dumb pipe:
- The design OAuth token comes from the Keychain item Claude Code keeps
  ("Claude Code-credentials", key designOauth). It is refreshed when expired
  (or on a 401) at the same token endpoint the CLI uses, and the rotated
  tokens are written back so the CLI's copy stays valid.
- write_files accepts {path, local_path}: the file is read from disk and sent
  inline (base64 for anything that is not UTF-8 text). The server rejects
  local_path itself, and this is how screenshots and seed folders get in.

Stdio framing is newline-delimited JSON-RPC, the MCP stdio transport.
"""
import base64
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

ENDPOINT = "https://api.anthropic.com/v1/design/mcp"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
KEYCHAIN_SERVICE = "Claude Code-credentials"
SCOPES = "user:design:read user:design:write"
LOCK = os.path.expanduser("~/.claude/.design_oauth_refresh.lock")
TEXT_EXT = {".md", ".txt", ".css", ".html", ".htm", ".js", ".mjs", ".json", ".svg", ".csv", ".tsx", ".ts", ".jsx", ".yml", ".yaml", ".xml"}


def log(*a):
    print("design-mcp:", *a, file=sys.stderr, flush=True)


# ---- credentials ---------------------------------------------------------------
def _keychain_read():
    out = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
                         capture_output=True, text=True, check=True).stdout.strip()
    return json.loads(out)


def _keychain_write(store):
    acct = os.environ.get("USER") or os.getlogin()
    subprocess.run(["/usr/bin/security", "add-generic-password", "-U", "-a", acct, "-s", KEYCHAIN_SERVICE,
                    "-w", json.dumps(store)], capture_output=True, text=True, check=True)


class Creds:
    def __init__(self):
        self.store = None
        self.design = None

    def load(self):
        self.store = _keychain_read()
        self.design = self.store.get("designOauth")
        if not self.design or not self.design.get("accessToken"):
            raise SystemExit("design-mcp: no design credential in the Keychain; run /design-login in a terminal first")
        return self.design

    def token(self):
        d = self.design or self.load()
        if d.get("expiresAt") and d["expiresAt"] < time.time() * 1000 + 60_000:
            self.refresh()
        return self.design["accessToken"]

    def refresh(self):
        d = self.design or self.load()
        try:
            fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(fd)
        except FileExistsError:
            # The CLI (or another proxy) is refreshing; wait for it and re-read.
            for _ in range(50):
                time.sleep(0.2)
                if not os.path.exists(LOCK):
                    break
            self.load()
            return
        try:
            body = json.dumps({"grant_type": "refresh_token", "refresh_token": d["refreshToken"],
                               "client_id": d.get("clientId") or os.environ.get("CLAUDE_CODE_DESIGN_OAUTH_CLIENT_ID", ""),
                               "scope": SCOPES}).encode()
            req = urllib.request.Request(TOKEN_URL, data=body, method="POST",
                                         headers={"Content-Type": "application/json", "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=30) as r:
                tok = json.loads(r.read().decode())
            d["accessToken"] = tok["access_token"]
            if tok.get("refresh_token"):
                d["refreshToken"] = tok["refresh_token"]
            d["expiresAt"] = int(time.time() * 1000 + int(tok.get("expires_in", 3600)) * 1000)
            if tok.get("scope"):
                d["scopes"] = tok["scope"].split()
            fresh = _keychain_read()
            fresh["designOauth"] = d
            _keychain_write(fresh)
            self.store, self.design = fresh, d
            log("design token refreshed")
        finally:
            try:
                os.remove(LOCK)
            except OSError:
                pass


# ---- the HTTP side -------------------------------------------------------------
class Upstream:
    def __init__(self, creds):
        self.creds = creds
        self.session = None

    def post(self, msg, retry=True):
        data = json.dumps(msg).encode()
        headers = {"Authorization": "Bearer " + self.creds.token(), "Content-Type": "application/json",
                   "Accept": "application/json, text/event-stream", "X-Anthropic-Client": "claude-cli-design-tool"}
        if self.session:
            headers["Mcp-Session-Id"] = self.session
        req = urllib.request.Request(ENDPOINT, data=data, method="POST", headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=120) as r:
                sid = r.headers.get("Mcp-Session-Id")
                if sid:
                    self.session = sid
                ctype = r.headers.get("Content-Type", "")
                raw = r.read()
        except urllib.error.HTTPError as e:
            if e.code == 401 and retry:
                self.creds.refresh()
                return self.post(msg, retry=False)
            detail = e.read().decode(errors="replace")[:500]
            return [{"jsonrpc": "2.0", "id": msg.get("id"),
                     "error": {"code": -32000, "message": f"Claude Design HTTP {e.code}: {detail}"}}] if "id" in msg else []
        if not raw:
            return []
        if ctype.startswith("text/event-stream"):
            out = []
            for block in raw.decode().split("\n\n"):
                payload = "\n".join(line[5:].lstrip() for line in block.splitlines() if line.startswith("data:"))
                if payload.strip():
                    try:
                        out.append(json.loads(payload))
                    except ValueError:
                        pass
            return out
        try:
            parsed = json.loads(raw.decode())
        except ValueError:
            return []
        return parsed if isinstance(parsed, list) else [parsed]


# ---- local_path support --------------------------------------------------------
def inline_local_files(msg):
    """write_files with {path, local_path}: read the file and send it inline."""
    params = msg.get("params") or {}
    if msg.get("method") != "tools/call" or params.get("name") != "write_files":
        return msg
    files = (params.get("arguments") or {}).get("files") or []
    for f in files:
        lp = f.pop("local_path", None)
        if not lp or "data" in f:
            continue
        lp = os.path.expanduser(lp)
        with open(lp, "rb") as fh:
            blob = fh.read()
        ext = os.path.splitext(lp)[1].lower()
        text = None
        if ext in TEXT_EXT:
            try:
                text = blob.decode("utf-8")
            except UnicodeDecodeError:
                text = None
        if text is not None:
            f["data"] = text
        else:
            f["data"] = base64.b64encode(blob).decode()
            f["encoding"] = "base64"
    return msg


# ---- main loop -----------------------------------------------------------------
def main():
    creds = Creds()
    creds.load()
    up = Upstream(creds)
    out = sys.stdout
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        try:
            msg = inline_local_files(msg)
        except OSError as e:
            if "id" in msg:
                out.write(json.dumps({"jsonrpc": "2.0", "id": msg["id"],
                                      "error": {"code": -32602, "message": f"local_path: {e}"}}) + "\n")
                out.flush()
            continue
        for reply in up.post(msg):
            out.write(json.dumps(reply) + "\n")
        out.flush()


if __name__ == "__main__":
    main()
