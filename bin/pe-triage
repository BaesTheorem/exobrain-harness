#!/usr/bin/env -S uv run --quiet --with pefile python3
"""Static triage of a PE file: headers, sections, imports, resources, overlay,
installer/packer tells, and the hashes worth looking up. Never executes it.

usage: bin/pe-triage <file>   (pefile is pulled in by uv on first run)
"""
import hashlib, math, os, re, sys, json, collections
import pefile

path = sys.argv[1]
size = os.path.getsize(path)
out = {"file": os.path.basename(path), "size": size}

def sha256(data): return hashlib.sha256(data).hexdigest()
def entropy(b):
    if not b: return 0.0
    c = collections.Counter(b); n = len(b)
    return -sum((v/n) * math.log2(v/n) for v in c.values())

with open(path, "rb") as f:
    whole = f.read()
out["sha256"] = sha256(whole)
out["md5"] = hashlib.md5(whole).hexdigest()

pe = pefile.PE(data=whole, fast_load=False)
oh, fh = pe.OPTIONAL_HEADER, pe.FILE_HEADER
import datetime
out["header"] = {
    "machine": hex(fh.Machine),
    "compile_timestamp": datetime.datetime.fromtimestamp(fh.TimeDateStamp, datetime.UTC).isoformat().replace("+00:00", "Z"),
    "subsystem": oh.Subsystem, "subsystem_name": pefile.SUBSYSTEM_TYPE.get(oh.Subsystem),
    "entry_point": hex(oh.AddressOfEntryPoint), "image_base": hex(oh.ImageBase),
    "size_of_image": oh.SizeOfImage, "linker": f"{oh.MajorLinkerVersion}.{oh.MinorLinkerVersion}",
    "dll_characteristics": hex(oh.DllCharacteristics),
    "checksum_header": hex(oh.CheckSum), "checksum_actual": hex(pe.generate_checksum()),
}
# overlay
overlay_off = pe.get_overlay_data_start_offset() or size
overlay = whole[overlay_off:]
out["pe_image_bytes"] = overlay_off
out["overlay"] = {
    "offset": overlay_off, "bytes": len(overlay), "pct_of_file": round(100*len(overlay)/size, 2),
    "entropy_first_1MB": round(entropy(overlay[:1<<20]), 3),
    "entropy_mid_1MB": round(entropy(overlay[len(overlay)//2: len(overlay)//2 + (1<<20)]), 3),
    "entropy_last_1MB": round(entropy(overlay[-(1<<20):]), 3),
    "first_16": overlay[:16].hex(), "last_16": overlay[-16:].hex(),
    "all_zero_sample": all(b == 0 for b in overlay[:1<<20]) if overlay else None,
}
out["sha256_pe_image_only"] = sha256(whole[:overlay_off])
try: out["imphash"] = pe.get_imphash()
except Exception as e: out["imphash"] = f"err {e}"
try: out["rich_header"] = bool(pe.RICH_HEADER)
except Exception: out["rich_header"] = None

out["sections"] = [{
    "name": s.Name.rstrip(b"\0").decode(errors="replace"), "vaddr": hex(s.VirtualAddress),
    "vsize": s.Misc_VirtualSize, "rawsize": s.SizeOfRawData,
    "entropy": round(s.get_entropy(), 3), "chars": hex(s.Characteristics),
    "x": bool(s.Characteristics & 0x20000000), "w": bool(s.Characteristics & 0x80000000),
} for s in pe.sections]

imports = {}
if hasattr(pe, "DIRECTORY_ENTRY_IMPORT"):
    for e in pe.DIRECTORY_ENTRY_IMPORT:
        imports[e.dll.decode(errors="replace")] = [i.name.decode(errors="replace") if i.name else f"ord{i.ordinal}" for i in e.imports]
out["imports"] = imports
out["import_count"] = sum(len(v) for v in imports.values())
SUS = ["VirtualAlloc","VirtualProtect","WriteProcessMemory","CreateRemoteThread","NtUnmapViewOfSection",
       "SetWindowsHookEx","GetAsyncKeyState","URLDownloadToFile","InternetOpen","WinHttpOpen","HttpSendRequest",
       "CryptEncrypt","CryptDecrypt","IsDebuggerPresent","CheckRemoteDebuggerPresent","ShellExecute","WinExec",
       "CreateProcess","RegSetValue","CreateService","OpenClipboard","GetClipboardData","CredEnumerate",
       "LoadLibrary","GetProcAddress","AdjustTokenPrivileges","CreateToolhelp32Snapshot","NtQueryInformationProcess"]
flat = [n for v in imports.values() for n in v]
out["suspicious_imports"] = sorted({s for s in SUS if any(s in n for n in flat)})
out["exports"] = [e.name.decode() for e in pe.DIRECTORY_ENTRY_EXPORT.symbols if e.name] if hasattr(pe, "DIRECTORY_ENTRY_EXPORT") else []
out["tls_callbacks"] = bool(getattr(pe, "DIRECTORY_ENTRY_TLS", None))
# debug / pdb
pdb = []
if hasattr(pe, "DIRECTORY_ENTRY_DEBUG"):
    for d in pe.DIRECTORY_ENTRY_DEBUG:
        e = d.entry
        if e and hasattr(e, "PdbFileName"): pdb.append(e.PdbFileName.rstrip(b"\0").decode(errors="replace"))
out["pdb_paths"] = pdb
# signature
sec = oh.DATA_DIRECTORY[pefile.DIRECTORY_ENTRY["IMAGE_DIRECTORY_ENTRY_SECURITY"]]
out["authenticode"] = {"present": bool(sec.VirtualAddress), "size": sec.Size}
# resources: version info + types
res = {"types": [], "version_info": {}, "icons": 0, "rcdata_bytes": 0}
if hasattr(pe, "DIRECTORY_ENTRY_RESOURCE"):
    for t in pe.DIRECTORY_ENTRY_RESOURCE.entries:
        name = pefile.RESOURCE_TYPE.get(t.id, str(t.id)) if t.name is None else str(t.name)
        res["types"].append(name)
        if name == "RT_ICON": res["icons"] += 1
        if name == "RT_RCDATA":
            for e in t.directory.entries:
                for l in e.directory.entries: res["rcdata_bytes"] += l.data.struct.Size
if hasattr(pe, "VS_VERSIONINFO") and hasattr(pe, "FileInfo"):
    for fi in pe.FileInfo:
        for entry in fi:
            if hasattr(entry, "StringTable"):
                for st in entry.StringTable:
                    for k, v in st.entries.items():
                        res["version_info"][k.decode(errors="replace")] = v.decode(errors="replace")
out["resources"] = res
# tells
tells = []
img = whole[:overlay_off]
for pat, label in [(b"Nullsoft", "NSIS installer"), (b"NSIS", "NSIS"), (b"Inno Setup", "Inno Setup"),
                   (b"7-Zip", "7z SFX"), (b"WinRAR", "WinRAR SFX"), (b"UPX!", "UPX packed"),
                   (b"Smart Install Maker", "Smart Install Maker"), (b"InstallShield", "InstallShield"),
                   (b"AutoIt", "AutoIt"), (b"pyinstaller", "PyInstaller"), (b"PYZ-00.pyz", "PyInstaller"),
                   (b".NET", ".NET marker"), (b"mscoree.dll", ".NET (mscoree)"), (b"Electron", "Electron"),
                   (b"This program cannot be run in DOS mode", "DOS stub present")]:
    if pat in img or pat in overlay[:4<<20]: tells.append(label)
out["tells"] = sorted(set(tells))
# strings of interest from the image + first 8MB of overlay
hay = img + overlay[:8<<20]
def find(rx, flags=0, limit=40):
    return sorted({m.decode(errors="replace") for m in re.findall(rx, hay, flags)})[:limit]
out["strings"] = {
    "urls": find(rb"https?://[\w\-\.\:/\?\=\&%#~]{6,120}"),
    "ipv4": find(rb"\b(?:\d{1,3}\.){3}\d{1,3}\b"),
    "hosts": [h for h in find(rb"\b[a-z0-9\-]{2,40}\.(?:com|net|org|ru|io|xyz|top|site|online|shop|info|cc|to|me|su|cn)\b", re.I, 60) if not h.lower().endswith((".dll",".exe"))],
    "paths": find(rb"[A-Za-z]:\\[\w\\\.\- ]{4,80}", 0, 30),
    "registry": find(rb"(?:HKEY_[A-Z_]+|SOFTWARE\\[\w\\ ]{3,60})", 0, 30),
    "commands": find(rb"(?:powershell|cmd\.exe|rundll32|regsvr32|schtasks|wscript|mshta|certutil|bitsadmin)[^\x00\r\n]{0,80}", re.I, 30),
    "webhooks_tokens": find(rb"(?:discord(?:app)?\.com/api/webhooks/\S{10,}|api\.telegram\.org/bot\S{10,})", re.I),
    "wallet_regex_hits": find(rb"(?:bc1[a-z0-9]{25,60}|0x[a-fA-F0-9]{40})", 0, 10),
}
# wide (UTF-16LE) strings: version-info and lures often live there
wide = re.findall(rb"(?:[\x20-\x7e]\x00){8,}", hay)
wide = sorted({w.decode("utf-16le", errors="replace") for w in wide})
out["wide_strings_sample"] = [w for w in wide if re.search(r"(codec|player|install|update|setup|video|download|vlc|http|click|run|require|episode|1080|lanterns|password|license|agree)", w, re.I)][:60]
out["wide_string_count"] = len(wide)
print(json.dumps(out, indent=2, default=str))
