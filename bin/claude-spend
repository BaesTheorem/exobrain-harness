#!/usr/bin/env python3
"""Estimate what Claude Code usage would cost at API rates.

Scans ~/.claude/projects/**/*.jsonl (Claude Code session transcripts), dedupes
assistant messages by (message.id, requestId) since one API response is logged
once per content block, and prices tokens per model per month. Each usage field
takes its max over the lines of one response: the earlier lines can carry a
partial count (first-line output tokens were 19.6% low over 30 days, measured
2026-10-15).

Usage: claude-spend [--json]

Rates are $/MTok: input, output, cache write 5m, cache write 1h, cache read.
Source: /claude-api skill model table (cached 2026-09-25); cache write = 1.25x
(5m) / 2x (1h) base input, cache read as listed per model.
"""
import glob
import json
import os
import sys
from collections import defaultdict

RATES = {
    "claude-fable-5-1": (10, 50, 12.5, 20, 0.25),
    "claude-fable-5": (10, 50, 12.5, 20, 0.25),
    "claude-opus-5-5": (4, 20, 5, 8, 0.20),
    "claude-opus-5": (5, 25, 6.25, 10, 0.50),
    "claude-opus-4-8": (5, 25, 6.25, 10, 0.50),
    "claude-sonnet-5-5": (2, 10, 2.5, 4, 0.20),
    "claude-sonnet-5": (2, 10, 2.5, 4, 0.20),
    "claude-haiku-4-5": (1, 5, 1.25, 2, 0.10),
}


def rate_for(model):
    for k in sorted(RATES, key=len, reverse=True):
        if model.startswith(k):
            return RATES[k]
    return None


def main():
    calls = {}  # (message id, request id) -> {"ts", "model", usage field -> max}
    for path in glob.glob(os.path.expanduser("~/.claude/projects/**/*.jsonl"), recursive=True):
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("type") != "assistant":
                    continue
                m = e.get("message") or {}
                u = m.get("usage")
                model = m.get("model", "")
                if not u or not model or model.startswith("<"):
                    continue
                ts = e.get("timestamp", "")[:10]
                if not ts:
                    continue
                cc = u.get("cache_creation") or {}
                w5 = cc.get("ephemeral_5m_input_tokens")
                w1 = cc.get("ephemeral_1h_input_tokens")
                if w5 is None and w1 is None:
                    w5, w1 = u.get("cache_creation_input_tokens", 0), 0
                fields = {"in": u.get("input_tokens", 0), "out": u.get("output_tokens", 0),
                          "cr": u.get("cache_read_input_tokens", 0), "w5": w5, "w1": w1}
                c = calls.setdefault((m.get("id"), e.get("requestId")), {"ts": ts, "model": model})
                for f, v in fields.items():
                    c[f] = max(c.get(f, 0), v or 0)

    tok = defaultdict(lambda: defaultdict(float))  # (month, model) -> field -> n
    unknown = defaultdict(int)
    first = last = None
    for c in calls.values():
        first = min(first or c["ts"], c["ts"])
        last = max(last or c["ts"], c["ts"])
        d = tok[(c["ts"][:7], c["model"])]
        for f in ("in", "out", "cr", "w5", "w1"):
            d[f] += c.get(f, 0)
        d["msgs"] += 1
        if rate_for(c["model"]) is None:
            unknown[c["model"]] += 1

    rows = []
    for (month, model), d in sorted(tok.items()):
        r = rate_for(model)
        cost = None
        if r:
            cost = (d["in"] * r[0] + d["out"] * r[1] + d["w5"] * r[2] + d["w1"] * r[3] + d["cr"] * r[4]) / 1e6
        rows.append({"month": month, "model": model, "msgs": int(d["msgs"]), "in": int(d["in"]), "out": int(d["out"]),
                     "cache_w5m": int(d["w5"]), "cache_w1h": int(d["w1"]), "cache_read": int(d["cr"]), "usd": cost})
    if "--json" in sys.argv:
        print(json.dumps({"first": first, "last": last, "rows": rows, "unpriced": unknown}, indent=1))
        return
    print(f"transcripts span {first} .. {last}")
    print(f"{'month':8} {'model':22} {'msgs':>6} {'in':>9} {'out':>10} {'w5m':>11} {'w1h':>11} {'cread':>13} {'usd':>9}")
    tot = defaultdict(float)
    for r in rows:
        usd = f"{r['usd']:9.2f}" if r["usd"] is not None else "      n/a"
        print(f"{r['month']:8} {r['model']:22} {r['msgs']:6} {r['in']:9} {r['out']:10} {r['cache_w5m']:11} {r['cache_w1h']:11} {r['cache_read']:13} {usd}")
        if r["usd"] is not None:
            tot[r["month"]] += r["usd"]
    print()
    for mo, v in sorted(tot.items()):
        print(f"{mo}  ${v:,.2f}")
    if unknown:
        print("unpriced models:", dict(unknown))


if __name__ == "__main__":
    main()
