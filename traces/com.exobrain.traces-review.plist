<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.exobrain.traces-review</string>
	<!-- The trace-labeling page on http://127.0.0.1:5019 (bin/traces review).
	     Loaded only while a labeling round is open; bootout when it is done. -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alexhedtke/.local/bin/mist-launch</string>
		<string>/Users/alexhedtke/Documents/Exobrain harness/traces/.venv/bin/python</string>
		<string>/Users/alexhedtke/Documents/Exobrain harness/traces/traces.py</string>
		<string>review</string>
		<string>--sample</string>
		<string>sample-1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/traces-review.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/traces-review.log</string>
	<!-- Login Items shows the job under this app instead of its executable's name;
	     only honored because mist-launch is signed by the same team. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
	    <string>com.exobrain.mist-console</string>
	</array>
</dict>
</plist>
