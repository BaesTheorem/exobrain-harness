#!/usr/bin/env python3
"""standings-post: post the standings bump chart to the league's Discord
channel once per decided week.

Runs `standings_history.py` (the table after every decided week, ranked the
way ESPN ranks it), renders its HTML chart to a PNG with headless Playwright,
and posts the PNG with a short caption through `discord/discord-send.py
--attach`. A week counts once every one of its games has a winner on ESPN, so
the run after Monday night's final posts it, and later runs do nothing.

The channel id lives in the gitignored `fantasy/standings-post.json`
(`{"channel_id": "..."}`); see fantasy/README.md.

    standings-post            post the newest decided week if not yet posted
    standings-post --dry-run  render and print the caption, post nothing
    standings-post --force    post the newest decided week again

INVARIANTS
- Read-only on ESPN: it only runs standings_history.py, which only calls `ff raw`.
- One post per week: a week goes into the state file only after Discord
  confirms the message.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path

FANTASY = Path(__file__).resolve().parent.parent
HARNESS = FANTASY.parent
OUT = FANTASY / ".cache" / "standings-post"
STATE = OUT / "state.json"
CONFIG = FANTASY / "standings-post.json"
SEND = HARNESS / "discord" / "discord-send.py"
NOTIFY = HARNESS / "mist-voice" / "bin" / "mist-notify"


def history(html: Path) -> dict:
    out = subprocess.run([sys.executable, str(FANTASY / "standings_history.py"), "--json", "--html", str(html)],
                         capture_output=True, text=True, check=True, cwd=FANTASY)
    return json.loads(out.stdout)


def render(html: Path, png: Path) -> None:
    from playwright.sync_api import sync_playwright  # noqa: PLC0415 - heavy, only needed here

    with sync_playwright() as p:
        b = p.chromium.launch()
        pg = b.new_page(viewport={"width": 1040, "height": 900}, device_scale_factor=2, color_scheme="light")
        pg.goto(html.as_uri(), wait_until="load")
        pg.add_style_tag(content="details{display:none}")  # the table view is for the page, not the image
        pg.locator(".viz-root").screenshot(path=str(png))
        b.close()


def caption(hist: dict) -> str:
    weeks = hist["weeks"]
    now = weeks[-1]
    lines = [f"(ˆωˆ) Standings after week {now['week']}."]
    top = now["table"][:2]
    lines.append("Bye seats: " + ", ".join(f"{r['team']} ({r['record']})" for r in top) + ".")
    if len(weeks) > 1:
        before = {r["team"]: r["rank"] for r in weeks[-2]["table"]}
        moves = [(before[r["team"]] - r["rank"], r["team"]) for r in now["table"] if r["team"] in before]
        up, down = max(moves), min(moves)
        if up[0] > 0:
            lines.append(f"Biggest climb: {up[1]}, up {up[0]}.")
        if down[0] < 0:
            lines.append(f"Biggest drop: {down[1]}, down {-down[0]}.")
    return "\n".join(lines)


def notify(msg: str) -> None:
    subprocess.run([str(NOTIFY), msg, "Standings post failed", "Basso", "--discord",
                    "--context", "fantasy/bin/standings-post, log ~/Library/Logs/exobrain/standings-post.log"],
                   check=False)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--dry-run", action="store_true", help="render and print the caption, post nothing")
    ap.add_argument("--force", action="store_true", help="post the newest decided week even if already posted")
    args = ap.parse_args()

    OUT.mkdir(parents=True, exist_ok=True)
    state = json.loads(STATE.read_text()) if STATE.exists() else {"posted": []}
    html = OUT / "standings.html"
    hist = history(html)
    if not hist["weeks"]:
        print("no decided week yet")
        return 0
    week = hist["weeks"][-1]["week"]
    if week in state["posted"] and not args.force and not args.dry_run:
        print(f"week {week} already posted")
        return 0

    png = OUT / f"standings-week-{week:02d}.png"
    render(html, png)
    text = caption(hist)
    print(text)
    print(f"rendered {png}")
    if args.dry_run:
        return 0

    try:
        channel = json.loads(CONFIG.read_text())["channel_id"]
    except (OSError, KeyError, json.JSONDecodeError) as e:
        notify(f"No channel id in {CONFIG.name}: {e}")
        return 1
    sent = subprocess.run([sys.executable, str(SEND), str(channel), text, "--attach", str(png)],
                          capture_output=True, text=True)
    if sent.returncode or "attachment" not in sent.stdout:
        notify(f"Week {week} chart did not post: {(sent.stderr or sent.stdout).strip()[-300:]}")
        print(sent.stderr, file=sys.stderr)
        return 1
    print(sent.stdout.strip())
    state["posted"] = sorted(set(state["posted"]) | {week})
    STATE.write_text(json.dumps(state))
    return 0


if __name__ == "__main__":
    sys.exit(main())
