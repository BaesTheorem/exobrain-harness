#!/usr/bin/env python3
"""chat-watch: answer new ESPN Fantasy Chat messages with a headless Claude.

Runs every 10 minutes from launchd (com.exobrain.chat-watch). Each run asks
`espn chat --unanswered` which threads end with somebody else's message, drops
the ones already handled, and if any remain invokes `claude -p` on
fantasy/routines/chat.md, which decides whether to reply and sends through
`espn-tx chat`. A quiet league produces one log line and no Claude call.

A DIRECT message never gets an unattended reply (Alex, 2026-09-20). It is
handed to him instead, three ways: a Discord DM from the bot, a local banner,
and a new MIST Console chat seeded with the thread, so the conversation about
what to say is already open when he looks. Only the league-wide threads reach
the model.

    chat-watch [--max-per-day 6] [--dry-run] [--force]

INVARIANTS
  - State is keyed by MESSAGE ID, never by timestamp. Clocks, caches and
    launchd's wake-replay all move; a message id does not. Anything already in
    the handled set is never answered twice, which is the failure that actually
    costs something here because it lands in a friend's inbox.
  - The daily cap is enforced HERE, before Claude is invoked, not inside the
    prompt. A prompt is a request; a counter is a limit. If the cap is spent,
    the messages are still marked handled, so a quiet day does not release a
    backlog of stale replies the next morning.
  - Claude is invoked with a WALL-CLOCK TIMEOUT and its own working directory.
    A hung model must not wedge a launchd job that fires every 10 minutes.
  - The claude binary is resolved with shutil.which, never pinned. Pinned paths
    under ~/.local/share/claude/versions break on every update.
  - An escalated message is marked handled only when at least ONE delivery path
    landed. Each of the three fails for its own reason (bot token, Console not
    running, notifier permissions) and all three failing while the id is burned
    anyway is exactly how a DM disappears without anybody noticing.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

FANTASY = Path(__file__).resolve().parent.parent
HARNESS = FANTASY.parent
STATE = FANTASY / ".cache" / "chat-watch.json"
PROMPT = FANTASY / "routines" / "chat.md"
NOTIFY = HARNESS / "mist-voice" / "bin" / "mist-notify"
DISCORD_SEND = HARNESS / "discord" / "discord-send.py"
HARNESS_ENV = HARNESS / ".env"
CONSOLE = "http://127.0.0.1:5014"

# ESPN's type for a one-to-one thread. The league-wide ones are CHAT and
# CHAT_ALL_MEMBERS, and those are the only threads the model may answer.
DM_TYPE = "CHAT_DIRECT_MESSAGE"

CONSOLE_SEED = """\
An ESPN fantasy league message is waiting on a reply, and sending it is Alex's
call, not yours. Escalated because: {reason}.

Thread `{topic}` with {partners}. New from {who}:

{quoted}

Invoke the fantasy-football skill and read the playbook before you answer
anything. Pull the whole thread with `fantasy/bin/espn chat --json`, then
whatever the question actually needs: `espn player`, `bin/volume`,
`trade_scan.py`, `bin/league-scan`. Tell Alex what is being asked, which
playbook rule covers it, and draft the reply you would send.

Do not send anything until he says to. When he does, it goes out through
`fantasy/bin/espn-tx chat`.
"""

# Tried in order. Fable first because the playbook puts fantasy routines there;
# Opus 5 behind it because a spent Fable budget should not take the watcher down
# for a day (Alex, 2026-09-14). The fallback fires ONLY on an exhausted budget,
# never on an auth failure, since no model fixes a missing token.
MODELS = ("claude-fable-5-1", "claude-opus-5")
CLAUDE_TIMEOUT = 600


class ClaudeUnavailable(RuntimeError):
    """Claude never got to think: no auth, no credits. Distinct from "no reply needed"."""


def log(msg: str) -> None:
    print(f"[{datetime.datetime.now():%Y-%m-%d %H:%M:%S}] {msg}", flush=True)


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {"handled": [], "sent_by_day": {}}


def save_state(state: dict) -> None:
    STATE.parent.mkdir(exist_ok=True)
    # Unbounded growth is the only way this file misbehaves, and a season is
    # a few hundred messages, so keep a generous tail rather than all of it.
    state["handled"] = state["handled"][-500:]
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=1))
    os.replace(tmp, STATE)


def unanswered_messages() -> list[dict]:
    """The newest message of every thread somebody else spoke in last."""
    out = subprocess.run(
        [str(FANTASY / "bin" / "espn"), "chat", "--unanswered", "--fresh", "--json"],
        capture_output=True, text=True, timeout=180, check=False, cwd=HARNESS,
    )
    if out.returncode != 0:
        log(f"espn chat failed rc={out.returncode}: {out.stderr.strip()[:200]}")
        return []
    try:
        threads = json.loads(out.stdout or "[]")
    except json.JSONDecodeError:
        log("espn chat returned unparseable JSON")
        return []
    latest = []
    for t in threads:
        if t.get("messages"):
            m = dict(t["messages"][-1])
            m["topic"] = t["id"]
            m["type"] = t.get("type") or ""
            m["with"] = t.get("with") or []
            latest.append(m)
    return latest


def notify(text: str) -> None:
    if NOTIFY.exists():
        subprocess.run([str(NOTIFY), text, "Fantasy Chat", "none", "console",
                        "--group", "fantasy", "--id", "chat-watch"],
                       capture_output=True, check=False)


def _json_objects(text: str) -> list[dict]:
    """Parse `espn-tx pending`, which prints one indented object per row."""
    dec, out, i = json.JSONDecoder(), [], 0
    while i < len(text):
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            break
        obj, i = dec.raw_decode(text, i)
        out.append(obj)
    return out


def trade_partners() -> tuple[set[str], bool]:
    """Team names we have a trade in flight with, and whether the lookup worked.

    A chat message from one of these is almost certainly about the offer, and
    the playbook's standing limit puts sending, accepting, rejecting and
    countering a trade on Alex's tap. So the watcher must not hand one to a
    model unattended: a reply that reads as a counter is the failure this
    exists to prevent, and it lands in a friend's inbox where it cannot be
    taken back.

    The second return value is the positive control. An empty set is the
    dangerous shape here, because it is indistinguishable from "the lookup
    broke" and it fails toward auto-replying. Callers escalate everything when
    it is False.
    """
    try:
        teams = json.loads(subprocess.run(
            [str(FANTASY / "bin" / "espn"), "teams", "--json"],
            capture_output=True, text=True, timeout=120, check=True, cwd=HARNESS,
        ).stdout)
        by_id = {int(t["id"]): (t.get("team") or "").strip() for t in teams}
        mine = next(int(t["id"]) for t in teams if t.get("mine"))

        rows = _json_objects(subprocess.run(
            [str(FANTASY / "bin" / "espn-tx"), "pending"],
            capture_output=True, text=True, timeout=120, check=True, cwd=HARNESS,
        ).stdout)
    except (subprocess.SubprocessError, ValueError, KeyError, StopIteration) as e:
        log(f"trade-partner lookup FAILED ({type(e).__name__}: {e}); "
            f"escalating every message rather than risk an unattended trade reply")
        return set(), False

    partners = set()
    for row in rows:
        if "TRADE" not in (row.get("type") or "") or row.get("status") != "PENDING":
            continue
        for item in row.get("items") or []:
            for side in (item.get("fromTeamId"), item.get("toTeamId")):
                if side is not None and int(side) != mine and by_id.get(int(side)):
                    partners.add(by_id[int(side)])
    log(f"trade partners in flight: {sorted(partners) or 'none'}")
    return partners, True


def harness_env(key: str) -> str | None:
    """One value out of the harness .env. Read here rather than inherited from
    the environment, because launchd hands this process almost nothing."""
    try:
        for line in HARNESS_ENV.read_text().splitlines():
            line = line.strip()
            if line.startswith(f"{key}="):
                return line.split("=", 1)[1].strip().strip("\'\"")
    except OSError:
        pass
    return None


def discord_dm(text: str) -> bool:
    """DM Alex through the bot. The channel is his own DM with her, so a
    leaguemate's message never lands anywhere the friend group can read it."""
    channel = harness_env("DISCORD_NOTIFY_CHAT_ID")
    if not channel or not DISCORD_SEND.exists():
        log("discord skip: no DISCORD_NOTIFY_CHAT_ID or no discord-send.py")
        return False
    r = subprocess.run([sys.executable, str(DISCORD_SEND), channel, text],
                       capture_output=True, text=True, timeout=60,
                       check=False, cwd=HARNESS)
    if r.returncode != 0:
        log(f"discord send failed rc={r.returncode}: "
            f"{((r.stderr or '') + (r.stdout or '')).strip()[:200]}")
        return False
    return True


def console_chat(title: str, seed: str) -> str | None:
    """Open a MIST Console chat seeded with the thread; return its session id.

    Deliberately NOT /quick-new. That endpoint also marks the chat as the one
    the main window should jump to, and yanking Alex out of what he is typing
    costs more than a chat he finds when he looks. The banner and the Discord
    DM are the pointer; this just has the conversation ready.
    """
    def post(path: str, payload: dict | None = None, timeout: int = 20) -> dict:
        req = urllib.request.Request(
            f"{CONSOLE}{path}", data=json.dumps(payload or {}).encode(),
            headers={"Content-Type": "application/json"}, method="POST")
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or "{}")

    try:
        sid = post("/sessions")["id"]
        # Title first: the Console derives one from the first message only when
        # the chat is still untitled, so setting it after the send loses.
        post(f"/sessions/{sid}/title", {"title": title})
        # Injection replies run on Fable (Alex, 2026-09-21), and a DM from this
        # league is the likeliest place one arrives. New Console chats default
        # to Opus, so pin the model before the seed spawns the process.
        post(f"/sessions/{sid}/model", {"model": MODELS[0]})
        # Generous timeout: this send spawns the chat's claude process and its
        # MCP servers before it returns.
        post(f"/send/{sid}", {"text": seed}, timeout=90)
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        log(f"console chat unavailable ({type(e).__name__}: {e}); escalating without it")
        return None
    log(f"opened Console chat {sid}: {title}")
    return sid


def classify(pending: list[dict], partners: set[str],
             guard_ok: bool) -> tuple[list[dict], list[dict], list[dict]]:
    """Split the waiting messages into (trade, direct message, league-wide).

    Only the third list may reach the model. The trade check runs first so a
    DM from a live trade partner escalates once, under the sharper reason, and
    a failed partner lookup (guard_ok False) sweeps everything into it, because
    an empty partner set is indistinguishable from a broken one and the
    dangerous direction is auto-replying.
    """
    hot = [m for m in pending
           if not guard_ok or (m.get("who") or "").strip() in partners]
    dms = [m for m in pending if m not in hot and m.get("type") == DM_TYPE]
    league = [m for m in pending if m not in hot and m not in dms]
    return hot, dms, league


def escalate(messages: list[dict], reason: str) -> bool:
    """Hand the thread to Alex instead of answering it.

    Grouped by thread, so three messages from one leaguemate produce one chat
    and one Discord ping rather than three of each. Returns whether at least
    one delivery path landed; the caller must not burn the message ids when
    nothing did.
    """
    delivered = False
    by_topic: dict[str, list[dict]] = {}
    for m in messages:
        by_topic.setdefault(m["topic"], []).append(m)

    for topic, group in by_topic.items():
        who = ", ".join(dict.fromkeys(
            (m.get("who") or "someone").strip() for m in group))
        partners = ", ".join(group[0].get("with") or []) or "league"
        quoted = "\n".join(f"> {(m.get('content') or '').strip()}" for m in group)
        one_line = " / ".join(
            (m.get("content") or "").strip().replace("\n", " ") for m in group)

        sid = console_chat(
            f"Fantasy DM: {partners}",
            CONSOLE_SEED.format(reason=reason, topic=topic, partners=partners,
                                who=who, quoted=quoted))
        delivered = delivered or sid is not None

        tail = (f"Console chat is open: *Fantasy DM: {partners}*. Tell me there "
                f"and I will draft the reply." if sid else
                "The Console is not running, so there is no chat yet. "
                "`fantasy/bin/espn chat --json` has the thread.")
        delivered = discord_dm(
            f"(o.o) **Fantasy DM** from **{who}** ({reason})\n{quoted}\n{tail}"
        ) or delivered

        if NOTIFY.exists():
            r = subprocess.run(
                [str(NOTIFY), f"{who}: {one_line[:180]}", f"Fantasy DM: {reason}",
                 "none", f"console:{sid}" if sid else "console",
                 "--group", "fantasy", "--id", f"chat-esc-{group[-1].get('id', 'x')}"],
                capture_output=True, check=False)
            delivered = delivered or r.returncode == 0

        log(f"ESCALATED to Alex ({reason}, no auto-reply), delivered={delivered}: "
            f"{who}: {one_line[:120]}")
    return delivered


def run_claude(pending: list[dict], dry_run: bool) -> bool:
    claude = shutil.which("claude")
    if not claude:
        log("claude not on PATH; cannot answer")
        return False
    summary = "\n".join(
        f"- thread {m['topic']} with {', '.join(m['with']) or 'league'}: "
        f"{m['who']} at {m['at']} (message id {m.get('id')}): {m['content'][:200]}"
        for m in pending
    )
    prompt = (
        f"{PROMPT.read_text()}\n\n---\n\n"
        f"New messages waiting on a reply as of {datetime.datetime.now():%Y-%m-%d %H:%M}:\n"
        f"{summary}\n\nDecide and act now."
    )
    if dry_run:
        log(f"DRY RUN, would invoke claude with {len(pending)} message(s) "
            f"on {MODELS[0]} (falling back to {', '.join(MODELS[1:])}):\n{summary}")
        return False

    for model in MODELS:
        try:
            r = subprocess.run(
                [claude, "-p", prompt, "--model", model,
                 "--permission-mode", "bypassPermissions"],
                capture_output=True, text=True, timeout=CLAUDE_TIMEOUT,
                check=False, cwd=HARNESS,
            )
        except subprocess.TimeoutExpired:
            log(f"{model} timed out after {CLAUDE_TIMEOUT}s; messages marked handled anyway")
            notify("Fantasy Chat reply timed out. Check the thread by hand.")
            return False

        out = (r.stdout or "") + (r.stderr or "")
        log(f"{model} rc={r.returncode}: {out.strip()[-600:]}")
        lowered = out.lower()

        # Auth is not a model problem, so trying another one just burns a
        # second call to reach the same wall. Fail immediately.
        if "not logged in" in lowered or "please run /login" in lowered:
            why = "Claude is not authenticated"
            log(f"INFRASTRUCTURE FAILURE: {why}; leaving messages unhandled")
            notify(f"Fantasy Chat could not reply: {why}.")
            raise ClaudeUnavailable(why)

        # A spent budget IS per-model, which is the whole reason for the chain.
        if "out of usage credits" in lowered or "usage limit" in lowered:
            log(f"{model} budget exhausted; falling back")
            continue

        # Reached a model that could think. rc 0 with no reply sent is a
        # legitimate outcome: most messages do not want an answer.
        return r.returncode == 0

    why = f"every model is out of credits ({', '.join(MODELS)})"
    log(f"INFRASTRUCTURE FAILURE: {why}; leaving messages unhandled")
    notify("Fantasy Chat could not reply: every model is out of credits.")
    raise ClaudeUnavailable(why)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--max-per-day", type=int, default=6)
    ap.add_argument("--max-age-hours", type=float, default=24.0,
                    help="ignore messages older than this (default 24)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true",
                    help="answer even messages already marked handled")
    ap.add_argument("--self-test", action="store_true",
                    help="exercise the model fallback chain and exit; sends nothing")
    args = ap.parse_args()

    if args.self_test:
        # Worth a flag rather than a one-off: the failure this catches (a spent
        # budget, an expired token) is invisible until a real message arrives,
        # and by then the reply is already late.
        claude = shutil.which("claude")
        if not claude:
            log("claude not on PATH")
            return 1
        for model in MODELS:
            r = subprocess.run(
                [claude, "-p", "Reply with exactly: OK", "--model", model,
                 "--permission-mode", "bypassPermissions"],
                capture_output=True, text=True, timeout=CLAUDE_TIMEOUT,
                check=False, cwd=HARNESS,
            )
            out = ((r.stdout or "") + (r.stderr or "")).strip()
            healthy = r.returncode == 0 and "out of usage credits" not in out.lower()
            log(f"{model}: {'OK' if healthy else 'UNAVAILABLE'} -- {out[:120]}")
            if healthy:
                log(f"chain healthy; replies would run on {model}")
                return 0
        log("NO MODEL AVAILABLE: the watcher would detect messages and not answer them")
        return 1

    state = load_state()
    handled = set(state["handled"])
    today = datetime.date.today().isoformat()
    sent_today = int(state["sent_by_day"].get(today, 0))

    fresh = unanswered_messages()
    unseen = [m for m in fresh
              if args.force or (m.get("id") and m["id"] not in handled)]

    # An old message is not a conversation, it is history. The first dry run
    # wanted to answer a week-old "Hi" in the league chat, which is exactly the
    # kind of reply that makes an assistant look broken rather than present.
    # Stale ones are marked handled so they never come back.
    cutoff_ms = (datetime.datetime.now().timestamp() - args.max_age_hours * 3600) * 1000
    pending = [m for m in unseen if (m.get("date") or 0) >= cutoff_ms]
    stale = [m for m in unseen if m not in pending]
    if stale:
        log(f"ignoring {len(stale)} message(s) older than {args.max_age_hours}h")
        if not args.dry_run:
            state["handled"].extend(m["id"] for m in stale if m.get("id"))
            save_state(state)

    if not pending:
        log("nothing waiting")
        return 0

    log(f"{len(pending)} message(s) waiting; {sent_today}/{args.max_per_day} used today")

    # A live trade offer changes who is allowed to answer. Alex asked for this
    # on 2026-09-20 while an offer to KC Breathmints was in review; the general
    # rule is the playbook's, not hers: trades are his tap, so the watcher
    # hands him the message rather than replying for him.
    #
    # A direct message goes the same way, for the same reason one step earlier:
    # a one-to-one thread is a conversation with Alex, and he asked (2026-09-20)
    # to be pulled into it rather than find out after she answered. Only the
    # league-wide threads are left for the model. The trade check runs first so
    # a DM from a live trade partner escalates once, with the sharper reason.
    partners, guard_ok = trade_partners()
    hot, dms, pending = classify(pending, partners, guard_ok)

    for group, reason in ((hot, "trade in flight"), (dms, "direct message")):
        if not group:
            continue
        if args.dry_run:
            log(f"DRY RUN, would escalate {len(group)} message(s) as '{reason}': "
                + "; ".join(f"{m.get('who')}: {(m.get('content') or '')[:80]}"
                            for m in group))
            continue
        if escalate(group, reason):
            state["handled"].extend(m["id"] for m in group if m.get("id"))
            save_state(state)
        else:
            log(f"every escalation path failed for {len(group)} '{reason}' "
                f"message(s); leaving them unhandled so the next run retries")

    if not pending:
        log("nothing left to answer after escalation")
        return 0

    if sent_today >= args.max_per_day:
        # Mark handled regardless. Releasing a day's backlog tomorrow morning
        # would be worse than missing it: the context is stale and the volume
        # is exactly what the cap exists to prevent.
        log("daily cap reached; marking handled without answering")
        notify(f"{len(pending)} chat message(s) went unanswered: daily cap reached.")
        state["handled"].extend(m["id"] for m in pending if m.get("id"))
        save_state(state)
        return 0

    try:
        ok = run_claude(pending, args.dry_run)
    except ClaudeUnavailable:
        # Deliberately no state write: these messages stay pending so the next
        # run answers them once the outage clears.
        return 1
    if args.dry_run:
        return 0

    state["handled"].extend(m["id"] for m in pending if m.get("id"))
    state["sent_by_day"][today] = sent_today + 1
    state["sent_by_day"] = {d: n for d, n in state["sent_by_day"].items() if d >= today}
    save_state(state)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
