#!/usr/bin/env python3
"""roster-watch: notice what happens to Chaos Legion between MIST's scheduled runs.

Every 30 minutes from launchd (com.exobrain.roster-watch). Diffs the roster's
injury statuses, our pending claims, pending transactions aimed at the team
(a trade offer), the players on fantasy/watchlist.json (status, a rostered-percentage
spike, which fantasy team holds them), and the rosters of watched teams against
the last run. It also runs fantasy/bin/swap-scan and, when a bench-for-wire
swap crosses the playbook's waiver gate for the first time, banners Alex with
Do it / Skip buttons (his standing instruction, 2026-09-20: actively monitor
for these; a drop is his tap, never the watcher's). One narrow lane files by
itself (Alex, 2026-10-22, "Do it" to the narrow version): a free-agent K or
D/ST that clears the gate or the stream rule, for our bench K or D/ST of the
same position, when the last rival-scan build shows another team with the
same need. A free agent goes to whoever files first; a K or D/ST swap is
near replacement level and reversible (no dropped K or D/ST was claimed off
waivers here through week 7). Skill players always wait for his tap. Anything new is appended to
fantasy/.cache/incidents.jsonl, announced with a clickable banner, and, when
it needs judgment (a starter going out, an IR designation, a trade offer, a
processed claim), handed to the fantasy-incident routine, which runs headless
Claude on Opus 5.5 through the Console's routine runner. Silence means nothing
changed.

    roster-watch [--dry-run] [--no-routine]
"""

from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
FANTASY = HERE.parent
sys.path.insert(0, str(FANTASY))
STATE = FANTASY / ".cache" / "roster-watch.json"
INCIDENTS = FANTASY / ".cache" / "incidents.jsonl"
WATCHLIST = FANTASY / "watchlist.json"
NOTIFY = FANTASY.parent / "mist-voice" / "bin" / "mist-notify"
RUNNER = pathlib.Path("/Users/alexhedtke/Documents/mist-console/run-routine.sh")
ROUTINE_LOG = pathlib.Path.home() / "Library" / "Logs" / "mist-routines.log"
from espncli.client import web_urls  # noqa: E402  (needs the sys.path line above)

_URLS = web_urls()  # ids come from the gitignored espn-credentials.json
ROSTER_URL = _URLS["team"]
LEAGUE_URL = _URLS["league"]
NEEDS_JUDGMENT = {"OUT", "DOUBTFUL", "INJURY_RESERVE", "SUSPENSION"}
SWAP_SCAN = HERE / "swap-scan"
REPLY_URL = "http://127.0.0.1:5014/notify-reply"
RIVALS_MAX_AGE = 6 * 3600
ESPN_TX = HERE / "espn-tx"
AUTO_POS = {"K", "D/ST"}             # the only positions roster-watch files by itself
POS_NAME = {1: "QB", 2: "RB", 3: "WR", 4: "TE", 5: "K", 16: "D/ST"}


def rivals_needing(pos: str) -> list[str]:
    """Other teams with an uncovered need at `pos` this week or next, from the
    last rival-scan build (espncli.rivals, fantasy/.cache/rivals-*.json, at
    most six hours old; no new ESPN reads). A free agent goes to whoever files
    first, so a rival with the same need is a race (2026-10-22: the Titans D/ST
    cleared our gate at 4:04 PM, sat on a banner, and went to a rival at
    11:48 AM the next day)."""
    try:
        f = max((FANTASY / ".cache").glob("rivals-*.json"), key=lambda x: x.stat().st_mtime)
        if time.time() - f.stat().st_mtime > RIVALS_MAX_AGE:
            return []
        board = json.loads(f.read_text()).get("board", [])
    except (ValueError, OSError):
        return []
    out = []
    for b in board:
        need = (b.get("needs") or []) + (b.get("needs_next") or [])
        if not b.get("mine") and (pos in need or (pos in ("RB", "WR", "TE") and "RB/WR/TE" in need)):
            ab = b.get("abbrev") or ""
            out.append(ab if len(ab) >= 3 else b.get("team") or ab)
    return out


def race_note(avail: str, pos: str, rivals: list[str]) -> str:
    if avail == "FA" and rivals:
        return f"; {', '.join(rivals)} need a {pos} too, and a free agent goes to whoever files first"
    if avail == "FA":
        return "; free agent, first come"
    return ""


def auto_file(ev: dict, bench: dict[str, str]) -> dict | None:
    """File the narrow lane's swap, or None when the event is outside it.

    The lane: a free agent at K or D/ST, the drop on our bench at the same
    position (never a starter, never a skill player), and at least one rival
    with an uncovered need there. espn-tx exits nonzero unless its read-back
    shows the change, so `verified` is ESPN's word, not ours."""
    pos = ev.get("add_pos") or ev.get("slot")
    drop = ev.get("drop")
    if ev.get("avail") != "FA" or pos not in AUTO_POS or not drop or bench.get(drop) != pos:
        return None
    rivals = ev.get("rivals") or rivals_needing(pos)
    if not rivals:
        return None
    try:
        r = subprocess.run([sys.executable, str(ESPN_TX), "claim", "--fa", ev["add"], "--drop", drop],
                           capture_output=True, text=True, timeout=180, check=False)
        return {"verified": r.returncode == 0, "rivals": rivals, "out": (r.stdout or r.stderr)[-400:]}
    except (OSError, subprocess.SubprocessError) as exc:
        return {"verified": False, "rivals": rivals, "out": str(exc)[:400]}


def log_race(path: pathlib.Path, ev: dict, stamp: str) -> None:
    """One row per free-agent banner, filed or not. rival-scan --settle reads
    these to count how often a rival takes an unfiled free agent first, which
    decides whether the auto lane widens past K and D/ST (asked 2026-10-22)."""
    pos = ev.get("add_pos") or ev.get("slot")
    # A count, not names: the file is tracked in a public repo.
    row = {"ts": stamp, "kind": ev["kind"], "add": ev["add"], "pos": pos, "drop": ev.get("drop"),
           "rivals": len(ev.get("rivals") or rivals_needing(pos or "")), "filed": bool((ev.get("filed") or {}).get("verified"))}
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as fh:
        fh.write(json.dumps(row) + "\n")


def reply_button(label: str, text: str) -> str:
    """A mist-notify --action that posts `text` into the Console as Alex's reply."""
    payload = json.dumps({"text": text})
    return (f"{label}=cmd:/usr/bin/curl -sS -X POST {REPLY_URL} "
            f"-H 'Content-Type: application/json' -d '{payload}'")


def swap_gate_event(st: dict) -> dict | None:
    """The best bench-for-wire swap, if it clears the gate and has not been offered yet.

    State remembers the last pair offered, so a swap that stays above the gate
    for days produces one banner, not one every 30 minutes; a different pair,
    or the same pair after it dropped below the gate and came back, is new.
    """
    try:
        out = subprocess.run([sys.executable, str(SWAP_SCAN), "--json"], capture_output=True,
                             text=True, timeout=240, check=True).stdout
        scan = json.loads(out)
    except Exception as exc:  # the watcher's other checks must still run
        print(f"swap-scan unavailable: {exc}")
        return None
    gate = float(scan.get("gate", 20.0))
    best: dict | None = None
    for row in scan.get("swaps", []):
        if row.get("pending_drop"):
            continue   # that drop is already spent arming a pending claim (2026-09-20, Noel)
        for c in row.get("candidates", []):
            if best is None or float(c["gain"]) > float(best["gain"]):
                best = {"drop": row["drop"], "drop_pos": row["pos"], "add": c["add"],
                        "add_pos": c["pos"], "avail": c["avail"], "gain": float(c["gain"]),
                        "owned": c["owned"], "trend": c["trend"], "flags": c.get("flags") or []}
    gs = st.setdefault("swap_gate", {})
    if best is None or best["gain"] < gate:
        gs["offered"] = None
        return None
    pair = f"{best['drop']}|{best['add']}"
    if gs.get("offered") == pair:
        return None
    gs["offered"] = pair
    return {"kind": "swap_gate", "gate": gate, "judgment": False, "rivals": rivals_needing(best["add_pos"]), **best}


def stream_gate_event(st: dict) -> dict | None:
    """A K or D/ST streamer that clears the playbook's thresholds (bin/stream-scan),
    once per candidate: the same one-banner-per-pair memory as the swap gate."""
    try:
        out = subprocess.run([sys.executable, str(HERE / "stream-scan"), "--json"], capture_output=True,
                             text=True, timeout=240, check=True).stdout
        scan = json.loads(out)
    except Exception as exc:
        print(f"stream-scan unavailable: {exc}")
        return None
    gs = st.setdefault("stream_gate", {})
    for label in ("dst", "k"):
        v = scan.get(label)
        if v and v.get("start_bench"):
            b = v["start_bench"]
            if b.get("pending"):     # better D/ST already claimed: no lineup move until it lands
                gs[label] = None
                continue
            pair = f"{v['ours']}|{b['name']}|BE|{scan.get('week')}"
            if gs.get(label) == pair:
                continue
            gs[label] = pair
            return {"kind": "stream_gate", "slot": "D/ST", "ours": v["ours"], "add": b["name"],
                    "avail": "BE", "why": v["why"], "judgment": False}
        if not v or not v.get("stream") or not v.get("best_fa"):
            gs[label] = None
            continue
        cand = v["best_fa"][0]
        pair = f"{v['ours']}|{cand['name']}|{scan.get('week')}"
        if gs.get(label) == pair:
            continue
        gs[label] = pair
        return {"kind": "stream_gate", "slot": "D/ST" if label == "dst" else "K", "ours": v["ours"],
                "drop": v.get("drop") or v["ours"], "add": cand["name"], "avail": cand["avail"],
                "why": v["why"], "judgment": False}
    return None


def load(path: pathlib.Path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def trade_outcome(api, tid: str) -> str:
    """accepted, rejected, expired or unknown for one of our offers, from the
    transaction log (rule inventory R109 in code, 2026-10-15). A CANCEL row
    written by ESPN's trade processor is the two-day expiry; one written by a
    manager, or a TRADE_DECLINE row, is a rejection; an accept or uphold row,
    or the offer itself EXECUTED, is a trade. The roster diff still confirms
    an accepted one before anything is moved."""
    try:
        cur = api.current_week(api.league("mStatus"))
        rows = [t for w in range(max(1, cur - 2), cur + 1)
                for t in api.league("mTransactions2", period=w).get("transactions", [])]
    except Exception:  # noqa: BLE001 - the routine falls back to reading the log by hand
        return "unknown"
    out = "unknown"
    for t in rows:
        if t.get("id") != tid and t.get("relatedTransactionId") != tid:
            continue
        typ, st, member = t.get("type"), t.get("status"), str(t.get("memberId") or "")
        if typ in ("TRADE_ACCEPT", "TRADE_UPHOLD") or (t.get("id") == tid and st == "EXECUTED"):
            return "accepted"
        if typ == "TRADE_DECLINE":
            out = "rejected"
        elif t.get("executionType") == "CANCEL" and out == "unknown":
            out = "expired" if (not member or "Processor" in member) else "rejected"
    return out


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-routine", action="store_true", help="record and notify, but do not start the incident routine")
    args = ap.parse_args()

    from espncli.client import Espn  # noqa: PLC0415
    api = Espn()
    team_id = int(api.creds["team_id"])
    data = api.league("mTeam", "mRoster", "mPendingTransactions")
    stamp = time.strftime("%Y-%m-%d %H:%M")
    st = load(STATE, {"status": {}, "pending": {}, "first_run": True})
    events: list[dict] = []

    # 1. Injury status per rostered player (starters flagged).
    statuses, starters = {}, set()
    bench: dict[str, str] = {}           # bench player name -> position, for the auto-file lane
    bench_ids: dict[str, int] = {}
    for e in api.roster_entries(data, team_id):
        p = e["playerPoolEntry"]["player"]
        if e.get("lineupSlotId") == 20:
            bench[p["fullName"]] = POS_NAME.get(p.get("defaultPositionId") or 0, "")
            bench_ids[p["fullName"]] = p["id"]
        statuses[str(p["id"])] = {"name": p["fullName"], "status": p.get("injuryStatus") or "",
                                  "slot": e.get("lineupSlotId")}
        if e.get("lineupSlotId") not in (20, 21):
            starters.add(str(p["id"]))
    for pid, cur in statuses.items():
        prev = st["status"].get(pid)
        if prev is None:
            continue  # new to the roster; the claim result covers it
        if prev.get("status") != cur["status"]:
            events.append({"kind": "status", "player": cur["name"], "from": prev.get("status") or "healthy",
                           "to": cur["status"] or "healthy", "starter": pid in starters,
                           "judgment": cur["status"] in NEEDS_JUDGMENT and pid in starters
                                       or cur["status"] == "INJURY_RESERVE"})
    for pid in list(st["status"]):
        if pid not in statuses:
            events.append({"kind": "left_roster", "player": st["status"][pid]["name"], "judgment": False})
    for pid, cur in statuses.items():
        if pid not in st["status"] and not st.get("first_run"):
            events.append({"kind": "joined_roster", "player": cur["name"], "judgment": False})

    # 2. Pending transactions: our claims (status changes) and anything aimed at us.
    pend = data.get("pendingTransactions") or []
    seen = st["pending"]
    now_ids = set()
    for t in pend:
        tid = t.get("id"); now_ids.add(tid)
        mine = t.get("teamId") == team_id
        aimed = any(i.get("toTeamId") == team_id or i.get("fromTeamId") == team_id for i in t.get("items", []))
        if tid not in seen:
            if not mine and aimed:
                events.append({"kind": "trade_offer" if "TRADE" in str(t.get("type", "")) else "incoming_transaction",
                               "from_team": t.get("teamId"), "type": t.get("type"), "status": t.get("status"),
                               "items": t.get("items"), "id": tid, "judgment": True})
            seen[tid] = {"type": t.get("type"), "status": t.get("status"), "mine": mine}
        elif seen[tid].get("status") != t.get("status"):
            events.append({"kind": "waiver_result" if mine else "transaction_update", "id": tid,
                           "type": t.get("type"), "from": seen[tid].get("status"), "to": t.get("status"),
                           "items": t.get("items"), "judgment": mine})
            seen[tid]["status"] = t.get("status")
    from espncli.tx import self_closed  # noqa: PLC0415
    ours_closed = self_closed()
    for tid in list(seen):
        if tid not in now_ids and tid in ours_closed:
            seen.pop(tid)  # we withdrew it (espn-tx withdraw); nothing to judge
            continue
        if tid not in now_ids and seen[tid].get("mine") and seen[tid].get("status") == "PENDING":
            # A claim that vanished from pending was processed (executed or failed);
            # the roster diff above says which. An outgoing trade offer that vanished
            # was accepted, rejected, or expired (ESPN's TradeTaskProcessor writes a
            # CANCELED row with relatedTransactionId at the 2-day mark and the
            # original stays PENDING forever). Hand either to the routine to log.
            trade = "TRADE" in str(seen[tid].get("type", ""))
            outcome = trade_outcome(api, tid) if trade else None
            events.append({"kind": "trade_resolved" if trade else "waiver_result", "id": tid,
                           "type": seen[tid].get("type"), "outcome": outcome,
                           "from": "PENDING", "to": (outcome or "resolved (see roster)") if trade else "processed (see roster)",
                           "judgment": True})
            seen.pop(tid)

    # 3. The watch list: players we are tracking anywhere in the league, and teams
    #    whose roster moves matter (an absent manager showing up).
    wl = load(WATCHLIST, {"players": [], "teams": []})
    wstate = st.setdefault("watch", {})
    ids = [p["id"] for p in wl.get("players", [])]
    cards = {c["player"]["id"]: c for c in api.player_cards(ids)} if ids else {}
    for wp in wl.get("players", []):
        c = cards.get(wp["id"])
        if not c:
            continue
        pl = c["player"]
        cur = {"status": pl.get("injuryStatus") or "", "team": c.get("onTeamId") or 0,
               "owned": round((pl.get("ownership") or {}).get("percentOwned") or 0.0, 1)}
        prev = wstate.get(str(wp["id"]))
        if prev and not st.get("first_run"):
            if prev["status"] != cur["status"]:
                events.append({"kind": "watch_status", "player": wp["name"], "from": prev["status"] or "healthy",
                               "to": cur["status"] or "healthy", "why": wp["why"], "judgment": False})
            if prev["team"] != cur["team"]:
                events.append({"kind": "watch_owner", "player": wp["name"], "from_team": prev["team"], "to_team": cur["team"],
                               "why": wp["why"], "trigger": wp["trigger"], "judgment": True})
            # A rostered-percentage spike is the market pricing in a role change (a
            # backfield split resolving, a starter going down) before any box score
            # we read does. Per-player override via "own_jump" on the watchlist entry.
            jump = float(wp.get("own_jump", 10.0))
            # Once the player is ours, a climb is the market agreeing with a move we
            # already made. Only a drop (the role breaking) still needs a read.
            moved = cur["owned"] - prev.get("owned", cur["owned"])
            if (-moved if cur["team"] == team_id else abs(moved)) >= jump:
                events.append({"kind": "watch_ownership", "player": wp["name"], "from": prev.get("owned"),
                               "to": cur["owned"], "why": wp["why"], "trigger": wp["trigger"], "judgment": True})
        wstate[str(wp["id"])] = cur
    rosters = {str(t["id"]): sorted(e["playerId"] for e in (t.get("roster") or {}).get("entries", [])) for t in data["teams"]}
    prev_r = st.setdefault("rosters", {})
    # Names too: a dropped player is gone from every roster by the time we see the
    # diff, so his name has to come from the last run.
    names = st.get("roster_names", {})
    for t in data["teams"]:
        for e in (t.get("roster") or {}).get("entries", []):
            names[str(e["playerId"])] = e["playerPoolEntry"]["player"]["fullName"]
    for wt in wl.get("teams", []):
        key = str(wt["id"])
        if key in prev_r and prev_r[key] != rosters.get(key):
            before, after = set(prev_r[key]), set(rosters.get(key, []))
            events.append({"kind": "watched_team_moved", "team": wt["name"],
                           "added": [names.get(str(i), str(i)) for i in sorted(after - before)],
                           "dropped": [names.get(str(i), str(i)) for i in sorted(before - after)],
                           "why": wt["why"], "judgment": True})
    st["rosters"] = rosters
    st["roster_names"] = {str(i): names[str(i)] for ids in rosters.values() for i in ids if str(i) in names}

    # 4. The waiver gate: a bench-for-wire swap worth 2.5+ points a game over the
    #    rest of the season, playoff weeks at their weight (swap-scan). Banner
    #    only; the drop is Alex's decision.
    if not st.get("first_run"):
        sg = swap_gate_event(st)
        if sg:
            events.append(sg)
        sg = stream_gate_event(st)
        if sg:
            events.append(sg)

    st["status"] = statuses
    st["first_run"] = False
    if not events:
        print(f"{stamp} no change ({len(statuses)} rostered, {len(pend)} pending)")
        if not args.dry_run:
            STATE.parent.mkdir(parents=True, exist_ok=True); STATE.write_text(json.dumps(st, indent=1))
        return 0

    for ev in events:
        ev.update({"ts": stamp, "handled": False})
        print(f"{stamp} EVENT {json.dumps(ev)[:300]}")
    if args.dry_run:
        return 0
    races = FANTASY / "forecasts" / f"fa-races-{api.season}.jsonl"
    # A bench player already named in a pending claim or offer is spent: dropping
    # him voids that row (2026-10-22: the 49ers are the drop of the Jaguars claim).
    spent = {i.get("playerId") for t in (data.get("pendingTransactions") or []) for i in (t.get("items") or [])}
    bench = {n: pos for n, pos in bench.items() if bench_ids.get(n) not in spent}
    for ev in events:
        if ev["kind"] in ("swap_gate", "stream_gate") and ev.get("avail") == "FA":
            filed = auto_file(ev, bench)
            if filed:
                ev["filed"] = filed
                print(f"{stamp} AUTO-FILE {ev['add']} for {ev.get('drop')}: verified={filed['verified']}")
            log_race(races, ev, stamp)
    with INCIDENTS.open("a") as fh:
        for ev in events:
            fh.write(json.dumps(ev) + "\n")
    STATE.write_text(json.dumps(st, indent=1))

    heads = []
    for ev in events:
        if ev["kind"] == "status":
            heads.append(f"{ev['player']}: {ev['from']} -> {ev['to']}" + (" (starter)" if ev.get("starter") else ""))
        elif ev["kind"] == "trade_offer":
            heads.append("trade offer received")
        elif ev["kind"] == "waiver_result":
            heads.append("waiver claim processed")
        elif ev["kind"] == "watch_status":
            heads.append(f"watch: {ev['player']} {ev['from']} -> {ev['to']}")
        elif ev["kind"] == "watch_owner":
            heads.append(f"watch: {ev['player']} changed hands")
        elif ev["kind"] == "watch_ownership":
            heads.append(f"watch: {ev['player']} {ev['from']}% -> {ev['to']}% rostered")
        elif ev["kind"] == "watched_team_moved":
            moves = [f"added {', '.join(ev['added'])}" if ev.get("added") else "",
                     f"dropped {', '.join(ev['dropped'])}" if ev.get("dropped") else ""]
            heads.append(f"{ev['team']} {' and '.join(m for m in moves if m) or 'made a roster move'}")
        elif ev["kind"] == "stream_gate":
            if ev["avail"] == "BE":
                heads.append(f"lineup {ev['slot']}: {ev['why']}")
            else:
                if (ev.get("filed") or {}).get("verified"):
                    heads.append(f"filed: streamed {ev['add']} for {ev['drop']} at {ev['slot']} ({ev['why']}), "
                                 f"a free-agent race with {', '.join(ev['filed']['rivals'])}; ESPN read-back verified")
                else:
                    heads.append(f"stream {ev['slot']}: {ev['add']} ({ev['avail']}) for {ev.get('drop') or ev['ours']}, {ev['why']}"
                                 + race_note(ev["avail"], ev["slot"], rivals_needing(ev["slot"]))
                                 + ("; the auto-file did not verify, tap Do it" if ev.get("filed") else ""))
        elif ev["kind"] == "swap_gate":
            fl = f", volume {'/'.join(ev['flags'])}" if ev.get("flags") else ""
            if (ev.get("filed") or {}).get("verified"):
                heads.append(f"filed: added {ev['add']} for {ev['drop']} (+{ev['gain']:.1f} pts rest of season), "
                             f"a free-agent race with {', '.join(ev['filed']['rivals'])}; ESPN read-back verified")
            else:
                heads.append(f"wire: add {ev['add']} ({ev['add_pos']}, {ev['avail']}) for "
                             f"{ev['drop']} clears the gate, +{ev['gain']:.1f} pts rest of season{fl}"
                             + race_note(ev["avail"], ev["add_pos"], ev.get("rivals") or [])
                             + ("; the auto-file did not verify, tap Do it" if ev.get("filed") else ""))
        else:
            heads.append(ev["kind"].replace("_", " ") + (f": {ev.get('player')}" if ev.get("player") else ""))
    judgment = any(ev.get("judgment") for ev in events)
    msg = "; ".join(heads)[:260] + (". MIST is on it." if judgment and not args.no_routine else "")
    link = LEAGUE_URL if any(ev["kind"] == "trade_offer" for ev in events) else ROSTER_URL
    actions = ["--action", "Ask MIST=console"]
    swap = next((ev for ev in events if ev["kind"] == "swap_gate"), None)
    stream = next((ev for ev in events if ev["kind"] == "stream_gate"), None)
    if stream and not swap and stream["avail"] == "BE":
        actions = [
            "--action", reply_button(
                "Do it", f"Lineup from roster-watch: start {stream['add']} over {stream['ours']} "
                         f"({stream['why']}; espn-tx move \"{stream['ours']}\" --to BE, then "
                         f"espn-tx move \"{stream['add']}\" --to {stream['slot']})"),
            "--action", reply_button("Skip", f"Keep {stream['ours']} in the {stream['slot']} slot"),
        ]
    elif stream and not swap:
        how = "--fa" if stream["avail"] == "FA" else ""
        actions = [
            "--action", reply_button(
                "Do it", f"Stream from roster-watch: add {stream['add']} for {stream['drop']} at {stream['slot']} "
                         f"({stream['why']}; espn-tx claim {how} \"{stream['add']}\" --drop \"{stream['drop']}\")"),
            "--action", reply_button("Skip", f"Skip the {stream['add']} stream; keep {stream['drop']}"),
        ]
    done = next((ev for ev in (swap, stream) if ev and (ev.get("filed") or {}).get("verified")), None)
    if done:
        actions = [
            "--action", reply_button(
                "Undo", f"Undo the roster-watch auto-swap: claim {done['drop']} back off waivers and drop "
                        f"{done['add']} (espn-tx claim \"{done['drop']}\" --drop \"{done['add']}\")"),
            "--action", "Ask MIST=console",
        ]
    elif swap:
        how = "--fa" if swap["avail"] == "FA" else ""
        actions = [
            "--action", reply_button(
                "Do it", f"File the swap from roster-watch: drop {swap['drop']}, add {swap['add']} "
                         f"(swap-scan +{swap['gain']:.1f}; espn-tx claim {how} \"{swap['add']}\" "
                         f"--drop \"{swap['drop']}\")"),
            "--action", reply_button("Skip", f"Skip the {swap['add']} swap; leave {swap['drop']} alone"),
        ]
    subprocess.run([str(NOTIFY), msg, "MIST roster watch", "default", link, "--group", "roster-watch", "--discord",
                    *actions], check=False, capture_output=True, timeout=20)
    if judgment and not args.no_routine and RUNNER.exists():
        with ROUTINE_LOG.open("a") as logf:
            subprocess.Popen(["/bin/bash", str(RUNNER), "fantasy-incident"], stdout=logf, stderr=logf,
                             start_new_session=True)
        print(f"{stamp} started fantasy-incident routine")
    return 0


if __name__ == "__main__":
    sys.exit(main())
