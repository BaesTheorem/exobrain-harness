#!/usr/bin/env python3
"""roster-watch: notice what happens to Chaos Legion between MIST's scheduled runs.

Every 30 minutes from launchd (com.exobrain.roster-watch). Diffs the roster's
injury statuses, our pending claims, pending transactions aimed at the team
(a trade offer), the players on fantasy/watchlist.json (status, a rostered-percentage
spike, which fantasy team holds them), and the rosters of watched teams against
the last run. It also runs fantasy/bin/swap-scan and, when a bench-for-wire
swap crosses the playbook's waiver gate for the first time, files it after a
review. History: 2026-09-20 every drop was Alex's tap; 2026-10-22 a narrow
lane (free-agent K or D/ST) filed by itself. On 2026-11-01, after Ryan Flournoy
cleared the gate twice and a rival took him while the banner waited, Alex
widened it: "automate swaps moving forward so I don't miss them", with "an
additional manual check via Opus 5.5 invoking the /fantasy-football skill to
review before proceeding on any swap." So every gated swap (free agent or
waiver claim, any position) whose drop is on our bench or IR goes to a
headless Opus 5.5 run of the skill (`opus_review`). FILE files it through
espn-tx and the banner carries Undo. HOLD, a timeout, or an unreadable answer
files nothing and the banner carries Do it / Skip with the review's reason.
Anything new is appended to
fantasy/.cache/incidents.jsonl, announced with a clickable banner, and, when
it needs judgment (a starter going out, an IR designation, a trade offer, a
processed claim), handed to the fantasy-incident routine, which runs headless
Claude on Opus 5.5 through the Console's routine runner. Silence means nothing
changed.

    roster-watch [--dry-run] [--no-routine]
"""

from __future__ import annotations

import argparse
import json
import pathlib
import os
import re
import shutil
import subprocess
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
FANTASY = HERE.parent
sys.path.insert(0, str(FANTASY))
STATE = FANTASY / ".cache" / "roster-watch.json"
INCIDENTS = FANTASY / ".cache" / "incidents.jsonl"
WATCHLIST = FANTASY / "watchlist.json"
NOTIFY = FANTASY.parent / "mist-voice" / "bin" / "mist-notify"
RUNNER = pathlib.Path("/Users/alexhedtke/Documents/mist-console/run-routine.sh")
ROUTINE_LOG = pathlib.Path.home() / "Library" / "Logs" / "mist-routines.log"
from espncli.client import web_urls  # noqa: E402  (needs the sys.path line above)

_URLS = web_urls()  # ids come from the gitignored espn-credentials.json
ROSTER_URL = _URLS["team"]
LEAGUE_URL = _URLS["league"]
NEEDS_JUDGMENT = {"OUT", "DOUBTFUL", "INJURY_RESERVE", "SUSPENSION"}
SWAP_SCAN = HERE / "swap-scan"
REPLY_URL = "http://127.0.0.1:5014/notify-reply"
RIVALS_MAX_AGE = 6 * 3600
ESPN_TX = HERE / "espn-tx"
HARNESS = FANTASY.parent
SHORT_MAX = 140                      # banner length of a review reason; the full one goes to the log
# A swap the review HELD sends no banner when it is worth less than this many
# points of title odds on the absence model (espncli/depth.py). 0.25 is about
# one point at the second bench place (0.21). On 2026-11-11 the held swaps were
# worth 0.16 and 0.005, and a 13-point receiver for the same drops 1.7 to 1.8,
# so the line is not close to either group. The gate, the review and the
# auto-file lane do not read this: a FILE verdict files as before.
QUIET_HOLD_BELOW = 0.25
PLAYOFF_WEEKS = 3                    # weeks 15-17
REVIEW_MODEL = "claude-opus-5-5"     # Alex, 2026-11-01: the review runs on Opus 5.5
REVIEW_TIMEOUT = 900
SAME_POS_ONLY = {"QB", "TE", "K", "D/ST"}   # never a second QB or TE; K and D/ST swap like for like
POS_NAME = {1: "QB", 2: "RB", 3: "WR", 4: "TE", 5: "K", 16: "D/ST"}


def rivals_needing(pos: str) -> list[str]:
    """Other teams with an uncovered need at `pos` this week or next, from the
    last rival-scan build (espncli.rivals, fantasy/.cache/rivals-*.json, at
    most six hours old; no new ESPN reads). A free agent goes to whoever files
    first, so a rival with the same need is a race (2026-10-22: the Titans D/ST
    cleared our gate at 4:04 PM, sat on a banner, and went to a rival at
    11:48 AM the next day)."""
    try:
        f = max((FANTASY / ".cache").glob("rivals-*.json"), key=lambda x: x.stat().st_mtime)
        if time.time() - f.stat().st_mtime > RIVALS_MAX_AGE:
            return []
        board = json.loads(f.read_text()).get("board", [])
    except (ValueError, OSError):
        return []
    out = []
    for b in board:
        need = (b.get("needs") or []) + (b.get("needs_next") or [])
        if not b.get("mine") and (pos in need or (pos in ("RB", "WR", "TE") and "RB/WR/TE" in need)):
            ab = b.get("abbrev") or ""
            out.append(ab if len(ab) >= 3 else b.get("team") or ab)
    return out


def race_note(avail: str, pos: str, rivals: list[str]) -> str:
    if avail == "FA" and rivals:
        return f"; {', '.join(rivals)} need a {pos} too, and a free agent goes to whoever files first"
    if avail == "FA":
        return "; free agent, first come"
    return ""


def _claude() -> str | None:
    """launchd gives this job no PATH, so look in ~/.local/bin as well. Never a
    pinned versions/ path: those break on every update."""
    path = os.pathsep.join([os.environ.get("PATH", ""), str(pathlib.Path.home() / ".local" / "bin")])
    return shutil.which("claude", path=path)


def opus_review(ev: dict) -> dict:
    """Ask Opus 5.5, through the /fantasy-football skill, whether to file this swap.

    Returns {"verdict": "FILE"|"HOLD", "reason": str}. Anything other than a
    clear FILE is a HOLD: a review that times out or answers in the wrong shape
    must never become a roster write. The reviewer only reads; roster-watch
    does the write after the verdict, so a FILE cannot be half done."""
    claude = _claude()
    if not claude:
        return {"verdict": "HOLD", "reason": "claude CLI not found"}
    pos = ev.get("add_pos") or ev.get("slot")
    kind = "free-agent add (first come)" if ev.get("avail") == "FA" else "waiver claim"
    gain = gain_text(ev) if ev.get("gain") is not None else str(ev.get("why", ""))
    prompt = (
        "/fantasy-football\n\n"
        "Review mode, read-only. roster-watch (fantasy/bin/roster-watch) found a swap that clears the "
        "waiver gate and will file it only if you approve. Do NOT run espn-tx claim, move, or any other "
        "write yourself, and send no notifications.\n\n"
        f"Swap: add {ev['add']} ({pos}, {kind}), drop {ev['drop']}. {gain}. "
        f"Rivals with the same need: {', '.join(ev.get('rivals') or []) or 'none recorded'}. "
        f"Volume flags: {', '.join(ev.get('flags') or []) or 'none'}.\n\n"
        "Check what the gate does not: the drop's real outlook (an IR return date, a role coming back, "
        "a pending trade offer from espn-tx pending), the add's news and role, the rules in "
        "fantasy/routines/COMMON.md (rule 3), and whether a different add on the swap-scan board is "
        "clearly better for the same drop. Run fantasy/bin/swap-scan and other read-only tools as you need.\n\n"
        "End your reply with exactly one line of JSON and nothing after it:\n"
        '{"verdict": "FILE" or "HOLD", "reason": "one sentence", '
        '"short": "the same reason in at most 140 characters, for a phone banner"}'
    )
    try:
        r = subprocess.run([claude, "-p", prompt, "--model", REVIEW_MODEL, "--permission-mode", "bypassPermissions"],
                           capture_output=True, text=True, timeout=REVIEW_TIMEOUT, check=False,
                           cwd=HARNESS, env={**os.environ, "MIST_UNATTENDED": "1"})
    except (OSError, subprocess.SubprocessError) as exc:
        return {"verdict": "HOLD", "reason": f"review did not finish: {str(exc)[:160]}"}
    return parse_verdict(r.stdout or "")


def parse_verdict(text: str) -> dict:
    """The last {"verdict": ...} object in the reply, or a HOLD."""
    for m in reversed(list(re.finditer(r'\{[^{}]*"verdict"[^{}]*\}', text))):
        try:
            v = json.loads(m.group(0))
        except json.JSONDecodeError:
            continue
        verdict = str(v.get("verdict", "")).upper()
        reason = str(v.get("reason", ""))[:300]
        return {"verdict": "FILE" if verdict == "FILE" else "HOLD", "reason": reason,
                "short": clip(str(v.get("short") or reason), SHORT_MAX)}
    return {"verdict": "HOLD", "reason": "review gave no verdict line", "short": "review gave no verdict line"}


def clip(text: str, n: int) -> str:
    """`text` cut to at most `n` characters at a word boundary, marked when cut."""
    text = " ".join(text.split())
    if len(text) <= n:
        return text
    return text[: n - 3].rsplit(" ", 1)[0].rstrip(",;:") + "..."


def gain_text(ev: dict) -> str:
    """A swap's gain in points a game, the unit the gate is set in.

    swap-scan's `gain` is the rate gap times a horizon in regular-week units,
    with weeks 15-17 at their title weight from `.cache/leverage.json`. Found
    2026-11-11: once our playoff odds reached 99.9%, a regular-week point
    moved the title odds by almost nothing, weeks 16 and 17 went from about
    11 units to 74 and 84, and the same 1.46-a-game Montgomery-for-Vele gap
    bannered as "+66.3 pts" one day and "+241.1 pts" the next. The gate
    scales the same way, so pass or fail did not change, but the total read
    as real points to Alex and to the Opus review."""
    gain, gate, weeks = float(ev["gain"]), float(ev.get("gate") or 0), float(ev.get("weeks") or 0)
    if weeks <= 0:
        return f"+{gain:.1f} on the swap-scan horizon (gate +{gate:.1f})"
    out = f"+{gain / weeks:.2f} pts a game over {ev.get('drop') or 'the drop'} (gate {gate / weeks:.2f})"
    if ev.get("games"):
        out += f", about {gain / weeks * ev['games']:+.0f} pts over the {ev['games']} games left"
    return out


def auto_file(ev: dict, bench: dict[str, str]) -> dict | None:
    """Review, then file the swap. None when the event is outside the lane.

    The lane: the drop is on our bench or IR (never a starter, never a player
    spent in a pending claim or offer: the caller removes those from `bench`),
    and a QB, TE, K or D/ST swaps only for the same position. Every swap in the
    lane goes to `opus_review` first. espn-tx exits nonzero unless its
    read-back shows the change, so `verified` is ESPN's word, not ours."""
    pos = ev.get("add_pos") or ev.get("slot")
    drop = ev.get("drop")
    if ev.get("avail") not in ("FA", "WVR") or not pos or not drop or drop not in bench:
        return None
    if (pos in SAME_POS_ONLY or bench[drop] in SAME_POS_ONLY) and bench[drop] != pos:
        return None
    rivals = ev.get("rivals") or rivals_needing(pos)
    review = opus_review({**ev, "rivals": rivals})
    if review["verdict"] != "FILE":
        return {"verified": False, "held": True, "review": review, "rivals": rivals, "out": ""}
    cmd = [sys.executable, str(ESPN_TX), "claim", *(["--fa"] if ev["avail"] == "FA" else []), ev["add"], "--drop", drop]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180, check=False)
        return {"verified": r.returncode == 0, "review": review, "rivals": rivals, "out": (r.stdout or r.stderr)[-400:]}
    except (OSError, subprocess.SubprocessError) as exc:
        return {"verified": False, "review": review, "rivals": rivals, "out": str(exc)[:400]}


def log_race(path: pathlib.Path, ev: dict, stamp: str) -> None:
    """One row per free-agent banner, filed or not. rival-scan --settle reads
    these to count how often a rival takes an unfiled free agent first, which
    decides whether the auto lane widens past K and D/ST (asked 2026-10-22)."""
    pos = ev.get("add_pos") or ev.get("slot")
    # A count, not names: the file is tracked in a public repo.
    row = {"ts": stamp, "kind": ev["kind"], "add": ev["add"], "pos": pos, "drop": ev.get("drop"),
           "rivals": len(ev.get("rivals") or rivals_needing(pos or "")), "filed": bool((ev.get("filed") or {}).get("verified"))}
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as fh:
        fh.write(json.dumps(row) + "\n")


def filed_note(ev: dict) -> str:
    """The banner tail for a swap the lane looked at: verified, held, or failed."""
    f = ev.get("filed") or {}
    if not f:
        return ""
    review = f.get("review") or {}
    reason = review.get("short") or clip(review.get("reason", ""), SHORT_MAX)
    if f.get("held"):
        return f"; Opus review held it ({reason}), tap Do it to file anyway"
    if f.get("verified"):
        return f"; Opus review: {reason}; ESPN read-back verified"
    return "; the auto-file did not verify, tap Do it"


def hold_title_value(ev: dict) -> float | None:
    """Title points of a held swap through the absence model, or None when the
    model does not cover it or cannot run. None means: banner as before."""
    try:
        from espncli import depth  # noqa: PLC0415 -- only a held swap needs the model
        if ev.get("add_rate") is None:
            return None
        return depth.swap_title_value(ev["drop"], (ev["add"], ev["add_pos"], float(ev["add_rate"])), ev.get("drop_pos"))
    except Exception as exc:  # noqa: BLE001 -- a pricing failure must never hide a banner
        print(f"hold value unavailable: {exc}")
        return None


def quiet_hold(ev: dict, value: float | None) -> bool:
    """A swap the review held and the absence model prices under QUIET_HOLD_BELOW.
    Only a HOLD is ever quiet: a filed swap, a failed file and a swap the model
    cannot price all keep their banner."""
    f = ev.get("filed") or {}
    return bool(ev.get("kind") == "swap_gate" and f.get("held") and not f.get("verified")
                and value is not None and value < QUIET_HOLD_BELOW)


def reply_button(label: str, text: str) -> str:
    """A mist-notify --action that posts `text` into the Console as Alex's reply."""
    payload = json.dumps({"text": text})
    return (f"{label}=cmd:/usr/bin/curl -sS -X POST {REPLY_URL} "
            f"-H 'Content-Type: application/json' -d '{payload}'")


def swap_gate_event(st: dict) -> dict | None:
    """The best bench-for-wire swap that clears the gate and has not been offered yet.

    State remembers every pair offered while it stays above the gate, so a swap
    that stays above the gate for days produces one banner, not one every 30
    minutes. Each drop and each add is offered with its best partner only. A
    pair that falls below the gate leaves the set, and it is new if it comes back.
    Until 2026-11-10 only the single best pair was considered: a HOLD on Malachi
    Fields for Devin Singletary (+85.8) hid Buccaneers D/ST for Steelers D/ST
    (+85.1) for eight hours, because the held pair stayed on top.
    """
    try:
        out = subprocess.run([sys.executable, str(SWAP_SCAN), "--json"], capture_output=True,
                             text=True, timeout=240, check=True).stdout
        scan = json.loads(out)
    except Exception as exc:  # the watcher's other checks must still run
        print(f"swap-scan unavailable: {exc}")
        return None
    gate = float(scan.get("gate", 20.0))
    games_left = int(scan.get("remaining_weeks") or 0) + PLAYOFF_WEEKS
    pairs: list[dict] = []
    for row in scan.get("swaps", []):
        if row.get("pending_drop"):
            continue   # that drop is already spent arming a pending claim (2026-09-20, Noel)
        for c in row.get("candidates", []):
            if c.get("pending_add"):
                continue   # already claimed with another drop (2026-11-03, Mitchell for Downs, then Burks)
            if float(c["gain"]) < gate:
                continue
            pairs.append({"drop": row["drop"], "drop_pos": row["pos"], "add": c["add"],
                          "weeks": float(row.get("weeks") or 0), "games": games_left,
                          "add_rate": c.get("add_rate"), "drop_rate": row.get("drop_rate"),
                          "add_pos": c["pos"], "avail": c["avail"], "gain": float(c["gain"]),
                          "owned": c["owned"], "trend": c["trend"], "flags": c.get("flags") or []})
    pairs.sort(key=lambda b: -b["gain"])
    gs = st.setdefault("swap_gate", {})
    prev = gs.get("offered") or []
    if isinstance(prev, str):
        prev = [prev]   # the state before 2026-11-10 held one pair
    live = {f"{b['drop']}|{b['add']}" for b in pairs}
    offered = [p for p in prev if p in live]
    used_drops = {p.split("|", 1)[0] for p in offered}
    used_adds = {p.split("|", 1)[1] for p in offered}
    gs["offered"] = offered
    for b in pairs:
        if b["drop"] in used_drops or b["add"] in used_adds:
            continue
        offered.append(f"{b['drop']}|{b['add']}")
        return {"kind": "swap_gate", "gate": gate, "judgment": False, "rivals": rivals_needing(b["add_pos"]), **b}
    return None


def stream_gate_event(st: dict) -> dict | None:
    """A K or D/ST streamer that clears the playbook's thresholds (bin/stream-scan),
    once per candidate: the same one-banner-per-pair memory as the swap gate."""
    try:
        out = subprocess.run([sys.executable, str(HERE / "stream-scan"), "--json"], capture_output=True,
                             text=True, timeout=240, check=True).stdout
        scan = json.loads(out)
    except Exception as exc:
        err = (getattr(exc, "stderr", "") or "").strip().splitlines()[-3:]
        print(f"stream-scan unavailable: {exc}" + (f" | stderr: {' / '.join(err)}" if err else ""))
        return None
    gs = st.setdefault("stream_gate", {})
    for label in ("dst", "k"):
        v = scan.get(label)
        if v and v.get("start_bench"):
            b = v["start_bench"]
            if b.get("pending"):     # better D/ST already claimed: no lineup move until it lands
                gs[label] = None
                continue
            pair = f"{v['ours']}|{b['name']}|BE|{scan.get('week')}"
            if gs.get(label) == pair:
                continue
            gs[label] = pair
            return {"kind": "stream_gate", "slot": "D/ST", "ours": v["ours"], "add": b["name"],
                    "avail": "BE", "why": v["why"], "judgment": False}
        if not v or not v.get("stream") or not v.get("best_fa"):
            gs[label] = None
            continue
        cand = v["best_fa"][0]
        pair = f"{v['ours']}|{cand['name']}|{scan.get('week')}"
        if gs.get(label) == pair:
            continue
        gs[label] = pair
        return {"kind": "stream_gate", "slot": "D/ST" if label == "dst" else "K", "ours": v["ours"],
                "drop": v.get("drop") or v["ours"], "add": cand["name"], "avail": cand["avail"],
                "why": v["why"], "judgment": False}
    return None


def idle_next(api, data: dict, team_id: int) -> dict | None:
    """In our idle week, the week that counts next and each player's slot and
    kickoff in it; None in a normal week. An idle week's slots score nothing,
    so a status change there is week N+1 prep, and the banner says which slot
    it touches (Alex, 2026-10-29: keep the alerts, aim them at week 9)."""
    week = api.current_week(data)
    games = [m for m in data.get("schedule", []) if m.get("matchupPeriodId") == week]
    if not games or any(team_id in ((m.get("home") or {}).get("teamId"), (m.get("away") or {}).get("teamId"))
                        for m in games if m.get("home") and m.get("away")):
        return None
    from espncli.cli import when  # noqa: PLC0415
    from espncli.client import SLOT  # noqa: PLC0415
    nxt = week + 1
    slots = {}
    for e in api.roster_entries(api.league("mRoster", period=nxt), team_id):
        p = e["playerPoolEntry"]["player"]
        slots[str(p["id"])] = {"slot": SLOT.get(e.get("lineupSlotId"), "?"),
                               "kickoff": when(api.kickoff(p.get("proTeamId"), nxt))}
    return {"week": week, "next": nxt, "slots": slots}


def status_head(ev: dict) -> str:
    head = f"{ev['player']}: {ev['from']} -> {ev['to']}"
    if ev.get("idle_week"):
        slot = ev.get("next_slot") or "?"
        lock = f", locks {ev['next_kickoff']}" if slot not in ("BE", "IR", "?") and ev.get("next_kickoff") else ""
        return head + f" (idle week {ev['idle_week']}; week {ev['next_week']} {slot}{lock})"
    return head + (" (starter)" if ev.get("starter") else "")


def load(path: pathlib.Path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def trade_outcome(api, tid: str) -> str:
    """accepted, rejected, expired or unknown for one of our offers, from the
    transaction log (rule inventory R109 in code, 2026-10-15). A CANCEL row
    written by ESPN's trade processor is the two-day expiry; one written by a
    manager, or a TRADE_DECLINE row, is a rejection; an accept or uphold row,
    or the offer itself EXECUTED, is a trade. The roster diff still confirms
    an accepted one before anything is moved."""
    try:
        cur = api.current_week(api.league("mStatus"))
        rows = [t for w in range(max(1, cur - 2), cur + 1)
                for t in api.league("mTransactions2", period=w).get("transactions", [])]
    except Exception:  # noqa: BLE001 - the routine falls back to reading the log by hand
        return "unknown"
    out = "unknown"
    for t in rows:
        if t.get("id") != tid and t.get("relatedTransactionId") != tid:
            continue
        typ, st, member = t.get("type"), t.get("status"), str(t.get("memberId") or "")
        if typ in ("TRADE_ACCEPT", "TRADE_UPHOLD") or (t.get("id") == tid and st == "EXECUTED"):
            return "accepted"
        if typ == "TRADE_DECLINE":
            out = "rejected"
        elif t.get("executionType") == "CANCEL" and out == "unknown":
            out = "expired" if (not member or "Processor" in member) else "rejected"
    return out


def watched_trade_events(pend: list, teams: list, watch: dict, state: dict, me: int) -> list[dict]:
    """Pings for trades between other teams that involve a team on the watch
    list's `trade_teams` (Alex, 2026-11-06, after Njigba Please! cast the first
    veto vote of the season against our Nacua trade: "ping me if a trade
    involving Samy ever occurs again"). ESPN shows another team's trade only
    after both sides accept it, during the veto review, so the first ping is
    `opened` (Alex can still vote); the second is `closed`, when the row leaves
    the pending list, with the outcome read off the rosters. A trade that
    involves us is left to the trade_offer and trade_resolved events.
    `state` (id -> the open trade) is updated in place."""
    from espncli.client import team_name  # noqa: PLC0415
    tname = {t["id"]: team_name(t) for t in teams}
    holder, pname = {}, {}
    for t in teams:
        for e in (t.get("roster") or {}).get("entries", []):
            holder[e["playerId"]] = t["id"]
            pname[e["playerId"]] = e["playerPoolEntry"]["player"]["fullName"]
    out, open_now = [], set()
    for t in pend:
        if not str(t.get("type", "")).startswith("TRADE"):
            continue
        items = [i for i in t.get("items") or [] if i.get("playerId") is not None]
        parties = {i.get(k) for i in items for k in ("fromTeamId", "toTeamId")} - {None}
        hit = sorted(parties & set(watch))
        if not hit or me in parties:
            continue
        tid = t.get("id")
        open_now.add(tid)
        if tid in state:
            continue
        moves = [{"player": pname.get(i["playerId"], str(i["playerId"])), "id": i["playerId"],
                  "from": i.get("fromTeamId"), "to": i.get("toTeamId")} for i in items]
        state[tid] = {"teams": sorted(parties), "moves": moves, "process_at": t.get("processDate"),
                      "watched": [watch[h].get("name") or tname.get(h, str(h)) for h in hit]}
        out.append({"kind": "watched_trade", "phase": "opened", "id": tid, **state[tid],
                    "names": {str(k): tname.get(k, str(k)) for k in parties}, "judgment": False})
    for tid in [k for k in state if k not in open_now]:
        tr = state.pop(tid)
        landed = [holder.get(m["id"]) == m["to"] for m in tr["moves"]]
        stayed = [holder.get(m["id"]) == m["from"] for m in tr["moves"]]
        outcome = "executed" if all(landed) else "vetoed or canceled" if all(stayed) else "closed (see rosters)"
        out.append({"kind": "watched_trade", "phase": "closed", "id": tid, "outcome": outcome, **tr,
                    "names": {str(k): tname.get(k, str(k)) for k in tr["teams"]}, "judgment": False})
    return out


def lm_move_events(rows: list, prev_holder: dict, holder: dict, names: dict, tname: dict,
                   seen: list, me: int) -> list[dict]:
    """League-manager moves on any roster (Alex, 2026-11-06: after the Nacua
    trade executed, the commissioner is a bye rival, and ESPN's LM Tools can
    move players back by hand). Two detectors, because no 2026 row has the
    flag set, so the first has never been seen to fire on real data:
      1. a transaction row with isLeagueManager and not isActingAsTeamOwner
         (the same test as league-scan's integrity block);
      2. a player who is on a different team than at the last run with no
         TRADE row that names him (a trade is the only owner path from one
         roster straight to another; a drop then a claim passes through the
         wire, and a free agent has no team).
    `seen` (row ids already reported) is extended in place."""
    out = []
    flagged = {i.get("playerId") for t in rows if t.get("isLeagueManager") and not t.get("isActingAsTeamOwner")
               for i in t.get("items") or []}
    traded = flagged | {i.get("playerId") for t in rows if str(t.get("type", "")).startswith("TRADE")
              for i in t.get("items") or []}
    for t in rows:
        if t.get("isLeagueManager") and not t.get("isActingAsTeamOwner") and t.get("id") not in seen:
            seen.append(t.get("id"))
            items = [f"{(i.get('type') or '').lower()} {names.get(str(i.get('playerId')), i.get('playerId'))}"
                     for i in t.get("items") or []]
            teams = {i.get(k) for i in t.get("items") or [] for k in ("fromTeamId", "toTeamId")} | {t.get("teamId")}
            out.append({"kind": "lm_move", "via": "flag", "id": t.get("id"), "type": t.get("type"),
                        "team": tname.get(t.get("teamId"), str(t.get("teamId"))), "items": items,
                        "ours": me in teams, "judgment": me in teams})
    for pid, cur in holder.items():
        was = prev_holder.get(pid)
        if was and cur and was != cur and int(pid) not in traded:
            out.append({"kind": "lm_move", "via": "roster", "player": names.get(str(pid), str(pid)),
                        "from_team": tname.get(was, str(was)), "to_team": tname.get(cur, str(cur)),
                        "ours": me in (was, cur), "judgment": me in (was, cur)})
    return out


def lm_move_head(ev: dict) -> str:
    if ev["via"] == "flag":
        return f"LEAGUE MANAGER move on {ev['team']}: {', '.join(ev['items']) or ev.get('type')}"
    return (f"LEAGUE MANAGER move? {ev['player']} went from {ev['from_team']} to {ev['to_team']} "
            f"with no trade on record")


def watched_trade_head(ev: dict) -> str:
    nm = ev.get("names", {})
    sides: dict[str, list[str]] = {}
    for m in ev["moves"]:
        sides.setdefault(nm.get(str(m["to"]), str(m["to"])), []).append(m["player"])
    gets = "; ".join(f"{team} gets {', '.join(ps)}" for team, ps in sides.items())
    who = ", ".join(ev.get("watched") or [])
    if ev["phase"] == "opened":
        return f"trade watch ({who}): trade in veto review, {gets}. You can vote in ESPN"
    return f"trade watch ({who}): trade {ev['outcome']}, {gets}"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-routine", action="store_true", help="record and notify, but do not start the incident routine")
    args = ap.parse_args()

    from espncli.client import Espn  # noqa: PLC0415
    api = Espn()
    team_id = int(api.creds["team_id"])
    data = api.league("mTeam", "mRoster", "mPendingTransactions", "mMatchup")
    stamp = time.strftime("%Y-%m-%d %H:%M")
    st = load(STATE, {"status": {}, "pending": {}, "first_run": True})
    events: list[dict] = []

    # 1. Injury status per rostered player (starters flagged).
    statuses, starters = {}, set()
    bench: dict[str, str] = {}           # bench player name -> position, for the auto-file lane
    bench_ids: dict[str, int] = {}
    for e in api.roster_entries(data, team_id):
        p = e["playerPoolEntry"]["player"]
        if e.get("lineupSlotId") in (20, 21):   # bench or IR: never a starter
            bench[p["fullName"]] = POS_NAME.get(p.get("defaultPositionId") or 0, "")
            bench_ids[p["fullName"]] = p["id"]
        statuses[str(p["id"])] = {"name": p["fullName"], "status": p.get("injuryStatus") or "",
                                  "slot": e.get("lineupSlotId")}
        if e.get("lineupSlotId") not in (20, 21):
            starters.add(str(p["id"]))
    idle = None
    for pid, cur in statuses.items():
        prev = st["status"].get(pid)
        if prev is None:
            continue  # new to the roster; the claim result covers it
        if prev.get("status") != cur["status"]:
            if idle is None:
                try:
                    idle = idle_next(api, data, team_id) or {}
                except Exception:  # noqa: BLE001 - fall back to this week's wording
                    idle = {}
            ev = {"kind": "status", "player": cur["name"], "from": prev.get("status") or "healthy",
                  "to": cur["status"] or "healthy", "starter": pid in starters}
            if idle:
                nxt = idle["slots"].get(pid, {})
                ev["starter"] = nxt.get("slot") not in (None, "BE", "IR", "?")
                ev.update({"idle_week": idle["week"], "next_week": idle["next"],
                           "next_slot": nxt.get("slot"), "next_kickoff": nxt.get("kickoff")})
            # A player in our IR slot who leaves INJURY_RESERVE no longer
            # qualifies for it, and ESPN can then block claims (Tyson, 11-07).
            ev["judgment"] = (cur["status"] in NEEDS_JUDGMENT and ev["starter"]
                              or cur["status"] == "INJURY_RESERVE"
                              or (cur.get("slot") == 21 and prev.get("status") == "INJURY_RESERVE"))
            events.append(ev)
    for pid in list(st["status"]):
        if pid not in statuses:
            events.append({"kind": "left_roster", "player": st["status"][pid]["name"], "judgment": False})
    for pid, cur in statuses.items():
        if pid not in st["status"] and not st.get("first_run"):
            events.append({"kind": "joined_roster", "player": cur["name"], "judgment": False})

    # 2. Pending transactions: our claims (status changes) and anything aimed at us.
    pend = data.get("pendingTransactions") or []
    seen = st["pending"]
    now_ids = set()
    for t in pend:
        tid = t.get("id"); now_ids.add(tid)
        mine = t.get("teamId") == team_id
        aimed = any(i.get("toTeamId") == team_id or i.get("fromTeamId") == team_id for i in t.get("items", []))
        if tid not in seen:
            if not mine and aimed:
                events.append({"kind": "trade_offer" if "TRADE" in str(t.get("type", "")) else "incoming_transaction",
                               "from_team": t.get("teamId"), "type": t.get("type"), "status": t.get("status"),
                               "items": t.get("items"), "id": tid, "judgment": True})
            seen[tid] = {"type": t.get("type"), "status": t.get("status"), "mine": mine}
        elif seen[tid].get("status") != t.get("status"):
            events.append({"kind": "waiver_result" if mine else "transaction_update", "id": tid,
                           "type": t.get("type"), "from": seen[tid].get("status"), "to": t.get("status"),
                           "items": t.get("items"), "judgment": mine})
            seen[tid]["status"] = t.get("status")
    from espncli.tx import self_closed  # noqa: PLC0415
    ours_closed = self_closed()
    for tid in list(seen):
        if tid not in now_ids and tid in ours_closed:
            seen.pop(tid)  # we withdrew it (espn-tx withdraw); nothing to judge
            continue
        if tid not in now_ids and seen[tid].get("mine") and seen[tid].get("status") == "PENDING":
            # A claim that vanished from pending was processed (executed or failed);
            # the roster diff above says which. An outgoing trade offer that vanished
            # was accepted, rejected, or expired (ESPN's TradeTaskProcessor writes a
            # CANCELED row with relatedTransactionId at the 2-day mark and the
            # original stays PENDING forever). Hand either to the routine to log.
            trade = "TRADE" in str(seen[tid].get("type", ""))
            outcome = trade_outcome(api, tid) if trade else None
            events.append({"kind": "trade_resolved" if trade else "waiver_result", "id": tid,
                           "type": seen[tid].get("type"), "outcome": outcome,
                           "from": "PENDING", "to": (outcome or "resolved (see roster)") if trade else "processed (see roster)",
                           "judgment": True})
            seen.pop(tid)

    # 3. The watch list: players we are tracking anywhere in the league, and teams
    #    whose roster moves matter (an absent manager showing up).
    wl = load(WATCHLIST, {"players": [], "teams": []})
    tw = {int(t["id"]): t for t in wl.get("trade_teams", [])}
    if tw:
        events += watched_trade_events(pend, data["teams"], tw, st.setdefault("watched_trades", {}), team_id)
    wstate = st.setdefault("watch", {})
    ids = [p["id"] for p in wl.get("players", []) if p.get("id") is not None]
    cards = {c["player"]["id"]: c for c in api.player_cards(ids)} if ids else {}
    for wp in wl.get("players", []):
        c = cards.get(wp["id"])
        if not c:
            continue
        pl = c["player"]
        cur = {"status": pl.get("injuryStatus") or "", "team": c.get("onTeamId") or 0,
               "owned": round((pl.get("ownership") or {}).get("percentOwned") or 0.0, 1)}
        prev = wstate.get(str(wp["id"]))
        if prev and not st.get("first_run"):
            if prev["status"] != cur["status"]:
                events.append({"kind": "watch_status", "player": wp["name"], "from": prev["status"] or "healthy",
                               "to": cur["status"] or "healthy", "why": wp["why"], "judgment": False})
            if prev["team"] != cur["team"]:
                events.append({"kind": "watch_owner", "player": wp["name"], "from_team": prev["team"], "to_team": cur["team"],
                               "why": wp["why"], "trigger": wp["trigger"], "judgment": True})
            # A rostered-percentage spike is the market pricing in a role change (a
            # backfield split resolving, a starter going down) before any box score
            # we read does. Per-player override via "own_jump" on the watchlist entry.
            jump = float(wp.get("own_jump", 10.0))
            # Once the player is ours, a climb is the market agreeing with a move we
            # already made. Only a drop (the role breaking) still needs a read.
            moved = cur["owned"] - prev.get("owned", cur["owned"])
            if (-moved if cur["team"] == team_id else abs(moved)) >= jump:
                events.append({"kind": "watch_ownership", "player": wp["name"], "from": prev.get("owned"),
                               "to": cur["owned"], "why": wp["why"], "trigger": wp["trigger"], "judgment": True})
        wstate[str(wp["id"])] = cur
    rosters = {str(t["id"]): sorted(e["playerId"] for e in (t.get("roster") or {}).get("entries", [])) for t in data["teams"]}
    prev_r = st.setdefault("rosters", {})
    # Names too: a dropped player is gone from every roster by the time we see the
    # diff, so his name has to come from the last run.
    names = st.get("roster_names", {})
    for t in data["teams"]:
        for e in (t.get("roster") or {}).get("entries", []):
            names[str(e["playerId"])] = e["playerPoolEntry"]["player"]["fullName"]
    for wt in wl.get("teams", []):
        key = str(wt["id"])
        if key in prev_r and prev_r[key] != rosters.get(key):
            before, after = set(prev_r[key]), set(rosters.get(key, []))
            events.append({"kind": "watched_team_moved", "team": wt["name"],
                           "added": [names.get(str(i), str(i)) for i in sorted(after - before)],
                           "dropped": [names.get(str(i), str(i)) for i in sorted(before - after)],
                           "why": wt["why"], "judgment": True})
    # 3b. League-manager moves on any roster (lm_move_events).
    try:
        cur_wk = api.current_week(api.league("mStatus"))
        lm_rows = [t for w in range(max(1, cur_wk - 1), cur_wk + 1)
                   for t in api.league("mTransactions2", period=w).get("transactions", []) or []]
    except Exception:  # noqa: BLE001 - the roster detector below still runs
        lm_rows = []
    from espncli.client import team_name  # noqa: PLC0415
    holder_now = {str(p): int(tid) for tid, ids in rosters.items() for p in ids}
    holder_prev = {str(p): int(tid) for tid, ids in prev_r.items() for p in ids}
    seeded = "lm_seen" in st
    lm_seen = st.setdefault("lm_seen", [])
    lm_evs = lm_move_events(lm_rows, holder_prev, holder_now, names,
                            {t["id"]: team_name(t) for t in data["teams"]}, lm_seen, team_id)
    if seeded and not st.get("first_run") and prev_r:  # the first pass only records what is there
        events += lm_evs
    st["lm_seen"] = lm_seen[-500:]
    st["rosters"] = rosters
    st["roster_names"] = {str(i): names[str(i)] for ids in rosters.values() for i in ids if str(i) in names}

    # 4. The waiver gate: a bench-for-wire swap worth 2.5+ points a game over the
    #    rest of the season, playoff weeks at their weight (swap-scan). Banner
    #    only; the drop is Alex's decision.
    if not st.get("first_run"):
        sg = swap_gate_event(st)
        if sg:
            events.append(sg)
        sg = stream_gate_event(st)
        if sg:
            events.append(sg)

    st["status"] = statuses
    st["first_run"] = False
    if not events:
        print(f"{stamp} no change ({len(statuses)} rostered, {len(pend)} pending)")
        if not args.dry_run:
            STATE.parent.mkdir(parents=True, exist_ok=True); STATE.write_text(json.dumps(st, indent=1))
        return 0

    for ev in events:
        ev.update({"ts": stamp, "handled": False})
        print(f"{stamp} EVENT {json.dumps(ev)[:300]}")
    if args.dry_run:
        return 0
    races = FANTASY / "forecasts" / f"fa-races-{api.season}.jsonl"
    # A bench player already named in a pending claim or offer is spent: dropping
    # him voids that row (2026-10-22: the 49ers are the drop of the Jaguars claim).
    spent = {i.get("playerId") for t in (data.get("pendingTransactions") or []) for i in (t.get("items") or [])}
    bench = {n: pos for n, pos in bench.items() if bench_ids.get(n) not in spent}
    for ev in events:
        if ev["kind"] in ("swap_gate", "stream_gate") and ev.get("avail") in ("FA", "WVR"):
            filed = auto_file(ev, bench)
            if filed:
                ev["filed"] = filed
                print(f"{stamp} AUTO-FILE {ev['add']} for {ev.get('drop')}: review={filed['review']['verdict']} "
                      f"verified={filed['verified']} ({filed['review']['reason']})")
                if filed.get("held") and ev["kind"] == "swap_gate":
                    ev["title_value"] = hold_title_value(ev)
                    if quiet_hold(ev, ev["title_value"]):
                        ev["quiet"] = True
                        print(f"{stamp} QUIET {ev['add']} for {ev.get('drop')}: held, and worth {ev['title_value']:+.2f} "
                              f"title points on the absence model (under {QUIET_HOLD_BELOW}); no banner")
            if ev.get("avail") == "FA":
                log_race(races, ev, stamp)
    with INCIDENTS.open("a") as fh:
        for ev in events:
            fh.write(json.dumps(ev) + "\n")
    STATE.write_text(json.dumps(st, indent=1))

    # A quiet hold is in the incident log and the state above, and nowhere else.
    events = [ev for ev in events if not ev.get("quiet")]
    if not events:
        return 0
    heads = []
    for ev in events:
        if ev["kind"] == "status":
            heads.append(status_head(ev))
        elif ev["kind"] == "trade_offer":
            heads.append("trade offer received")
        elif ev["kind"] == "waiver_result":
            heads.append("waiver claim processed")
        elif ev["kind"] == "watch_status":
            heads.append(f"watch: {ev['player']} {ev['from']} -> {ev['to']}")
        elif ev["kind"] == "watch_owner":
            heads.append(f"watch: {ev['player']} changed hands")
        elif ev["kind"] == "watch_ownership":
            heads.append(f"watch: {ev['player']} {ev['from']}% -> {ev['to']}% rostered")
        elif ev["kind"] == "lm_move":
            heads.append(lm_move_head(ev))
        elif ev["kind"] == "watched_trade":
            heads.append(watched_trade_head(ev))
        elif ev["kind"] == "watched_team_moved":
            moves = [f"added {', '.join(ev['added'])}" if ev.get("added") else "",
                     f"dropped {', '.join(ev['dropped'])}" if ev.get("dropped") else ""]
            heads.append(f"{ev['team']} {' and '.join(m for m in moves if m) or 'made a roster move'}")
        elif ev["kind"] == "stream_gate":
            if ev["avail"] == "BE":
                heads.append(f"lineup {ev['slot']}: {ev['why']}")
            else:
                if (ev.get("filed") or {}).get("verified"):
                    heads.append(f"filed: streamed {ev['add']} for {ev['drop']} at {ev['slot']} ({ev['why']})"
                                 + filed_note(ev))
                else:
                    heads.append(f"stream {ev['slot']}: {ev['add']} ({ev['avail']}) for {ev.get('drop') or ev['ours']}, {ev['why']}"
                                 + race_note(ev["avail"], ev["slot"], rivals_needing(ev["slot"]))
                                 + filed_note(ev))
        elif ev["kind"] == "swap_gate":
            fl = f", volume {'/'.join(ev['flags'])}" if ev.get("flags") else ""
            if (ev.get("filed") or {}).get("verified"):
                what = "added" if ev["avail"] == "FA" else "claimed off waivers"
                heads.append(f"filed: {what} {ev['add']} for {ev['drop']} ({gain_text(ev)})"
                             + filed_note(ev))
            else:
                heads.append(f"wire: add {ev['add']} ({ev['add_pos']}, {ev['avail']}) for "
                             f"{ev['drop']} clears the gate, {gain_text(ev)}{fl}"
                             + race_note(ev["avail"], ev["add_pos"], ev.get("rivals") or [])
                             + filed_note(ev))
        else:
            heads.append(ev["kind"].replace("_", " ") + (f": {ev.get('player')}" if ev.get("player") else ""))
    judgment = any(ev.get("judgment") for ev in events)
    msg = "; ".join(heads)[:400] + (". MIST is on it." if judgment and not args.no_routine else "")
    link = LEAGUE_URL if any(ev["kind"] in ("trade_offer", "watched_trade") for ev in events) else ROSTER_URL
    actions = ["--action", "Ask MIST=console"]
    swap = next((ev for ev in events if ev["kind"] == "swap_gate"), None)
    stream = next((ev for ev in events if ev["kind"] == "stream_gate"), None)
    if stream and not swap and stream["avail"] == "BE":
        actions = [
            "--action", reply_button(
                "Do it", f"Lineup from roster-watch: start {stream['add']} over {stream['ours']} "
                         f"({stream['why']}; espn-tx move \"{stream['ours']}\" --to BE, then "
                         f"espn-tx move \"{stream['add']}\" --to {stream['slot']})"),
            "--action", reply_button("Skip", f"Keep {stream['ours']} in the {stream['slot']} slot"),
        ]
    elif stream and not swap:
        how = "--fa" if stream["avail"] == "FA" else ""
        actions = [
            "--action", reply_button(
                "Do it", f"Stream from roster-watch: add {stream['add']} for {stream['drop']} at {stream['slot']} "
                         f"({stream['why']}; espn-tx claim {how} \"{stream['add']}\" --drop \"{stream['drop']}\")"),
            "--action", reply_button("Skip", f"Skip the {stream['add']} stream; keep {stream['drop']}"),
        ]
    done = next((ev for ev in (swap, stream) if ev and (ev.get("filed") or {}).get("verified")), None)
    if done:
        undo = (f"Undo the roster-watch auto-swap: claim {done['drop']} back off waivers and drop "
                f"{done['add']} (espn-tx claim \"{done['drop']}\" --drop \"{done['add']}\")"
                if done.get("avail") == "FA" else
                f"Undo the roster-watch waiver claim: cancel the pending claim on {done['add']} "
                f"(espn-tx pending, then espn-tx cancel)")
        actions = [
            "--action", reply_button("Undo", undo),
            "--action", "Ask MIST=console",
        ]
    elif swap:
        how = "--fa" if swap["avail"] == "FA" else ""
        actions = [
            "--action", reply_button(
                "Do it", f"File the swap from roster-watch: drop {swap['drop']}, add {swap['add']} "
                         f"(swap-scan {gain_text(swap)}; espn-tx claim {how} \"{swap['add']}\" "
                         f"--drop \"{swap['drop']}\")"),
            "--action", reply_button("Skip", f"Skip the {swap['add']} swap; leave {swap['drop']} alone"),
        ]
    subprocess.run([str(NOTIFY), msg, "MIST roster watch", "default", link, "--group", "roster-watch", "--discord",
                    *actions], check=False, capture_output=True, timeout=20)
    if judgment and not args.no_routine and RUNNER.exists():
        with ROUTINE_LOG.open("a") as logf:
            subprocess.Popen(["/bin/bash", str(RUNNER), "fantasy-incident"], stdout=logf, stderr=logf,
                             start_new_session=True)
        print(f"{stamp} started fantasy-incident routine")
    return 0


if __name__ == "__main__":
    sys.exit(main())
