#!/bin/sh
# draft-morning -- the pre-draft sequence, in the only order that works.
#
# Each step consumes the one before it (the board is built from the Ringer pull
# and the ECR pull; the sheet is built from the board), so running them by hand
# out of order builds on stale sources. This script is the order. It stops at
# the sign-off gate: while any board-vs-consensus divergence is unsigned, the
# gate exits nonzero, Alex signs with `signoff.py keep --thesis` or `correct`,
# and the script is simply run again (a full pass is under a minute).
#
# Usage: fantasy/bin/draft-morning        # from anywhere; paths are absolute
set -e
FANTASY="$(cd "$(dirname "$0")/.." && pwd)"
cd "$FANTASY"

step() { printf '\n=== %s\n' "$*"; }

step "1/10  draft status, from ESPN itself";        bin/ff draft
step "2/10  schedule: idle week per team";          bin/ff schedule
step "3/10  The Ringer board";                      python3 ringer_board.py
step "4/10  FantasyPros ECR (+ a seat-5 sim audit)"; python3 examiner.py --refresh
step "5/10  2025 volume + BUY/SELL flags";          python3 opportunity.py
step "6/10  value-over-replacement board";          python3 vor.py | sed -n '1,12p'
step "7/10  THE GATE: unsigned divergences"
if ! python3 signoff.py status; then
    printf '\nGATE FAILED. Sign each divergence (signoff.py keep --thesis / correct),\n'
    printf 'then run this script again so the board is rebuilt on the signatures.\n'
    exit 1
fi
step "8/10  tier sheet (draft-sheet.html)";        python3 tier_sheet.py
step "9/10  consensus judge for the post-draft grade (never read by the board)"
python3 consensus.py || printf 'WARN: consensus pull failed; grade.py --judge both will use the cached one\n'

# The 2026 draft is being run from Alex's phone at a cookout rather than off a
# printout at the desk, so the sheet has to reach the phone. iCloud Drive's root
# shows up in the Files app; the file is self-contained HTML and opens offline,
# which matters because the venue's wifi is not ours. Copy last, so the phone
# always gets the sheet the gate actually signed off on.
step "10/10 push the sheet to iCloud Drive (opens in Files on the phone)"
ICLOUD="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
if [ -d "$ICLOUD" ]; then
    cp draft-sheet.html "$ICLOUD/draft-sheet.html"
    printf 'copied -> %s/draft-sheet.html\n' "$ICLOUD"
    printf 'On the phone: Files > iCloud Drive > draft-sheet.html. Open it BEFORE\n'
    printf 'leaving, so it is cached and does not need the venue wifi.\n'
else
    printf 'WARN: no iCloud Drive dir; AirDrop fantasy/draft-sheet.html to the phone by hand\n'
fi

printf '\nAll clear. Sheet is on the phone.\n\n'
printf 'The autopilot drives (decided 2026-09-07, replacing the 09-06 stand-down).\n'
printf 'Pre-draft sequence, in order:\n'
printf '  1. cp draftbot/live-draft-url.txt draftbot/url.txt\n'
printf '  2. caffeinate -dimsu python3 draftbot/driver.py &   # Mac must not sleep\n'
printf '  3. python3 draftbot/enter.py                        # clicks/reloads in\n'
printf '  4. python3 draftbot/supervise.py 12                 # only ONCE inside\n\n'
printf 'Alex must NOT open the draft room himself: one connection per team, and\n'
printf 'a second session bumps the bot. He watches the bot window instead.\n'
printf 'Do not start supervise.py early -- a room that has not opened reads as\n'
printf '"Loading your draft", which is a hang marker, and it will loop on it.\n'
