#!/usr/bin/env python3
"""Score every bench-for-wire swap against the playbook's 20-point gate.

The playbook's *Season operations* rule: at 16 rostered there is no free spot,
so a claim is a swap and its value is `add - drop` over the rest of the
regular season, not the add's projection by itself. The gate is +20 season
points, or a bye-week hole the swap fills.

INVARIANTS
- Read-only. Never files a claim; `espn-tx claim` is the only write path.
- `season_proj` from ESPN is the STATIC PRESEASON number. Verified 2026-09-20:
  Jordyn Tyson sat on IR from 08-30 with 0.0 in weeks 1 and 2 and still
  carried a 99.9 season projection. So it is a preseason prior, never a
  rest-of-season value, and it must not be used alone.
- Position maximums are read from `espn settings`, and a candidate at a
  capped position is only offered against a drop of the same position. IR
  does not count toward the cap (verified by the 2026-09-20 add).
- The per-week rate therefore blends that stale prior with ESPN's live weekly
  projection, which does track role and matchup. Harstad's finding (in the
  /fantasy-football skill) is that a naive 50/50 blend of a preseason number
  and in-season production beats either alone.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent / "espn"
NFL_WEEKS = 17
REG_SEASON_END = 14
GATE = 20.0
IR_SLOTS = {"IR"}
STARTER_SLOTS = {"QB", "RB", "WR", "TE", "FLEX", "D/ST", "K"}


def espn(*args: str) -> object:
    out = subprocess.run(
        [str(BIN), *args, "--json"], capture_output=True, text=True, check=True
    )
    return json.loads(out.stdout)


def rate(proj: float | None, season_proj: float | None) -> float:
    """Points per remaining week: half stale preseason prior, half live weekly."""
    weekly = float(proj or 0.0)
    prior = float(season_proj or 0.0) / NFL_WEEKS
    if prior <= 0:
        return weekly
    if weekly <= 0:
        return prior
    return 0.5 * prior + 0.5 * weekly


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--gate", type=float, default=GATE)
    ap.add_argument("--top", type=int, default=3, help="candidates shown per bench spot")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    team = espn("team")
    assert isinstance(team, dict)
    week = int(team["week"])
    remaining = max(REG_SEASON_END - week, 0)

    pool = espn("fa", "--pos", "ALL", "-n", "300")
    assert isinstance(pool, list)

    settings = espn("settings")
    assert isinstance(settings, dict)
    position_max: dict[str, int] = settings.get("position_max") or {}

    roster = team["roster"]
    bench = [p for p in roster if p["slot"] == "BE"]
    starters = [p for p in roster if p["slot"] in STARTER_SLOTS]
    ir = [p for p in roster if p["slot"] in IR_SLOTS]
    # IR does not count against the position maximum: the 2026-09-20 Bateman
    # add went through with eight active WRs plus one on IR.
    held: dict[str, int] = {}
    for p in roster:
        if p["slot"] not in IR_SLOTS:
            held[p["pos"]] = held.get(p["pos"], 0) + 1

    for p in [*bench, *starters, *pool]:
        p["rate"] = rate(p.get("proj"), p.get("season_proj"))

    bench.sort(key=lambda p: p["rate"])
    results: list[dict[str, object]] = []

    def allowed(drop: dict, cand: dict) -> bool:
        """Flex-eligible and under the position maximum once the drop is gone."""
        if cand["pos"] != drop["pos"] and cand["pos"] not in {"RB", "WR", "TE"}:
            return False
        cap = position_max.get(cand["pos"])
        after = held.get(cand["pos"], 0) - (1 if cand["pos"] == drop["pos"] else 0)
        return cap is None or after < cap

    for drop in bench:
        cands = [c for c in pool if allowed(drop, c)]
        scored = [
            {
                "add": c["name"],
                "pos": c["pos"],
                "avail": c["avail"],
                "owned": round(float(c.get("owned") or 0), 1),
                "trend": round(float(c.get("trend") or 0), 1),
                "add_rate": round(c["rate"], 2),
                "gain": round((c["rate"] - drop["rate"]) * remaining, 1),
            }
            for c in cands
        ]
        scored.sort(key=lambda r: float(r["gain"]), reverse=True)
        results.append(
            {
                "drop": drop["name"],
                "pos": drop["pos"],
                "drop_rate": round(drop["rate"], 2),
                "candidates": scored[: args.top],
            }
        )

    if args.json:
        json.dump(
            {"week": week, "remaining_weeks": remaining, "gate": args.gate, "swaps": results},
            sys.stdout,
            indent=2,
        )
        return 0

    print(f"Swap scan -- week {week}, {remaining} regular-season weeks remain "
          f"(weeks {week + 1}-{REG_SEASON_END}), gate +{args.gate:g} pts")
    print(f"  rate = 0.5 x (preseason season_proj / {NFL_WEEKS}) + 0.5 x live weekly proj")
    full = [f"{pos} {held.get(pos, 0)}/{cap}" for pos, cap in position_max.items()
            if held.get(pos, 0) >= cap]
    print(f"  bench {len(bench)}, starters {len(starters)}, IR {len(ir)}, pool {len(pool)}"
          + (f"; at position max: {', '.join(full)}" if full else "") + "\n")

    best: float | None = None
    for r in results:
        print(f"  DROP {r['drop']:<22} {r['pos']:<4} rate {r['drop_rate']}/wk")
        cands = r["candidates"]
        assert isinstance(cands, list)
        for c in cands:
            gain = float(c["gain"])
            best = gain if best is None else max(best, gain)
            flag = "PASS" if gain >= args.gate else "    "
            print(f"    {flag} +{gain:>6.1f}  {c['add']:<24} {c['pos']:<4} "
                  f"{c['avail']:<3} rate {c['add_rate']:<6} own {c['owned']}% ({c['trend']:+})")
        print()

    if best is None:
        print("  no eligible swap on the board")
    else:
        print(f"  best swap on the board: {best:+.1f} vs a +{args.gate:g} gate -- "
              f"{'GATE MET' if best >= args.gate else 'gate not met, stand pat'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
