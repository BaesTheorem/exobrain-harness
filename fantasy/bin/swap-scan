#!/usr/bin/env python3
"""Score every bench-for-wire swap against the playbook's waiver gate.

The playbook's *Waivers* gate: at 16 rostered there is no free spot,
so a claim is a swap and its value is `add - drop` over the rest of the
season, not the add's projection by itself. The gate is 1.0 point a game
over that horizon (backtested 2026-10-15; it was 2.5, what +20 over 8 weeks
meant when it was set), or a bye-week hole the swap fills.

INVARIANTS
- Read-only. Never files a claim; `espn-tx claim` is the only write path.
- The currency is `espncli.value.ros_rate`, the one blend every in-season
  tool uses (half the static preseason `season_proj`, half the live number;
  `value.py` explains why `season_proj` alone is never a value).
- Position maximums are read from the league settings, and a candidate at a
  capped position is only offered against a drop of the same position. IR
  does not count toward the cap (verified by the 2026-09-20 Bateman add).
- **Never a second QB or TE** (routines/COMMON.md rule 3). Found 2026-09-20:
  the first version offered Helm and Mayer against WR drops with McBride
  rostered, and roster-watch would have bannered it. A QB or TE candidate is
  only offered against a drop at the same position (replacing the one we
  have), and the test plants exactly that case.
- Market heat (Sleeper's trending adds, last 24h, no auth) and the volume
  flags (`bin/volume`) are attached as evidence for the role condition; they
  never move the gate. A PASS is a candidate, not a verdict.
- **A drop already spent in a pending claim is not a free drop.** Found
  2026-09-20: the gate bannered Wicks-for-Noel while Noel was the drop that
  armed the whole QB waiver chain (Young and Geno both drop him, so exactly
  one lands). Filing a third claim on the same drop would have let the wire
  decide which one we got. Each swap row now carries `pending_drop`, read
  from the live pending list, and roster-watch skips those rows. Extended
  2026-09-30: a player on our side of a pending trade counts too. Godwin
  showed as a free +23.7 drop while he sat in the Allen offer, and dropping
  him would have voided it.
- **A bench K or D/ST is only offered against the same position.** Found
  2026-10-03: MIST added the Cowboys D/ST at 11:37 PM as the week 5 stream
  (dropping Vele), and 27 minutes later the gate bannered the reverse swap at
  +46.6, because a streamer's season rate is near zero next to any WR. A
  streamer is held for one week's matchup, which stream-scan prices; a season
  rate cannot see that.
- **An injured add is not a candidate.** Found 2026-10-06: the gate bannered
  Tyquan Thornton at +41.7 the day after he dislocated his ankle (surgery,
  3 to 4 months out). The rate is built from his 28-point week and cannot see
  the injury. A wire player marked OUT, IR or SUSP is skipped. A one-week OUT
  is lost with them, which costs less than a dead roster spot.
- **The horizon counts the playoff weeks at their weight (2026-10-14).**
  `season_sim.py --leverage` measured a week-16 or week-17 point at about 11
  regular-season points and week 15 at about 2, so the horizon is the
  regular-season weeks left plus `playoff_units` (24.4 then; read from
  `.cache/leverage.json` when the Tuesday run wrote it this week). Before,
  the value stopped at week 14 and the +20 gate needed 20/weeks-left a game,
  10 a game by week 12, so the scan would have gone silent in exactly the
  weeks the playoff roster is built. The gate is now per game, so its bar
  does not move as the season shortens.
- **A backup QB or TE is priced on the weeks he starts, not the weeks left.**
  Found 2026-10-11: the gate bannered Rodgers for Deshaun Watson at +20.6
  (2.3 a week x 9 weeks), but a bench QB behind a healthy starter only
  scores in the starter's bye weeks plus an allowance for an injury, about
  two weeks here, so the real gain was about +5. When the drop is a bench
  player at a one-of position whose starter is rostered, the multiplier is
  the starter's remaining byes plus his measured chance of missing time
  (BACKUP_START_REG a regular week, BACKUP_START_PO of the playoff units),
  capped at the horizon; the whole gap is priced on those weeks.

    swap-scan [--gate 20] [--top 3] [--json]
"""

from __future__ import annotations

import argparse
import json
import sys
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
FANTASY = HERE.parent
sys.path.insert(0, str(FANTASY))

from espncli.cli import pool_rows, roster_rows  # noqa: E402
from espncli.client import BENCH, IR, Espn, norm  # noqa: E402
from espncli.value import games_appeared, games_played, ros_rate  # noqa: E402

REG_SEASON_END = 14
# The rate gap a swap must clear, per game. Backtested 2026-10-15 (research/
# rule_backtests.py gate, weeks 3-11 of 2022-2025, the new ros_rate blend):
# the realized gain is positive on average for every predicted gap above 0.5
# a game, and at a move cost of 1 point a game the best gate is 1.0 (95% CI
# 0.25 to 1.5), which keeps 85% or more of the best net gain under every prior
# proxy and cost tested; 2.5 kept 46-97%. A gate of 3.4 would make the
# predicted sign right 80% of the time; the gate is for points, so it is 1.0.
GATE_PER_GAME = 1.0
PLAYOFF_UNITS = 24.4                  # weeks 15-17 in regular-week units (2.0 + 10.7 + 11.7, --leverage 2026-10-14)
LEVERAGE_CACHE = FANTASY / ".cache" / "leverage.json"
LEVERAGE_MAX_AGE = 8 * 86400          # older than a Tuesday cycle: fall back to PLAYOFF_UNITS
ONE_OF = {"QB", "TE"}                 # never a second one on the roster
FLEX_POS = {"RB", "WR", "TE"}
STREAM_POS = {"K", "D/ST"}            # weekly streamers: stream-scan prices them, not a season rate
UNAVAILABLE = {"OUT", "IR", "SUSP"}    # wire injury tags: the rate cannot see the absence
# A top-13 QB or TE starter misses 13% of his games from week 6 on (2016-2025),
# and more in the playoff weeks (QB 16%, 16%, 29% in weeks 15-17), so a bench
# QB/TE gets this share of each regular week and of the playoff units on top of
# the starter's byes (backtest R77, 2026-10-15; the flat 1 week was right only
# in plain games at weeks 6-8).
BACKUP_START_REG, BACKUP_START_PO = 0.10, 0.17
LOOKAHEAD = 2                         # weeks of bye holes to show
VOLUME = FANTASY / ".cache" / "volume-{season}.json"
SLEEPER_TRENDING = "https://api.sleeper.app/v1/players/nfl/trending/add?lookback_hours=24&limit=150"
SLEEPER_PROJ = "https://api.sleeper.app/projections/nfl/{season}/{week}?season_type=regular&position[]=QB&position[]=RB&position[]=WR&position[]=TE"


def fetch_json(url: str) -> object:
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"}), timeout=20) as r:
        return json.load(r)


def sleeper_heat(season: int, week: int) -> dict[str, int]:
    """norm(name)|POS -> adds in the last 24 hours across Sleeper leagues.
    The national market's wire, hours ahead of ESPN's 7-day ownership trend.
    Any failure returns {} and the scan says so; heat is evidence, not input."""
    try:
        trending = fetch_json(SLEEPER_TRENDING)
        rows = fetch_json(SLEEPER_PROJ.format(season=season, week=week))
    except Exception:
        return {}
    names = {}
    for r in rows if isinstance(rows, list) else []:
        p = r.get("player") or {}
        pid = str(r.get("player_id") or p.get("player_id") or "")
        if pid:
            names[pid] = f"{norm(p.get('first_name', '') + ' ' + p.get('last_name', ''))}|{p.get('position')}"
    out: dict[str, int] = {}
    for t in trending if isinstance(trending, list) else []:
        k = names.get(str(t.get("player_id")))
        if k:
            out[k] = int(t.get("count") or 0)
    return out


def load_volume(season: int) -> dict[str, dict]:
    try:
        return json.loads(Path(str(VOLUME).format(season=season)).read_text())["players"]
    except (OSError, ValueError, KeyError):
        return {}


def vkey(r: dict) -> str:
    return f"{norm(r['name'])}|{r['pos']}"


def allowed(cand: dict, drop: dict, held: dict[str, int], position_max: dict[str, int]) -> bool:
    """Flex-eligible or same position, never a second QB/TE, under the cap once the drop is gone."""
    if cand["pos"] != drop["pos"]:
        if drop["pos"] in STREAM_POS or cand["pos"] not in FLEX_POS or cand["pos"] in ONE_OF:
            return False
    cap = position_max.get(cand["pos"])
    after = held.get(cand["pos"], 0) - (1 if cand["pos"] == drop["pos"] else 0)
    return cap is None or after < cap


def scan(week: int, roster: list[dict], pool: list[dict], position_max: dict[str, int],
         games: dict[str, int] | None = None, heat: dict[str, int] | None = None,
         volume: dict[str, dict] | None = None, gate_per_game: float = GATE_PER_GAME, top: int = 3,
         committed: set[str] | None = None, backup_weeks: dict[str, int] | None = None,
         playoff_units: float = PLAYOFF_UNITS) -> dict:
    """Pure: rows in, ranked swaps out. `games` is pro-team abbrev -> games played;
    `committed` is the normalized names already listed as a DROP in a pending claim;
    `backup_weeks` is position -> the starter's bye weeks left; the injury
    share (BACKUP_START_REG, BACKUP_START_PO) is added here, in horizon units.
    The whole gap is priced on the drop's weeks. (2026-10-15: pricing the add
    on the full horizon against a backup QB's few starts valued dropping the
    approved QB bridge for a bench WR at +200 the same hour; a bench add does
    not play every week either, so the symmetric gap stays.)"""
    games, heat, volume = games or {}, heat or {}, volume or {}
    committed = committed or set()
    remaining = max(REG_SEASON_END - week, 0)
    horizon = round(remaining + playoff_units, 1)
    bench = [p for p in roster if p["slotId"] == BENCH]
    held: dict[str, int] = {}
    for p in roster:
        if p["slotId"] != IR:
            held[p["pos"]] = held.get(p["pos"], 0) + 1
    appeared = games_appeared(volume, week)
    for p in [*roster, *pool]:
        p["rate"] = ros_rate(week, p.get("proj"), p.get("season_proj"), p.get("season_actual"),
                             games.get(p.get("team") or ""), appeared.get(vkey(p)))
    bench.sort(key=lambda p: p["rate"])
    starting = {p["pos"] for p in roster if p["slotId"] not in (BENCH, IR)}
    backup_weeks = backup_weeks or {}

    def weeks_for(pos: str) -> float:
        if pos in ONE_OF and pos in starting:
            return round(min(horizon, backup_weeks.get(pos, 0) + BACKUP_START_REG * remaining
                             + BACKUP_START_PO * playoff_units), 1)
        return horizon

    results = []
    for drop in bench:
        weeks = weeks_for(drop["pos"])
        scored = []
        for c in pool:
            if c.get("status") in UNAVAILABLE or not allowed(c, drop, held, position_max):
                continue
            v = volume.get(vkey(c)) or {}
            flags = v.get("flags") or []
            scored.append({
                "add": c["name"], "pos": c["pos"], "avail": c["avail"], "team": c.get("team"),
                "owned": round(float(c.get("owned") or 0), 1), "trend": round(float(c.get("trend") or 0), 1),
                "add_rate": round(c["rate"], 2), "gain": round((c["rate"] - drop["rate"]) * weeks, 1),
                "heat": heat.get(vkey(c), 0), "flags": flags,
                "role": bool({"BUY", "ROLE-UP"} & set(flags)),
                "snap": (v.get("last") or {}).get("snap"), "tgt_share": (v.get("last") or {}).get("tgt_share"),
                "opps": (v.get("last") or {}).get("opps"),
            })
        scored.sort(key=lambda r: -r["gain"])
        results.append({"drop": drop["name"], "pos": drop["pos"], "drop_rate": round(drop["rate"], 2),
                        "drop_flags": (volume.get(vkey(drop)) or {}).get("flags") or [],
                        "pending_drop": norm(drop["name"]) in committed, "weeks": weeks,
                        "candidates": scored[:top]})
    return {"week": week, "remaining_weeks": remaining, "playoff_units": playoff_units,
            "horizon": horizon, "gate_per_game": gate_per_game,
            "gate": round(gate_per_game * horizon, 1), "held": held,
            "position_max": position_max, "swaps": results}


def bye_holes(api: Espn, roster: list[dict], week: int, weeks: int = LOOKAHEAD) -> list[dict]:
    """Starters on bye in the next `weeks` weeks, with the bench cover for each slot."""
    out = []
    starters = [r for r in roster if r["slotId"] not in (BENCH, IR)]
    bench = [r for r in roster if r["slotId"] == BENCH]
    for w in range(week + 1, min(week + weeks, REG_SEASON_END) + 1):
        for s in starters:
            if api.opponent(api_team_id(api, s), w) != "BYE":
                continue
            cover = [b for b in bench if s["slotId"] in b["eligible"] and api.opponent(api_team_id(api, b), w) != "BYE"
                     and b["status"] not in ("OUT", "IR", "SUSP")]
            cover.sort(key=lambda b: -b["rate"])
            out.append({"week": w, "slot": s["slot"], "player": s["name"], "pos": s["pos"],
                        "cover": [{"name": b["name"], "pos": b["pos"], "rate": round(b["rate"], 1)} for b in cover[:2]]})
    return out


def backup_weeks(api: Espn, roster: list[dict], week: int) -> dict[str, int]:
    """Per one-of position: the starter's bye weeks left (the injury share is added in scan)."""
    out = {}
    for s in roster:
        if s["pos"] in ONE_OF and s["slotId"] not in (BENCH, IR):
            byes = sum(api.opponent(api_team_id(api, s), w) == "BYE" for w in range(week + 1, REG_SEASON_END + 1))
            out[s["pos"]] = byes
    return out


def committed_ids(txs: list[dict], me: int) -> list[int]:
    """Player ids of ours already promised away: a claim's DROP or a trade's outgoing side.

    Trade items are type TRADE with `fromTeamId` us, in either direction
    (our offer out, or an offer in that we could accept).
    """
    return [i["playerId"] for t in txs for i in (t.get("items") or [])
            if i.get("playerId") and i.get("fromTeamId") == me
            and ((t.get("type") == "WAIVER" and i.get("type") == "DROP") or i.get("type") == "TRADE")]


def pending_drops(api: Espn) -> set[str]:
    """Normalized names of our players already listed as a DROP in a pending claim,
    or on our side of a pending trade (a drop voids the trade).

    Never raises: an unreadable pending list must not stop the scan, but it
    must not read as "nothing committed" either, so the miss is printed.
    """
    try:
        ids = committed_ids(api.pending_transactions(), int(api.creds["team_id"]))
        names = api.names_for([i for i in ids if i])
        return {norm(n) for n in names.values()}
    except Exception as exc:  # noqa: BLE001 - the scan runs without it, loudly
        print(f"pending list unreadable ({exc}); pending_drop is unmarked this run", file=sys.stderr)
        return set()


def playoff_units_cached(path: Path = LEVERAGE_CACHE, now: float | None = None) -> float:
    """Weeks 15-17 in regular-week units from the last `season_sim.py --leverage`
    run, or PLAYOFF_UNITS when there is none from this Tuesday cycle."""
    import time  # noqa: PLC0415
    try:
        if (now or time.time()) - path.stat().st_mtime > LEVERAGE_MAX_AGE:
            return PLAYOFF_UNITS
        weight = json.loads(path.read_text()).get("weight") or {}
        units = sum(float(v) for k, v in weight.items() if int(k) > REG_SEASON_END and v is not None)
        return units if units > 0 else PLAYOFF_UNITS
    except (OSError, ValueError, TypeError):
        return PLAYOFF_UNITS


def api_team_id(api: Espn, r: dict) -> int | None:
    for tid, t in api.pro_teams().items():
        if t["abbrev"] == r["team"]:
            return tid
    return None


def render(out: dict, holes: list[dict], heat_ok: bool, volume_ok: bool) -> int:
    week, remaining, gate, horizon = out["week"], out["remaining_weeks"], out["gate"], out["horizon"]
    print(f"Swap scan -- week {week}, {remaining} regular-season weeks remain (weeks {week + 1}-{REG_SEASON_END}) "
          f"+ weeks 15-17 at {out['playoff_units']:.1f} regular-week units = horizon {horizon:g}; "
          f"gate +{gate:g} pts ({out['gate_per_game']:g} a game)")
    print("  rate = ros_rate: before week 5 half ESPN rest-of-season proj per game left, half weekly proj; "
          "from week 5 0.45 weekly proj + 0.35 that prior + 0.20 PPG over games played")
    full = [f"{pos} {out['held'].get(pos, 0)}/{cap}" for pos, cap in out["position_max"].items()
            if out["held"].get(pos, 0) >= cap]
    print(f"  never a second QB or TE; at position max: {', '.join(full) or 'none'}"
          + ("" if heat_ok else "; Sleeper heat unavailable") + ("" if volume_ok else "; no volume cache (run bin/volume build)") + "\n")
    best = None
    for r in out["swaps"]:
        dflags = f"  [{' '.join(r['drop_flags'])}]" if r["drop_flags"] else ""
        spent = "  PENDING DROP: already spent in a claim or trade, not a free drop" if r.get("pending_drop") else ""
        backup = f"  BACKUP: priced on {r['weeks']} start(s), not {horizon:g}" if r["weeks"] != horizon else ""
        print(f"  DROP {r['drop']:<22} {r['pos']:<4} rate {r['drop_rate']}/wk{dflags}{spent}{backup}")
        for c in r["candidates"]:
            gain = float(c["gain"])
            best = gain if best is None else max(best, gain)
            flag = "PASS" if gain >= gate else ("ROLE" if c["role"] else "    ")
            role = f"  snap {100 * c['snap']:.0f}% tgt {100 * c['tgt_share']:.0f}%" if c.get("snap") is not None and c.get("tgt_share") is not None else ""
            print(f"    {flag} +{gain:>6.1f}  {c['add']:<24} {c['pos']:<4} {c['avail']:<3} rate {c['add_rate']:<6} "
                  f"own {c['owned']}% ({c['trend']:+})  heat {c['heat']:>6}{role}  {' '.join(c['flags'])}")
        print()
    if best is None:
        print("  no eligible swap on the board")
    else:
        print(f"  best swap on the board: {best:+.1f} vs a +{gate:g} gate -- "
              f"{'GATE MET' if best >= gate else 'gate not met, stand pat'}")
    print("  ROLE = the add carries a volume signal (BUY or ROLE-UP) the projection may not price yet: the gate's"
          "\n  second condition, which is read by hand. heat = Sleeper adds in the last 24 hours, the national wire.")
    if holes:
        print(f"\n  bye holes in the next {LOOKAHEAD} weeks (claim the Tuesday before; Wednesdays are contested):")
        for h in holes:
            cover = ", ".join(f"{c['name']} ({c['rate']}/wk)" for c in h["cover"]) or "NO BENCH COVER"
            print(f"    week {h['week']}  {h['slot']:<5} {h['player']:<22} -> {cover}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--gate-per-game", type=float, default=GATE_PER_GAME,
                    help="rate gap a swap must clear, points a game (default %(default)s)")
    ap.add_argument("--playoff-units", type=float, default=None,
                    help="weeks 15-17 in regular-week units (default: .cache/leverage.json if fresh, else %s)" % PLAYOFF_UNITS)
    ap.add_argument("--top", type=int, default=3, help="candidates shown per bench spot")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    api = Espn()
    data = api.league("mTeam", "mRoster", "mSettings", "mStatus")
    week = api.current_week(data)
    t = api.resolve_team(data, None)
    roster = roster_rows(api, api.roster_entries(data, t["id"]), week)
    pool = pool_rows(api, week, "ALL", 300, ["FREEAGENT", "WAIVERS"])
    rs = data["settings"]["rosterSettings"]
    from espncli.client import POS  # noqa: PLC0415
    position_max = {POS[int(k)]: v for k, v in (rs.get("positionLimits") or {}).items() if int(k) in POS and v not in (-1, None)}
    games = {pt["abbrev"]: games_played(pt["games"], week) for pt in api.pro_teams().values()}
    heat = sleeper_heat(api.season, week)
    volume = load_volume(api.season)
    units = args.playoff_units if args.playoff_units is not None else playoff_units_cached()
    out = scan(week, roster, pool, position_max, games, heat, volume, args.gate_per_game, args.top,
               committed=pending_drops(api), backup_weeks=backup_weeks(api, roster, week),
               playoff_units=units)
    holes = bye_holes(api, roster, week)
    out["bye_holes"] = holes
    if args.json:
        json.dump(out, sys.stdout, indent=2, default=str)
        return 0
    return render(out, holes, bool(heat), bool(volume))


if __name__ == "__main__":
    sys.exit(main())
