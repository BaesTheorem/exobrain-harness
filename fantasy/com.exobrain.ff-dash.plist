<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.exobrain.ff-dash</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alexhedtke/.local/bin/mist-launch</string>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Users/alexhedtke/Documents/Exobrain harness/fantasy/bin/ff-dash</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/alexhedtke/Documents/Exobrain harness/fantasy</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/ff-dash.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alexhedtke/Library/Logs/exobrain/ff-dash-error.log</string>
	<!-- Login Items shows the job under this app instead of its executable's name;
	     only honored because mist-launch is signed by the same team. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
	    <string>com.exobrain.mist-console</string>
	</array>
</dict>
</plist>
