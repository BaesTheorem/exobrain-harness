<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mist.routine.fantasy-lineup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alexhedtke/.local/bin/mist-launch</string>
		<string>/bin/bash</string>
		<string>/Users/alexhedtke/Documents/Exobrain harness/fantasy/bin/routine-guard</string>
		<string>*</string>
		<string>fantasy-lineup</string>
		<string>17:30</string>
		<string>23:30</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/alexhedtke/Library/Logs/mist-routines.log</string>
	<key>StandardOutPath</key>
	<string>/Users/alexhedtke/Library/Logs/mist-routines.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>17</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>19</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>22</integer>
			<key>Minute</key>
			<integer>5</integer>
		</dict>
	</array>
	<!-- Login Items shows the job under this app instead of its executable's name;
	     only honored because mist-launch is signed by the same team. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
	    <string>com.exobrain.mist-console</string>
	</array>
</dict>
</plist>
