#!/bin/bash
# Speak text in MIST's voice. Uses the resident service if up (fast), else
# falls back to the cold-start CLI. Plays through speakers by default.
#   mist-say "Good morning, Alex."
#   mist-say --no-play "save only" -o /tmp/x.wav
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${MIST_PORT:-8087}"
PLAY=1; OUT="$DIR/out.wav"; TEXT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-play) PLAY=0; shift;;
    -o) OUT="$2"; shift 2;;
    *) TEXT="$1"; shift;;
  esac
done
[ -z "$TEXT" ] && { echo "usage: mist-say [\"text\"] [-o out.wav] [--no-play]"; exit 1; }

if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  curl -sf -X POST "http://127.0.0.1:$PORT/say" \
    -H 'Content-Type: application/json' \
    -d "$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1]}))' "$TEXT")" \
    -o "$OUT"
else
  echo "[mist-say] service not running; cold start (slow). Tip: run scripts/serve.py" >&2
  "$DIR/.venv/bin/python" "$DIR/scripts/say.py" "$TEXT" -o "$OUT" >/dev/null
fi
[ "$PLAY" = 1 ] && afplay "$OUT"
echo "$OUT"
