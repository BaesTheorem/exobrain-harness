#!/bin/bash
# Show a CLICKABLE macOS notification. Silent by default; pass --voice to also
# speak it in MIST's voice.
#   mist-notify "Inbox is over five. Want me to triage it?"
#   mist-notify "Build failed." "Exobrain URGENT" Basso
#   mist-notify "New transcript processed" "MIST" Purr "obsidian://open?vault=Exobrain&file=Daily%20notes/..."
#   mist-notify "Restock is live" "Gatorade watch" Purr "https://prod.example/item" \
#       --image /tmp/product.png --action "Buy now=https://prod.example/item/buy" --group watchers
#   mist-notify "Want me to triage the inbox?" "MIST" Purr "console:i_abc123" --reply
#
# Positional args (all optional after the message):
#   1 message   2 title (MIST)   3 sound (Purr; "none" = silent)   4 link
# A banner click always lands in a MIST Console chat (Alex, 2026-09-30):
#   - fired from inside a Console chat ($MIST_CONSOLE_SESSION set): that chat,
#     because it already holds the context ("console:<sid>");
#   - fired headless (a watcher, launchd, a routine): a NEW chat that the
#     Console opens on the click, seeded with the full notification text, the
#     surrounding context (--context / --context-file / $MIST_NOTIFY_CONTEXT)
#     and the line "Alex wants to chat about this", so MIST answers with the
#     alert in front of her ("console:notif.<id>"). A chat is only created when
#     the banner is tapped; an ignored banner costs nothing.
# The 4th arg is the notification's SOURCE link. It is validated (web URLs,
# Obsidian and Things links that only navigate, the Console, folders, app
# bundles and plain files pass; file://, other schemes, executables, scripts and
# Obsidian URIs that run a command are dropped and noted in the history line)
# and becomes an "Open link" button on the banner and the chat's seed, not the
# click. Pass --direct to make the source link the click target instead, for
# the rare banner where opening the source is better than a chat (a payment
# page, a booking that expires). Never build a "cmd:" target from third-party
# text.
#   - "console"        -> the routing above (this chat, else a seeded new chat)
#   - "console:<sid>"  -> that chat
#   - "console!"       -> the Console's current chat, no upgrade (a banner about the Console itself)
#   - a URL/scheme  (https://, http://localhost:5014, obsidian://, things:///...)  -> "Open link" button
#   - a file path or app name                                                      -> "Open" button
#   - omitted                                                                      -> same as "console"
#
# Full-featured flags (delivered by MIST Notifier.app; silently dropped when
# only the terminal-notifier fallback is available):
#   --subtitle "text"        smaller second line under the title
#   --image /path.png        thumbnail attachment on the banner
#   --reply [sid]            inline "Reply" button; the typed text is injected into
#                            the Console chat <sid> (default: the link's console:<sid>,
#                            else the active chat). Works with the Console closed;
#                            the helper boots it and retries.
#   --action "Label=target"  extra button (up to 3). target uses link semantics,
#                            plus "cmd:<shell>" to run a command.
#   --group <id>             notification-center stacking group (threadIdentifier)
#   --id <id>                stable identifier: reposting replaces the banner in place
#   --urgency passive|active|timeSensitive
#   --context "text"         surrounding context for the seeded chat (what the
#                            caller knows: the state that fired, the log line,
#                            the numbers). Capped at 4000 chars. Default:
#                            $MIST_NOTIFY_CONTEXT (run-routine.sh sets it).
#   --context-file <path>    same, read from a file (its last 4000 chars)
#   --direct                 the source link is the click target (see above)
#   --dry-run                print the composed spec JSON and exit without delivering
#   --voice                  ALSO speak the message aloud. Off by default:
#                            watchers fire unattended and a banner should not
#                            make noise in a room Alex may not be in.
#   --no-voice               accepted and ignored (voice is already off).
#                            Kept so existing callers do not break.
#
# Delivery order: MIST Notifier.app (native banners: MIST name + icon, buttons,
# reply, images) -> terminal-notifier -> osascript. Every banner is clickable and
# lands on the app/source it came from. Each notification is appended to
# ~/Library/Logs/exobrain/notifications-history.jsonl (the Console's bell panel
# reads it).
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
MSG="${1:?usage: mist-notify \"message\" [title] [sound] [link] [--flags]}"
shift

TITLE="MIST"; SOUND="Purr"; LINK=""
SUBTITLE=""; IMAGE=""; GROUP=""; NID=""; URGENCY=""
REPLY=0; REPLY_SID=""; VOICE=0; DRY=0; DIRECT=0
CONTEXT="${MIST_NOTIFY_CONTEXT:-}"
ACTIONS=()
POSN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)  DRY=1; shift;;
    --direct)   DIRECT=1; shift;;
    --context)  CONTEXT="${2:-}"; shift 2;;
    --context-file)
      CONTEXT="$(tail -c 4000 "${2:-/dev/null}" 2>/dev/null || true)"; shift 2;;
    --subtitle) SUBTITLE="${2:-}"; shift 2;;
    --image)    IMAGE="${2:-}"; shift 2;;
    --group)    GROUP="${2:-}"; shift 2;;
    --id)       NID="${2:-}"; shift 2;;
    --urgency)  URGENCY="${2:-}"; shift 2;;
    --action)   ACTIONS+=("${2:-}"); shift 2;;
    --voice)    VOICE=1; shift;;
    --no-voice) VOICE=0; shift;;
    --reply)
      REPLY=1
      if [ $# -gt 1 ] && [[ "${2:-}" != --* ]]; then REPLY_SID="$2"; shift; fi
      shift;;
    *)
      case $POSN in
        0) TITLE="$1";;
        1) SOUND="$1";;
        2) LINK="$1";;
      esac
      POSN=$((POSN+1)); shift;;
  esac
done

# Routing (see the header). Every shell a Console chat spawns carries
# $MIST_CONSOLE_SESSION, so from inside a chat the click lands there. Headless
# callers get "console:notif.<id>": the Console's /focus route opens a chat
# seeded from this notification's history line when the banner is tapped.
# /focus no-ops if a sid is gone, so a stale env var degrades to a plain raise.
# The caller's own link (a URL, a note, a folder) moves to a button unless
# --direct. "console!" keeps the Console's current chat, no upgrade.
NOTIF_ID="$(date +%s)-$$-$RANDOM"
SOURCE=""
case "$LINK" in
  "console!") LINK="console";;
  ""|console)
    if [ -n "${MIST_CONSOLE_SESSION:-}" ]; then LINK="console:$MIST_CONSOLE_SESSION"
    else LINK="console:notif.$NOTIF_ID"; fi;;
  console:*) ;;
  *)
    if [ "$DIRECT" = "1" ]; then :
    else
      SOURCE="$LINK"
      if [ -n "${MIST_CONSOLE_SESSION:-}" ]; then LINK="console:$MIST_CONSOLE_SESSION"
      else LINK="console:notif.$NOTIF_ID"; fi
    fi;;
esac

CONSOLE_BUNDLE="com.exobrain.mist-console"
CONSOLE_PORT="5014"
HELPER="/Applications/MIST Notifier.app"
HISTORY="$HOME/Library/Logs/exobrain/notifications-history.jsonl"

# Compose the spec + history line in python so nothing needs shell-escaping.
SPEC="$(MSG="$MSG" TITLE="$TITLE" SOUND="$SOUND" LINK="$LINK" SUBTITLE="$SUBTITLE" \
        IMAGE="$IMAGE" GROUP="$GROUP" NID="$NID" URGENCY="$URGENCY" REPLY="$REPLY" \
        REPLY_SID="$REPLY_SID" ACTIONS="$(IFS=$'\x1f'; echo "${ACTIONS[*]:-}")" \
        NOTIF_ID="$NOTIF_ID" SOURCE="$SOURCE" CONTEXT="$CONTEXT" \
        ORIGIN="${MIST_NOTIFY_SOURCE:-}" \
        python3 - <<'PY'
import json, os, re, sys
e = os.environ.get

# A click target is executed by `open`, so a target that came from third-party
# text (a forum post's URL, a mail's link, a message) must not be able to run
# anything. Allowed: the Console, web URLs, Obsidian and Things links that only
# navigate, folders and app bundles, and plain non-executable files. Rejected
# targets fall back to the Console and are recorded in the history line, so
# the banner still lands and the rejection is visible.
BAD_EXT = {".command", ".sh", ".bash", ".zsh", ".py", ".rb", ".pl", ".scpt", ".applescript",
           ".terminal", ".workflow", ".action", ".jar", ".pkg", ".dmg", ".app", ".js", ".mjs"}
def link_ok(link):
    if link in ("", "console", "console!") or re.fullmatch(r"console:[A-Za-z0-9_.-]+", link):
        return True, ""
    low = link.lower()
    if low.startswith(("https://", "http://")):
        return True, ""
    if low.startswith("obsidian://"):
        if "commandid=" in low or "eval=" in low or "clipboard=" in low:
            return False, "obsidian URI that runs a command"
        return True, ""
    if low.startswith("things:///"):
        if low.startswith(("things:///show", "things:///search")):
            return True, ""
        return False, "things URI that writes"
    if "://" in link or ":" in link.split("/")[0]:
        return False, "scheme not allowed"
    p = os.path.expanduser(link)
    if os.path.isdir(p):
        return True, ""            # folders and .app bundles (open launches the app)
    if os.path.isfile(p):
        ext = os.path.splitext(p)[1].lower()
        if ext in BAD_EXT or os.access(p, os.X_OK):
            return False, "executable file"
        return True, ""
    if "/" not in link and any(os.path.isdir(os.path.expanduser(d) + "/" + link + ".app")
                               for d in ("/Applications", "~/Applications", "/System/Applications")):
        return True, ""            # bare app name
    return False, "not an existing file, folder, app or allowed URL"

rejected = []
link = e("LINK") or ""
ok, why = link_ok(link)
if not ok:
    rejected.append({"link": link, "why": why})
    link = "console"
# nid: the handle the Console uses to find this line in the history when the
# banner is tapped ("console:notif.<nid>"). Every notification carries one so
# the bell panel can reopen any of them as a chat later.
spec = {"title": e("TITLE"), "body": e("MSG"), "sound": e("SOUND") or "default",
        "link": link, "nid": e("NOTIF_ID")}
source = e("SOURCE") or ""
if source:
    ok, why = link_ok(source)
    if ok:
        spec["source"] = source
    else:
        rejected.append({"link": source, "why": why})
        source = ""
ctx = (e("CONTEXT") or "").strip()
if ctx:
    spec["context"] = ctx[-4000:]
if e("ORIGIN"):
    spec["origin"] = e("ORIGIN")
for k, env in (("subtitle", "SUBTITLE"), ("image", "IMAGE"), ("group", "GROUP"),
               ("id", "NID"), ("urgency", "URGENCY")):
    if e(env):
        spec[k] = e(env)
if e("REPLY") == "1":
    spec["reply"] = {"sid": e("REPLY_SID") or None}
acts = []
for a in (e("ACTIONS") or "").split("\x1f"):
    if a and "=" in a:
        label, target = a.split("=", 1)
        # "cmd:<shell>" is a caller-authored command and stays; it must never be
        # built from third-party text (see security/README.md). Everything else
        # is a link and gets the same check as the click target.
        if not target.startswith("cmd:"):
            ok, why = link_ok(target)
            if not ok:
                rejected.append({"action": label, "target": target, "why": why})
                continue
        acts.append({"label": label, "target": target})
# The source link rides along as a button, after the caller's own buttons and
# only if one of them does not already open it. Three is the banner's limit.
if source and len(acts) < 3 and all(a["target"] != source for a in acts):
    low = source.lower()
    label = ("Open note" if low.startswith("obsidian://")
             else "Open in Things" if low.startswith("things:///")
             else "Open link" if "://" in source
             else "Open")
    acts.append({"label": label, "target": source})
if acts:
    spec["actions"] = acts[:3]
if rejected:
    spec["rejected"] = rejected
    for r in rejected:
        print(f"mist-notify: rejected click target {r.get('link') or r.get('target')!r}: {r['why']}",
              file=sys.stderr)
print(json.dumps(spec))
PY
)"

if [ "$DRY" = "1" ]; then
  printf '%s\n' "$SPEC"
  exit 0
fi

log_history() {  # $1 = delivery route
  ( mkdir -p "$(dirname "$HISTORY")"
    VIA="$1" SPEC="$SPEC" python3 - <<'PY' >> "$HISTORY"
import json, os, time
spec = json.loads(os.environ["SPEC"])
spec["ts"] = time.time()
spec["via"] = os.environ["VIA"]
print(json.dumps(spec))
PY
  ) 2>/dev/null || true
}

DELIVERED=""
if [ -d "$HELPER" ]; then
  SPECF="$(mktemp /tmp/mist-notify.XXXXXX)"
  printf '%s' "$SPEC" > "$SPECF"
  if open -n -a "$HELPER" --args post "$SPECF" 2>/dev/null; then
    # The helper writes $SPECF.result; give it a few seconds. "ok" means the
    # banner is out; "pending"/"denied" (permission) or a timeout falls back.
    for _ in $(seq 1 50); do
      [ -f "$SPECF.result" ] && break
      sleep 0.1
    done
    if grep -q '"ok": *true' "$SPECF.result" 2>/dev/null; then
      DELIVERED="notifier"
    fi
  fi
  rm -f "$SPECF" "$SPECF.result" 2>/dev/null || true
fi

if [ -z "$DELIVERED" ] && command -v terminal-notifier >/dev/null 2>&1; then
  args=(-title "$TITLE" -message "$MSG")
  [ -n "$SUBTITLE" ] && args+=(-subtitle "$SUBTITLE")
  case "$SOUND" in none|silent|"") ;; *) args+=(-sound "$SOUND");; esac
  if [ -z "$LINK" ] || [ "$LINK" = "console" ]; then
    # Raise the Console to its current chat.
    args+=(-execute "open -b $CONSOLE_BUNDLE")
  elif [[ "$LINK" == console:* ]]; then
    # Tell the Console which chat to surface, then raise it. The /focus call
    # no-ops harmlessly if the Console isn't running or the sid is unknown.
    SID="${LINK#console:}"
    args+=(-execute "curl -s \"http://localhost:$CONSOLE_PORT/focus?sid=$SID\" >/dev/null 2>&1; open -b $CONSOLE_BUNDLE")
  elif [[ "$LINK" == *"://"* ]]; then
    args+=(-open "$LINK")
  else
    args+=(-execute "open $(printf '%q' "$LINK")")
  fi
  terminal-notifier "${args[@]}" >/dev/null 2>&1 && DELIVERED="terminal-notifier" || true
fi

if [ -z "$DELIVERED" ]; then
  # Last resort: osascript banners can't carry a click action, so the link is
  # best-effort lost here, but the notification still fires.
  osascript -e "display notification \"${MSG//\"/\\\"}\" with title \"${TITLE//\"/\\\"}\" sound name \"$SOUND\"" \
    && DELIVERED="osascript" || DELIVERED="failed"
fi

log_history "$DELIVERED"

# Speaking is opt-in via --voice (non-blocking so it doesn't hold up the
# caller). It used to be the default, which meant every scheduled watcher read
# itself aloud whether or not anyone was there to hear it; Alex turned that off
# on 2026-08-23. The banner is the notification, the voice is a garnish.
#
# The global mute still applies on top and covers mist-say too:
#   touch ~/.mist-voice-muted        (or)   export MIST_VOICE_MUTED=1
# Un-mute: rm ~/.mist-voice-muted . The clickable banner always fires either
# way; only the spoken line is affected.
if [ "$VOICE" = "1" ] && [ ! -f "$HOME/.mist-voice-muted" ] && [ "${MIST_VOICE_MUTED:-0}" != "1" ]; then
  ( "$DIR/bin/mist-say" "$MSG" >/dev/null 2>&1 || true ) &
fi
