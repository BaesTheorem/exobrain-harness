#!/bin/bash
# Thin launcher for the kcurbex CLI.
#
# This lives behind a wrapper because the repo path contains a space ("Exobrain
# harness") and a #! line cannot express one -- a direct shebang at the venv python
# resolves to "/Users/alexhedtke/Documents/Exobrain" and dies with "bad interpreter".
# /bin/bash rather than /bin/sh on purpose: under launchd, /bin/sh cannot read scripts
# out of ~/Documents and exits 126.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$HERE/.venv/bin/python" "$HERE/kcurbexcli/cli.py" "$@"
