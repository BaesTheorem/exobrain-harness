{
  "permissions": {
    "_comment_mcp_hosted": "Hosted Claude.com connectors in the allow list below: mcp__claude_ai_Google_Calendar__* = Google Calendar, mcp__claude_ai_Gmail__* = Gmail, mcp__claude_ai_Google_Drive__* = Google Drive, mcp__claude_ai_MyChart__* = MyChart/Epic. See .claude/skills/calendar/SKILL.md and .claude/skills/email/SKILL.md for the live mappings. mcp__things3/fitbit/withings__* are local servers from .mcp.json; mcp__plaud/linkedin__* are local servers from user-level ~/.claude.json.",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(osascript*)",
      "Bash(ls*)",
      "Bash(python3*)",
      "Bash(mkdir*)",
      "Bash(cat*)",
      "Bash(date*)",
      "Bash(chmod*)",
      "Bash(launchctl*)",
      "Bash(npx*)",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_MyChart__*",
      "mcp__things3__*",
      "mcp__fitbit__*",
      "mcp__withings__*",
      "mcp__plaud__*",
      "mcp__linkedin__*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/post-edit-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/now.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
