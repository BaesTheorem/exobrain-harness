{
  "permissions": {
    "_comment_mcp_hosted": "Hosted Claude.com connectors in the allow list below: mcp__claude_ai_Google_Calendar__* = Google Calendar, mcp__claude_ai_Gmail__* = Gmail, mcp__claude_ai_Google_Drive__* = Google Drive. See .claude/skills/calendar/SKILL.md and .claude/skills/email/SKILL.md for the live mappings.",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(osascript*)",
      "Bash(ls*)",
      "Bash(python3*)",
      "Bash(mkdir*)",
      "Bash(cat*)",
      "Bash(date*)",
      "Bash(chmod*)",
      "Bash(launchctl*)",
      "Bash(npx*)",
      "mcp__scheduled-tasks__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__things3__*",
      "mcp__fitbit__*",
      "mcp__plugin_discord_discord__*",
      "mcp__withings__*",
      "mcp__mcp-registry__*",
      "mcp__mychart__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alexhedtke/Documents/Exobrain\\ harness/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
