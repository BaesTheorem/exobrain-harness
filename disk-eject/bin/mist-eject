#!/bin/sh
# Ask whatever holds a busy external volume to quit, then eject it.
#   mist-eject                    # the mounted external volume
#   mist-eject "Extreme SSD"      # by name, device node, or /Volumes path
#   mist-eject --dry-run          # show what would be asked to quit
#   mist-eject --no-eject         # release holders, stay mounted
# Never forces: no `diskutil unmount force`, no SIGKILL. Finder's Force Eject
# button exists for that.
exec /opt/homebrew/bin/python3 \
  "/Users/alexhedtke/Documents/Exobrain harness/disk-eject/disk_eject.py" free "$@"
