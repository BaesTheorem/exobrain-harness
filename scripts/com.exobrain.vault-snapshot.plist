<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.vault-snapshot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/alexhedtke/.local/bin/mist-launch</string>
        <string>/bin/bash</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/scripts/vault-snapshot.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/alexhedtke/Documents/Exobrain harness</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/.claude/channels/vault-snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/.claude/channels/vault-snapshot-error.log</string>
