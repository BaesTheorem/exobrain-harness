        <key>PATH</key>
        <string>/Users/alexhedtke/.local/bin:/Users/alexhedtke/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Login Items shows the job under this app instead of its executable's name;
         only honored because mist-launch is signed by the same team. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.exobrain.mist-console</string>
    </array>
</dict>
</plist>
