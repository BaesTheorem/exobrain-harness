<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.zettel-maintain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/alexhedtke/.local/bin/mist-launch</string>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/scripts/zettel_maintain.py</string>
        <string>--limit</string>
        <string>200</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/alexhedtke/Documents/Exobrain harness</string>
    <key>StartCalendarInterval</key>
    <!-- Mondays 03:30: after Sunday's 23:00 consolidator, before the morning briefing. -->
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/.claude/channels/zettel-maintain.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/.claude/channels/zettel-maintain-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alexhedtke/.local/bin:/Users/alexhedtke/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Login Items shows the job under this app instead of its executable's name;
         only honored because mist-launch is signed by the same team. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.exobrain.mist-console</string>
    </array>
</dict>
</plist>
