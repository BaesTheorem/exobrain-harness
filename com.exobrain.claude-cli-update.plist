<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.claude-cli-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/claude-cli-autoupdate.sh</string>
    </array>

    <!-- Catch-up after power-off: launchd does not reliably refire missed
         StartCalendarInterval events after a cold boot, so RunAtLoad fires the
         check on login/boot. `claude update` is idempotent, so an extra run is
         harmless. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Four times a day (local time), not just overnight. Releases ship during
         US business hours: 2.1.280 published at 10:44 AM on 2026-09-22 carrying
         the claude-opus-5-5 alias, and a 4 AM-only job left the Console's model
         picker a release behind for the rest of the day. An up-to-date check is
         one manifest fetch, so the extra runs cost nothing. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/claude-cli-update.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/claude-cli-update.err</string>
</dict>
</plist>
