<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.claude-cli-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/alexhedtke/.local/bin/mist-launch</string>
        <string>/bin/bash</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/claude-cli-autoupdate.sh</string>
    </array>

    <!-- Catch-up after power-off: launchd does not reliably refire missed
         StartCalendarInterval events after a cold boot, so RunAtLoad fires the
         check on login/boot. `claude update` is idempotent, so an extra run is
         harmless. -->

    <!-- Every hour, at minute 0. Releases ship during US business hours at any
         time: 2.1.280 (claude-opus-5-5) published at 10:44 AM on 2026-09-22, and
         2.1.321 (claude-fable-5-2) at 1:02 PM on 2026-11-09, both between two runs
         of the earlier four-a-day schedule. The Console's model picker stayed a
         release behind for hours each time. An up-to-date check is one manifest
         fetch, and launchd does not start a second run while one is active. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/claude-cli-update.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/claude-cli-update.err</string>
    <!-- Login Items shows the job under this app instead of its executable's name;
         only honored because mist-launch is signed by the same team. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.exobrain.mist-console</string>
    </array>
</dict>
</plist>
