#!/bin/bash
# Confetti burst over every display, with an optional victory tone.
#
#   mist-confetti                      # confetti + the default tone
#   mist-confetti --silent             # visuals only
#   mist-confetti --tone success       # the shorter cue
#   mist-confetti --duration 6 --intensity 1.6
#
# Sound is OFF-BY-DEFAULT everywhere else in this harness; here it is on, because
# the only thing that calls this is an explicit celebration Alex asked to hear.
# Any automated caller that should stay quiet passes --silent.
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$DIR/build/mist-confetti"
TONE="complete"
SILENT=0
PASS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --silent) SILENT=1; shift ;;
    --tone)   TONE="$2"; shift 2 ;;
    *)        PASS+=("$1"); shift ;;
  esac
done

[ -x "$BIN" ] || "$DIR/build.sh" >/dev/null

if [ "$SILENT" -eq 0 ]; then
  SND="$DIR/sounds/arcade-$TONE.mp3"
  [ -f "$SND" ] && afplay "$SND" &
fi

exec "$BIN" "${PASS[@]}"
