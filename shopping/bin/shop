#!/usr/bin/env python3
"""shop -- one pipeline for finding the lowest real price of an item.

  shop find <query> [--at target,walmart,flipp,amazon] [-n N] [--json]
      Search every retailer lane at once. Target and Walmart prices are for the
      stores nearest HOME_ZIP; Flipp is the weekly grocery ads; Amazon is a real
      browser behind Akamai. A lane that fails says so instead of vanishing.

  shop price <url | target:<tcin> | walmart:<id> | flipp:<id> | ASIN>... [--all-variants] [--json]
      One item in full: price at the nearest store, stock and pickup, seller, UPC,
      variants, delivery promise (Amazon, signed-in). Paste a product URL and the
      retailer is read from it.

  shop fbm <query> [--radius KM] [--min N] [--max N] [--days D] [--condition new,used_good]
                   [--sort date|price|price_desc|distance] [--exact] [-n N] [--json]
      Facebook Marketplace listings around home (used market, kept out of `find` unless
      you pass --at fbm). Rides the facebook/ toolkit's session cookies; read-only.
      `shop price fbm:<id>` or a marketplace/item URL gives the description, condition,
      photos, seller and pin. --refresh-docid recaptures the GraphQL doc_id when it drifts.

  shop ebay <query> [--condition new,used,...] [--min N] [--max N] [--auction|--bin] [--local MI]
                    [--sort best|price|price_desc|newest|ending] [-n N] [--json]
      Active eBay listings (official Browse API; EBAY_CLIENT_ID/SECRET in .env). Shipping is
      quoted to HOME_ZIP. Joins the default `find` table, new condition only, once keys exist.
  shop ebay --sold <query> [--days D] [--condition any|new|used] [--min N] [--max N] [-n N]
      What it actually sold for: sold listings plus median, quartiles and range, through the
      Apify actor caffein.dev/ebay-sold-listings (APIFY_TOKEN; about $0.004 per result).
      eBay's own sold routes are walled from here; see shoptools/ebay.py.

  shop grocery stores [--near ZIP|LAT,LON] [--json]
      Kansas City grocery directory: Price Chopper (50 stores, operators), Cosentino's Market,
      Sun Fresh, Costco warehouses (Midtown #375 closed 2026-10-01), Whole Foods, the walk-in
      independents; distance from home, which lanes cover each, status notes.
  shop grocery search <query> [--at wholefoods,costco,pricechopper,cosentinos,sunfresh,aldi,...] [-n N] [--json]
      One table across the grocery lanes: Whole Foods shelf prices, Costco.com online prices
      (warehouse prices are not published), Price Chopper's weekly ad, Cosentino's coupons and
      ad, Sun Fresh's ad (OCR'd), plus ALDI/Hy-Vee/Dillons/Sprouts ads. Failures print as warnings.
  shop grocery ad <store> [--grep TERM] [--upcoming] [--store-id ID] [--json]
      The whole weekly ad: pricechopper, costco (coupon book), cosentinos, sunfresh, aldi, hyvee,
      dillons, sprouts, walmart, target, samsclub. Cosentino's and Sun Fresh are image-only PDFs
      read with Apple Vision; rows carry the page number, treat them as an index into the ad.
  shop grocery coupons <store> [--grep TERM] [--location ID] [--json]
      Digital coupons where a public feed exists (Cosentino's Market EZConnect, downtown store).

  shop stores                      Target stores nearest HOME_ZIP (store context changes the price)
  shop codes <domain>              Promo-code candidates: SimplyCodes, Wethrift, common guesses
  shop cart <shopify-url> --codes A B --harvest --max-stack 3
                                   Test codes and combinations on a live Shopify cart (never checks out)
  shop best <offers.json>          Rank every source x every legal code subset by net cost
  shop clearance <upc> [store]     In-store penny and clearance price via Penny Lane
  shop amazon <search|show|orders|auth|url> ...
                                   The full Amazon tool, including order history and the Chrome session

Read-only toward money: nothing here signs in, enters payment, or submits an order.
Needs HOME_ZIP in the harness .env. Python deps: curl_cffi, playwright (+ chromium).
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from shoptools import cart, codes, lanes, rank  # noqa: E402
from shoptools.common import LaneError  # noqa: E402

PENNY = Path.home() / "Documents/penny-lane/bin/penny"


def _row(r: dict) -> str:
    price = r.get("formatted") or (f"${r['price']:.2f}" if r.get("price") is not None else "-")
    extra = ""
    if r.get("seller") and r["seller"] not in ("Walmart.com", "Walmart"):
        extra += f"  seller: {r['seller']}"
    if r.get("availability") and r["availability"] not in ("IN_STOCK", "In stock"):
        extra += f"  {r['availability']}"
    if r.get("shipping"):
        extra += f"  +${r['shipping']:.2f} ship"
    if r.get("valid_to"):
        extra += f"  thru {r['valid_to']}"
    if r.get("sponsored"):
        extra += "  [ad]"
    return f"{r.get('retailer') or '?':<12} {price:>10}  {str(r.get('id') or ''):<12} {r.get('title', '')[:70]}{extra}"


def cmd_find(a) -> int:
    at = tuple(x.strip() for x in a.at.split(",")) if a.at else lanes.default_lanes()
    rows, errors = lanes.find(" ".join(a.query), at, a.n)
    if a.json:
        print(json.dumps({"rows": rows, "errors": errors}, indent=2))
    else:
        for r in sorted(rows, key=lambda r: (r.get("price") is None, r.get("price") or 0)):
            print(_row(r))
    for lane, err in errors.items():
        print(f"warn: {lane} lane failed: {err}", file=sys.stderr)
    if not rows:
        print("No rows from any lane. That is suspect; widen the query before believing it.", file=sys.stderr)
        return 1
    return 0


def cmd_price(a) -> int:
    out: list[dict] = []
    for spec in a.item:
        try:
            out.extend(lanes.price(spec, all_variants=a.all_variants))
        except LaneError as e:
            print(f"shop: {e}", file=sys.stderr)
            return 1
    if a.json:
        print(json.dumps(out if len(out) > 1 else out[0], indent=2))
        return 0
    for r in out:
        if r.get("retailer") == "Amazon":
            from shoptools import amazon
            amazon.print_product(r, full=len(out) == 1)
            continue
        if r.get("retailer") == "FB Marketplace":
            from shoptools import fbm
            fbm.print_row(r, full=True)
            print()
            continue
        if r.get("retailer") == "eBay":
            from shoptools import ebay
            ebay.print_row(r, full=True)
            print()
            continue
        print(_row(r))
        print(f"  {r['url']}")
        for k in ("upc", "size", "reg_price", "was", "sale_story", "in_store_only"):
            if r.get(k):
                print(f"  {k}: {r[k]}")
        if r.get("store"):
            print(f"  store: {r['store']['name']} ({r['store']['id']}), priced by location {r.get('price_location')}")
        if r.get("fulfillment"):
            print(f"  fulfillment: {json.dumps(r['fulfillment'])}")
        if r.get("promotions"):
            print(f"  promotions: {'; '.join(r['promotions'])}")
        if r.get("variants"):
            v = r["variants"]
            shown = v if isinstance(v, int) else "; ".join(f"{x['id']} {x['name']}" for x in v)
            print(f"  variants: {shown}")
        print()
    return 0


def cmd_fbm(a) -> int:
    from shoptools import fbm
    if a.refresh_docid:
        print(f"doc_id: {fbm.refresh_doc_id()}")
        if not a.query:
            return 0
    if not a.query:
        raise SystemExit("shop fbm: give a query (or --refresh-docid alone)")
    condition = [c.strip() for c in a.condition.split(",")] if a.condition else None
    try:
        rows, warnings = fbm.search(" ".join(a.query), n=a.n, radius_km=a.radius, min_price=a.min, max_price=a.max,
                                    days=a.days, condition=condition, sort=a.sort, exact=a.exact)
    except LaneError as e:
        print(f"shop: {e}", file=sys.stderr)
        return 1
    if a.json:
        print(json.dumps({"rows": rows, "warnings": warnings}, indent=2))
    else:
        for r in rows:
            fbm.print_row(r)
    for w in warnings:
        print(f"warn: {w}", file=sys.stderr)
    if not rows:
        print("No listings. Widen --radius, drop --exact or the price bounds before believing it.", file=sys.stderr)
        return 1
    return 0


def cmd_ebay(a) -> int:
    from shoptools import ebay
    query = " ".join(a.query)
    try:
        if a.sold:
            if a.condition and a.condition not in ("any", "new", "used"):
                raise SystemExit("shop ebay --sold: --condition is any, new or used")
            rows = ebay.sold(query, n=a.n, days=a.days, condition=a.condition or "any",
                             min_price=a.min, max_price=a.max)
        else:
            buying = "AUCTION" if a.auction else "FIXED_PRICE" if a.bin else None
            cond = [c.strip() for c in a.condition.split(",")] if a.condition else None
            rows = ebay.search(query, n=a.n, min_price=a.min, max_price=a.max, condition=cond,
                               buying=buying, local_miles=a.local, sort=a.sort)
    except LaneError as e:
        print(f"shop: {e}", file=sys.stderr)
        return 1
    c = ebay.comps(rows) if a.sold else None
    if a.json:
        print(json.dumps({"rows": rows, "comps": c} if a.sold else {"rows": rows}, indent=2))
        return 0 if rows else 1
    for r in rows:
        ebay.print_row(r)
    if c and rows:
        print()
        ebay.print_comps(c, query)
    if not rows:
        print("No listings. Widen the query or the price bounds before believing it.", file=sys.stderr)
        return 1
    return 0


def cmd_grocery(a) -> int:
    from shoptools import grocery
    if a.gcmd == "stores":
        try:
            stores, errors = grocery.directory(a.near)
        except (LaneError, ValueError) as e:
            print(f"shop: {e}", file=sys.stderr)
            return 1
        if a.json:
            print(json.dumps({"stores": stores, "errors": errors}, indent=2))
        else:
            for s in stores:
                print(grocery.fmt_store(s))
                if s.get("note"):
                    print(f"          {s['note']}")
        for chain, err in errors.items():
            print(f"warn: {chain} store list failed: {err}", file=sys.stderr)
        return 0
    if a.gcmd == "search":
        at = tuple(x.strip() for x in a.at.split(",")) if a.at else grocery.SEARCH_LANES
        rows, errors = grocery.search(" ".join(a.query), at, a.n)
        if a.json:
            print(json.dumps({"rows": rows, "errors": errors}, indent=2))
        else:
            for r in sorted(rows, key=lambda r: (r.get("price") is None, r.get("price") or 0)):
                print(grocery.fmt_row(r))
        for lane, err in errors.items():
            print(f"warn: {lane} lane failed: {err}", file=sys.stderr)
        if not rows:
            print("No rows from any grocery lane. Widen the query before believing it.", file=sys.stderr)
            return 1
        return 0
    try:
        if a.gcmd == "ad":
            rows, meta = grocery.ad(a.store, a.grep, upcoming=a.upcoming, store_id=a.store_id)
        else:
            rows, meta = grocery.coupons(a.store, a.grep, a.location), {}
    except LaneError as e:
        print(f"shop: {e}", file=sys.stderr)
        return 1
    if a.json:
        print(json.dumps({"rows": rows, "meta": meta}, indent=2))
        return 0 if rows else 1
    if meta:
        print(f"{meta.get('title') or ''}  {meta.get('url') or ''}".strip())
        if meta.get("store"):
            print(f"store: {meta['store']}  pages: {meta.get('pages') or '?'}")
    for r in rows:
        print(grocery.fmt_row(r))
    if not rows:
        print("No rows. For an OCR'd ad, open the PDF; for Flipp, widen --grep.", file=sys.stderr)
        return 1
    return 0


def cmd_clearance(a) -> int:
    if not PENNY.exists():
        raise SystemExit("shop clearance needs Penny Lane at ~/Documents/penny-lane (see the /penny skill)")
    if a.retailer:
        argv = [str(PENNY), "lookup", a.retailer, a.item] + ([a.store] if a.store else [])
    else:
        argv = [str(PENNY), "upc", a.item] + ([a.store] if a.store else [])
    os.execv(argv[0], argv)


def main(argv: list[str]) -> int:
    # `shop amazon ...` is the whole former amz tool; hand it its own argv untouched.
    if argv[:1] == ["amazon"]:
        from shoptools import amazon
        return amazon.main(argv[1:])

    ap = argparse.ArgumentParser(prog="shop", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("amazon", help="Amazon lane: search, show, orders, auth, url")

    f = sub.add_parser("find", help="search every retailer lane at once")
    f.add_argument("query", nargs="+")
    f.add_argument("--at", help=f"comma list of lanes, default {','.join(lanes.SEARCH_LANES)}; "
                                f"optional: {','.join(lanes.OPTIONAL_LANES)}")
    f.add_argument("-n", type=int, default=8, help="rows per lane")
    f.add_argument("--json", action="store_true")

    m = sub.add_parser("fbm", help="Facebook Marketplace listings around home (used market)")
    m.add_argument("query", nargs="*")
    m.add_argument("--radius", type=int, default=40, help="km from home, default 40")
    m.add_argument("--min", type=float, help="minimum price, dollars")
    m.add_argument("--max", type=float, help="maximum price, dollars")
    m.add_argument("--days", type=int, help="listed within the last D days")
    m.add_argument("--condition", help="comma list of new,used_like_new,used_good,used_fair")
    m.add_argument("--sort", default="date", choices=["date", "price", "price_desc", "distance"])
    m.add_argument("--exact", action="store_true", help="exact phrase; Facebook's default search is fuzzy")
    m.add_argument("-n", type=int, default=24)
    m.add_argument("--refresh-docid", action="store_true", help="recapture the GraphQL doc_id (headless browser)")
    m.add_argument("--json", action="store_true")

    e = sub.add_parser("ebay", help="eBay active listings (Browse API) or --sold prices (Apify)")
    e.add_argument("query", nargs="+")
    e.add_argument("--sold", action="store_true", help="sold listings and price stats instead of active ones")
    e.add_argument("--condition", help="active: comma list of new,open_box,refurbished,used,parts; sold: any|new|used")
    e.add_argument("--min", type=float)
    e.add_argument("--max", type=float)
    e.add_argument("--days", type=int, default=90, help="--sold: how far back, default 90")
    e.add_argument("--auction", action="store_true")
    e.add_argument("--bin", action="store_true", help="Buy It Now only")
    e.add_argument("--local", type=int, metavar="MILES", help="local pickup within MILES of HOME_ZIP")
    e.add_argument("--sort", default="best", choices=["best", "price", "price_desc", "newest", "ending"])
    e.add_argument("-n", type=int, default=30)
    e.add_argument("--json", action="store_true")

    p = sub.add_parser("price", help="one item in full, from a URL, retailer:id or ASIN")
    p.add_argument("item", nargs="+")
    p.add_argument("--all-variants", action="store_true", help="Amazon: load every sibling color/size ASIN too")
    p.add_argument("--json", action="store_true")

    st = sub.add_parser("stores", help="Target stores nearest HOME_ZIP")
    st.add_argument("--json", action="store_true")

    c = sub.add_parser("codes", help="promo-code candidates for a store domain")
    c.add_argument("domain")
    c.add_argument("--extra", nargs="*", default=[])
    c.add_argument("--no-guess", action="store_true")
    c.add_argument("--json", action="store_true")

    s = sub.add_parser("cart", help="test codes on a live Shopify cart (never checks out)")
    s.add_argument("url")
    s.add_argument("--variant", type=int)
    s.add_argument("--qty", type=int, default=1)
    s.add_argument("--codes", nargs="*", default=[])
    s.add_argument("--harvest", action="store_true", help="also test harvested + guessed codes")
    s.add_argument("--max-stack", type=int, default=3)
    s.add_argument("--selling-plan", type=int,
                   help="subscription plan id (selling_plan_groups in <handle>.js); some codes are subscription-only")
    s.add_argument("--json", action="store_true")

    b = sub.add_parser("best", help="rank offers.json by net cost")
    b.add_argument("offers", type=Path)
    b.add_argument("--json", action="store_true")

    g = sub.add_parser("grocery", help="Kansas City grocery stores: directory, prices, weekly ads, coupons")
    gs = g.add_subparsers(dest="gcmd", required=True)
    g1 = gs.add_parser("stores", help="store directory with distance, lanes and status")
    g1.add_argument("--near", help="ZIP or LAT,LON to measure from (default: home)")
    g1.add_argument("--json", action="store_true")
    g2 = gs.add_parser("search", help="one table across the grocery lanes")
    g2.add_argument("query", nargs="+")
    g2.add_argument("--at", help="comma list of lanes, default wholefoods,costco,pricechopper,cosentinos,sunfresh; "
                                 "also aldi,hyvee,dillons,sprouts,walmart,target,samsclub (Flipp ads)")
    g2.add_argument("-n", type=int, default=8, help="rows per lane")
    g2.add_argument("--json", action="store_true")
    g3 = gs.add_parser("ad", help="the whole weekly ad for one store")
    g3.add_argument("store")
    g3.add_argument("--grep", help="only rows whose title, size or description has every word")
    g3.add_argument("--upcoming", action="store_true", help="cosentinos: next week's ad instead of the current one")
    g3.add_argument("--store-id", help="sunfresh: Freshop store id; pricechopper: add that store's front-page highlights")
    g3.add_argument("--json", action="store_true")
    g4 = gs.add_parser("coupons", help="digital coupons for one store")
    g4.add_argument("store")
    g4.add_argument("--grep", help="product-line search")
    g4.add_argument("--location", help="cosentinos: EZConnect location id (default: Downtown Market)")
    g4.add_argument("--json", action="store_true")

    cl = sub.add_parser("clearance", help="in-store penny/clearance price via Penny Lane")
    cl.add_argument("item", help="UPC, or an item id when --retailer is given")
    cl.add_argument("store", nargs="?", help="store id (Penny Lane's configured stores by default)")
    cl.add_argument("--retailer", help="homedepot|dollargeneral|lowes|walmart, to look up by item id instead of UPC")

    a = ap.parse_args(argv)
    if a.cmd == "find":
        return cmd_find(a)
    if a.cmd == "price":
        return cmd_price(a)
    if a.cmd == "fbm":
        return cmd_fbm(a)
    if a.cmd == "ebay":
        return cmd_ebay(a)
    if a.cmd == "stores":
        rows = lanes.target_stores(8)
        if a.json:
            print(json.dumps(rows, indent=2))
        else:
            for r in rows:
                print(f"{r['id']:<6} {r['name']:<28} {r['miles']} mi")
        return 0
    if a.cmd == "codes":
        out = codes.harvest(codes.bare_domain(a.domain), a.extra, guess=not a.no_guess)
        if a.json:
            print(json.dumps(out, indent=2))
        else:
            for c in out:
                print(f"{c['code']:<24} {','.join(c['sources'])}")
        return 0
    if a.cmd == "cart":
        out = cart.run(a.url, a.codes, a.variant, a.qty, a.harvest, a.max_stack, a.selling_plan)
        print(json.dumps(out, indent=2)) if a.json else cart.print_result(out)
        return 0
    if a.cmd == "best":
        out = rank.run(a.offers)
        print(json.dumps(out, indent=2)) if a.json else rank.print_result(out)
        return 0
    if a.cmd == "grocery":
        return cmd_grocery(a)
    if a.cmd == "clearance":
        return cmd_clearance(a)
    ap.error(f"unknown command {a.cmd}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
