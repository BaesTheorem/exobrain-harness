#!/usr/bin/env python3
"""marketplace -- a cleaner front end for Facebook Marketplace, served on this Mac.

  marketplace [--host 127.0.0.1] [--port 5041]
      Serve the UI at http://127.0.0.1:5041/. Search runs through the `shop fbm` lane with
      the facebook/ toolkit's session cookies, read-only. Pass a Tailscale address as --host
      to open it on the phone. See shopping/marketplace/README.md.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from marketplace.server import serve  # noqa: E402


def main() -> None:
    ap = argparse.ArgumentParser(description="Facebook Marketplace front end")
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=5041)
    a = ap.parse_args()
    serve(a.host, a.port)


if __name__ == "__main__":
    main()
