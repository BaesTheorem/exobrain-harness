# Harness root .env template. Copy to .env (gitignored) and fill in what you use.
# Every value here is blank on purpose. Each line names the tool that reads it;
# a tool you never run needs nothing. The process environment wins over .env for
# every key. Per-tool secrets that live elsewhere (phone/.env, fitbit-mcp/.env,
# disposable-email/secrets.json, kcurbex/secrets/) have their own templates.

# --- Google OAuth (Desktop client): backup/ Drive upload, bin/drive-fetch, kcurbex calendar sync
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Health: fitbit-mcp/ OAuth app, and the Withings MCP server entry in the gitignored .mcp.json
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=
WITHINGS_REFRESH_TOKEN=

# --- Discord: DM target for awair/, running-quest/ and fantasy/bin/chat-watch alerts
DISCORD_NOTIFY_CHAT_ID=
# claude-bot/: the Discord username treated as the owner
DISCORD_ALEX_USERNAME=
# /discord-digest and /group-scheduler skills: channel ids to scan
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_HANGOUTS=
DISCORD_CHANNEL_MUSINGS=

# --- job-search/: comp floors (annual USD) read by job-search/comp_floors.py; no default
JOB_COMP_FLOOR=
JOB_ONSITE_FLOOR=
# job-search/usajobs.py: free key from https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- unemployment/: uinteract MCP login
UINTERACT_USERNAME=
UINTERACT_PASSWORD=

# --- kcurbex/: forum login and target calendar (defaults to primary)
KCURBEX_USERNAME=
KCURBEX_PASSWORD=
KCURBEX_CALENDAR_ID=

# --- mykcmo/ 311 reports: reporter contact and the home point
# (MYKCMO_HOME_LAT/LON are also kcurbex's proximity origin)
MYKCMO_CONTACT_FIRST=
MYKCMO_CONTACT_LAST=
MYKCMO_CONTACT_EMAIL=
MYKCMO_CONTACT_PHONE=
MYKCMO_HOME_ADDRESS=
MYKCMO_HOME_LAT=
MYKCMO_HOME_LON=

# --- /discount skill: ZIP for local price and availability lookups
HOME_ZIP=

# --- mist-image/: Cloudflare Workers AI and Pollinations image backends
CF_ACCOUNT_ID=
CF_API_TOKEN=
POLLINATIONS_API_KEY=

# --- mist-music/: Hugging Face token for the ACE-Step Space
HF_TOKEN=

# --- bin/luma: session cookie and extra calendars ("name=cal-x,other=cal-y")
LUMA_AUTH_SESSION_KEY=
LUMA_CALENDARS=

# --- bin/deezer-dl: Deezer ARL session cookie (else extracted from the browser)
DEEZER_ARL=

# --- zulip/bin/zulip-admin: the realm owner's email
OWNER_EMAIL=

# --- awair/: local air-quality sensor and its cloud API
AWAIR_HOST=
AWAIR_CLIENT_ID=
AWAIR_CLIENT_SECRET=
AWAIR_REDIRECT_URI=
AWAIR_ACCESS_TOKEN=
AWAIR_REFRESH_TOKEN=

# --- tv/: LAN address and MAC (for wake-on-LAN) of the TV
TV_HOST=
TV_MAC=

# --- anbernic/bin/push-rom: handheld's LAN address (else --ip or the cached IP)
ANBERNIC_HOST=

# --- /cybersecurity-bodyguard skill: Have I Been Pwned API key
HIBP_API_KEY=

# --- fantasy/bin/ff refresh: seeds espn-credentials.json on a first run only
ESPN_LEAGUE_ID=
ESPN_SEASON=

# --- bin/testflight-feedback: App Store Connect API team key (Users and Access > Integrations)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
