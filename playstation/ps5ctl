#!/usr/bin/env python3
"""Send one command line to the running ps5-session daemon and print the reply.

Usage: ps5ctl tap CROSS            ps5ctl 'move 0 -1 1500; tap R1'
       ps5ctl status               ps5ctl snap /tmp/now.png
Socket: $PS5_LIVE_DIR/ctl.sock, default <harness>/tmp/ps5-live/ctl.sock.
"""

import os
import pathlib
import socket
import sys


def main() -> None:
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(2)
    live = os.environ.get("PS5_LIVE_DIR") or str(
        pathlib.Path(__file__).resolve().parents[1] / "tmp" / "ps5-live"
    )
    sock_path = pathlib.Path(live) / "ctl.sock"
    if not sock_path.exists():
        print(
            f"err no daemon socket at {sock_path}; start ps5-session.py",
            file=sys.stderr,
        )
        sys.exit(1)
    line = " ".join(sys.argv[1:]).strip()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(60)
        s.connect(str(sock_path))
        s.sendall((line + "\n").encode())
        chunks = []
        while True:
            data = s.recv(65536)
            if not data:
                break
            chunks.append(data)
    reply = b"".join(chunks).decode().rstrip()
    print(reply)
    sys.exit(0 if reply.startswith("ok") else 1)


if __name__ == "__main__":
    main()
