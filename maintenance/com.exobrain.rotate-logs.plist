<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.rotate-logs</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/maintenance/rotate-logs.sh</string>
    </array>

    <!-- Sundays at 04:00. The laptop is usually asleep then, so launchd runs
         this on the next wake instead; rotation is not time-critical. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/rotate-logs.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/rotate-logs.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
