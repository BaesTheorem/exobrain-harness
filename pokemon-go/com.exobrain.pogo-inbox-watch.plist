<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.pogo-inbox-watch</string>
    <!-- The interpreter is spawned directly: a Homebrew python exec'd by a launchd
         shell is denied ~/Documents by TCC (see scripts/README.md). -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/pokemon-go/pogocli.py</string>
        <string>inbox</string>
        <string>--notify</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/alexhedtke/Documents/Exobrain harness</string>
    <!-- Fires when a Poke Genie CSV or the data-request zip lands from the phone
         (iCloud Drive/Pokemon GO via Files, or AirDrop into Downloads). -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/alexhedtke/Library/Mobile Documents/com~apple~CloudDocs/Pokemon GO</string>
        <string>/Users/alexhedtke/Downloads</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/pogo-inbox-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/pogo-inbox-watch.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/alexhedtke/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
