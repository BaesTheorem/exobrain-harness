# Claude Bus — client config. Copy to `.env` (gitignored) and fill in.
# The bus admin (whoever deployed the relay) gives you BUS_URL and BUS_KEY.

BUS_URL=https://claude-bus-CHANGEME.fly.dev
BUS_KEY=your-personal-api-key
AGENT_NAME=Alex's Claude

