#!/usr/bin/env python3
"""Find public GitHub projects that stalled before AI-assisted coding.

Subcommands:
  harvest   collect candidate repos from Hacker News (Algolia) and GitHub search
  enrich    pull metadata + README for every candidate (GraphQL, 50 per call)
  rank      filter noise, score, and write per-lane batches for the judgment pass

Data lands in stalled-repos/data/ (gitignored). Every step is resumable: it
reads what the previous step wrote and skips work already done.

The cutoff is the ChatGPT launch (2022-11-30): a candidate's last push must be
before it.
"""
import argparse
import http.client
import json
import math
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / "data"
CUTOFF = "2022-11-30"
CUTOFF_TS = 1669766400
REPO_RE = re.compile(r"github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)")
SKIP_OWNERS = {"features", "about", "orgs", "sponsors", "topics", "collections", "marketplace", "settings", "apps"}

# Lane "weird": odd ideas, experiments, new interfaces, art, esoteric computing.
WEIRD_README = [
    "weird", "esoteric", "an experiment", "experimental", "crazy idea", "what if", "proof of concept",
    "unfinished", "work in progress", "abandoned", "never finished", "half-finished", "prototype",
    "art project", "bizarre", "absurd", "useless", "pointless", "thought experiment", "toy",
]
WEIRD_TOPICS = [
    "esoteric", "esolang", "generative-art", "creative-coding", "experiment", "experimental", "demoscene",
    "procedural-generation", "cellular-automata", "artificial-life", "livecoding", "interactive-fiction",
    "hypertext", "fantasy-console", "tools-for-thought", "zoomable-user-interface", "structural-editor",
    "projectional-editor", "visual-programming", "end-user-programming", "spatial-computing", "net-art",
    "conlang", "steganography", "sonification", "music-generation", "bots", "chatbot", "virtual-world",
    "p2p", "local-first", "hardware-hacking", "art",
]
# Lane "games": dead-but-loved games, remakes, engine reimplementations.
GAME_README = [
    "open source reimplementation", "fan remake", "engine reimplementation", "reverse engineered",
    "abandonware", "open-source remake", "unofficial remake", "recreation of the classic",
]
GAME_TOPICS = [
    "game-remake", "reimplementation", "remake", "abandonware", "game-engine-recreation", "roguelike",
    "mud", "multiplayer-game", "browser-game", "game", "games", "mmorpg", "indie-game", "puzzle-game",
]


def gh_token():
    return subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, check=True).stdout.strip()


def http_json(url, token=None, body=None):
    headers = {"User-Agent": "stalled-repos", "Accept": "application/vnd.github+json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    data = json.dumps(body).encode() if body is not None else None
    for attempt in range(5):
        try:
            req = urllib.request.Request(url, data=data, headers=headers)
            with urllib.request.urlopen(req, timeout=60) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code in (403, 429, 499, 500, 502, 503, 504):
                wait = 60 if e.code in (403, 429) else 5 * (attempt + 1)
                print(f"  http {e.code}, waiting {wait}s", file=sys.stderr)
                time.sleep(wait)
                continue
            if e.code == 422:
                return {}
            raise
        except (urllib.error.URLError, TimeoutError, http.client.HTTPException, ConnectionError):
            time.sleep(5 * (attempt + 1))
    return {}


def load_jsonl(path):
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def add(cands, owner, repo, source, lane, hn=None):
    repo = re.sub(r"\.git$", "", repo).rstrip(".")
    if owner.lower() in SKIP_OWNERS or not repo:
        return
    key = f"{owner}/{repo}".lower()
    c = cands.setdefault(key, {"name": f"{owner}/{repo}", "sources": [], "lanes": [], "hn": []})
    if source not in c["sources"]:
        c["sources"].append(source)
    if lane not in c["lanes"]:
        c["lanes"].append(lane)
    if hn:
        c["hn"].append(hn)


def harvest_hn(cands):
    base = "https://hn.algolia.com/api/v1/search"
    windows = []
    for y in range(2008, 2023):
        for q in range(4):
            a = int(time.mktime((y, 1 + 3 * q, 1, 0, 0, 0, 0, 0, -1)))
            b = int(time.mktime((y + (q == 3), 1 + 3 * ((q + 1) % 4), 1, 0, 0, 0, 0, 0, -1)))
            if a < CUTOFF_TS:
                windows.append((a, min(b, CUTOFF_TS)))
    for tag, min_pts in (("show_hn", 30), ("story", 150)):
        n = 0
        for a, b in windows:
            params = {
                "tags": tag, "query": "github.com", "restrictSearchableAttributes": "url",
                "numericFilters": f"points>={min_pts},created_at_i>={a},created_at_i<{b}", "hitsPerPage": 1000,
            }
            d = http_json(base + "?" + urllib.parse.urlencode(params))
            for h in d.get("hits", []):
                m = REPO_RE.search(h.get("url") or "")
                if m:
                    add(cands, m.group(1), m.group(2), f"hn:{tag}", "hn", {
                        "id": h["objectID"], "points": h.get("points"), "comments": h.get("num_comments"),
                        "title": h.get("title"), "date": (h.get("created_at") or "")[:10]})
                    n += 1
        print(f"hn {tag}: {n} hits", file=sys.stderr)


def harvest_gh(cands, token):
    queries = []
    for k in WEIRD_README:
        queries.append(("weird", f'"{k}" in:readme stars:>=80 pushed:<{CUTOFF} fork:false'))
    for t in WEIRD_TOPICS:
        queries.append(("weird", f"topic:{t} stars:>=40 pushed:<{CUTOFF} fork:false"))
    for k in GAME_README:
        queries.append(("games", f'"{k}" in:readme stars:>=40 pushed:<{CUTOFF} fork:false'))
    for t in GAME_TOPICS:
        queries.append(("games", f"topic:{t} stars:>=80 pushed:<{CUTOFF} fork:false"))
    for i, (lane, q) in enumerate(queries):
        n = 0
        for page in (1, 2, 3):
            params = {"q": q, "sort": "stars", "order": "desc", "per_page": 100, "page": page}
            d = http_json("https://api.github.com/search/repositories?" + urllib.parse.urlencode(params), token)
            items = d.get("items", [])
            for it in items:
                o, r = it["full_name"].split("/", 1)
                add(cands, o, r, f"gh:{q}", lane)
                n += 1
            time.sleep(2.2)  # search API: 30 requests/min
            if len(items) < 100:
                break
        print(f"[{i + 1}/{len(queries)}] {n:4d}  {q}", file=sys.stderr)


GQL_FIELDS = """
  nameWithOwner description url stargazerCount forkCount isArchived isFork createdAt pushedAt
  diskUsage homepageUrl licenseInfo { spdxId }
  primaryLanguage { name }
  repositoryTopics(first: 12) { nodes { topic { name } } }
  issues(states: OPEN) { totalCount }
  closed: issues(states: CLOSED) { totalCount }
  defaultBranchRef { target { ... on Commit { committedDate history { totalCount } } } }
  r1: object(expression: "HEAD:README.md") { ... on Blob { text } }
  r2: object(expression: "HEAD:readme.md") { ... on Blob { text } }
  r3: object(expression: "HEAD:README") { ... on Blob { text } }
  r4: object(expression: "HEAD:README.rst") { ... on Blob { text } }
  r5: object(expression: "HEAD:README.txt") { ... on Blob { text } }
"""


def enriched_rows():
    rows = []
    for f in sorted(DATA.glob("enriched*.jsonl")):
        rows += load_jsonl(f)
    return rows


def enrich(token, shard, shards):
    cands = json.loads((DATA / "candidates.json").read_text())
    out_path = DATA / f"enriched-{shard}.jsonl"
    done = {r["key"] for r in enriched_rows()}
    todo = [k for i, k in enumerate(cands) if k not in done and i % shards == shard]
    print(f"enrich: {len(todo)} to fetch, {len(done)} done", file=sys.stderr)
    with out_path.open("a") as out:
        for i in range(0, len(todo), 25):
            chunk = todo[i:i + 25]
            parts = []
            for j, k in enumerate(chunk):
                o, r = cands[k]["name"].split("/", 1)
                parts.append(f'q{j}: repository(owner: {json.dumps(o)}, name: {json.dumps(r)}) {{ {GQL_FIELDS} }}')
            d = http_json("https://api.github.com/graphql", token, {"query": "{" + "\n".join(parts) + "}"})
            data = (d or {}).get("data") or {}
            for j, k in enumerate(chunk):
                node = data.get(f"q{j}")
                rec = {"key": k, **cands[k], "missing": node is None}
                if node:
                    readme = next((node[f"r{n}"]["text"] for n in range(1, 6) if node.get(f"r{n}") and node[f"r{n}"].get("text")), "")
                    tgt = (node.get("defaultBranchRef") or {}).get("target") or {}
                    rec.update({
                        "name": node["nameWithOwner"], "desc": node["description"], "url": node["url"],
                        "stars": node["stargazerCount"], "forks": node["forkCount"], "archived": node["isArchived"],
                        "fork": node["isFork"], "created": node["createdAt"][:10], "pushed": node["pushedAt"][:10],
                        "last_commit": (tgt.get("committedDate") or "")[:10], "commits": (tgt.get("history") or {}).get("totalCount"),
                        "kb": node["diskUsage"], "homepage": node["homepageUrl"],
                        "license": (node.get("licenseInfo") or {}).get("spdxId"),
                        "lang": (node.get("primaryLanguage") or {}).get("name"),
                        "topics": [t["topic"]["name"] for t in node["repositoryTopics"]["nodes"]],
                        "open_issues": node["issues"]["totalCount"], "closed_issues": node["closed"]["totalCount"],
                        "readme_len": len(readme), "readme": readme[:12000],
                    })
                out.write(json.dumps(rec) + "\n")
            out.flush()
            print(f"  [{shard}] {min(i + 25, len(todo))}/{len(todo)}", file=sys.stderr, flush=True)


NOISE = re.compile(
    r"\b(awesome|curated|cheat ?sheet|tutorials?|course|interview|leetcode|homework|lecture|book|notes|resources|"
    r"papers|dotfiles|roadmap|learning path|study|exercises|solutions|translation|中文|学习|面试|教程|资料)\b", re.I)
WIP = re.compile(r"work in progress|\bwip\b|unfinished|not (yet )?(finished|complete|implemented)|incomplete|"
                 r"abandoned|no longer maintained|unmaintained|on hold|hiatus|todo|roadmap|planned|coming soon|"
                 r"prototype|proof of concept|alpha|early stage|experimental", re.I)
WEIRD = re.compile(r"weird|strange|bizarre|absurd|esoteric|odd|crazy|silly|useless|pointless|what if|"
                   r"imagine|experiment|art project|playful|toy|whimsical|surreal|hallucinat|dream|mind", re.I)


def strip_readme(text, n):
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", text)          # images
    text = re.sub(r"<img[^>]*>|<[^>]+>", "", text)             # html
    text = re.sub(r"\[!\[.*?\]\(.*?\)\]\(.*?\)", "", text)     # badges
    text = re.sub(r"```.*?```", "[code]", text, flags=re.S)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()[:n]


def rank(per_lane, odd_extra, batch_size, readme_chars):
    rows = [r for r in enriched_rows() if not r.get("missing")]
    keep = []
    drop = {"fork": 0, "recent": 0, "noise": 0, "tiny": 0}
    for r in rows:
        if r["fork"]:
            drop["fork"] += 1; continue
        last = max(r["pushed"], r.get("last_commit") or "")
        if (r.get("last_commit") or r["pushed"]) >= CUTOFF:
            drop["recent"] += 1; continue
        blob = f"{r['name']} {r.get('desc') or ''}"
        if NOISE.search(blob) or r["lang"] in (None, "TeX") and r["kb"] < 2000:
            drop["noise"] += 1; continue
        if r["readme_len"] < 300 and not r["desc"]:
            drop["tiny"] += 1; continue
        readme = r.get("readme") or ""
        hn_pts = max([h["points"] or 0 for h in r["hn"]] or [0])
        unchecked = readme.count("- [ ]") + readme.count("* [ ]")
        checked = readme.count("- [x]") + readme.count("* [x]")
        r["sig"] = {
            "hn_pts": hn_pts, "wip_hits": len(WIP.findall(readme)), "weird_hits": len(WEIRD.findall(readme + blob)),
            "unchecked": unchecked, "checked": checked, "years_dead": 2026 - int(last[:4]),
        }
        r["score"] = (math.log10(r["stars"] + 1) + 0.8 * math.log10(hn_pts + 1)
                      + 0.15 * min(r["sig"]["wip_hits"], 6) + 0.2 * min(r["sig"]["weird_hits"], 5)
                      + 0.1 * min(unchecked, 8) + 0.3 * r["archived"])
        # Popularity alone ranks frameworks over odd ideas; this ranks the odd ones.
        r["odd"] = (0.5 * math.log10(r["stars"] + 1) + 0.4 * math.log10(hn_pts + 1)
                    + 0.4 * min(r["sig"]["weird_hits"], 8) + 0.1 * min(r["sig"]["wip_hits"], 6)
                    + 0.5 * any(w in r["sources"][0] for w in ('"weird"', '"what if"', '"useless"', '"absurd"', "esoteric", "esolang", "art")))
        keep.append(r)
    print(f"rank: {len(rows)} enriched, kept {len(keep)}, dropped {drop}", file=sys.stderr)

    lanes = {"games": [r for r in keep if "games" in r["lanes"]]}
    lanes["weird"] = [r for r in keep if "games" not in r["lanes"]]
    bdir = DATA / "batches"
    bdir.mkdir(exist_ok=True)
    for old in bdir.glob("*.md"):
        old.unlink()
    summary = {}
    for lane, items in lanes.items():
        items.sort(key=lambda r: -r["score"])
        top = items[:per_lane]
        if lane == "weird":
            seen = {r["key"] for r in top}
            top += [r for r in sorted(items, key=lambda r: -r["odd"]) if r["key"] not in seen][:odd_extra]
        summary[lane] = len(top)
        for b in range(0, len(top), batch_size):
            lines = []
            for r in top[b:b + batch_size]:
                hn = "; ".join(f"HN {h['points']}pts {h['date']} \"{h['title']}\"" for h in r["hn"][:2])
                lines.append(
                    f"## {r['name']}\n{r['url']} | {r['stars']}* {r['forks']} forks | {r['lang']} | {r['kb']} KB | "
                    f"{r['commits']} commits | created {r['created']} last commit {r.get('last_commit') or r['pushed']}"
                    f"{' | ARCHIVED' if r['archived'] else ''} | issues {r['open_issues']} open/{r['closed_issues']} closed"
                    f" | checklist {r['sig']['checked']} done/{r['sig']['unchecked']} open\n"
                    f"topics: {', '.join(r['topics']) or '-'}\n{('hn: ' + hn) if hn else ''}\n"
                    f"desc: {r.get('desc') or '-'}\n\n{strip_readme(r.get('readme') or '', readme_chars)}\n")
            (bdir / f"{lane}-{b // batch_size + 1:02d}.md").write_text("\n---\n".join(lines))
    (DATA / "ranked.jsonl").write_text("".join(json.dumps({k: v for k, v in r.items() if k != "readme"}) + "\n"
                                               for lane in lanes.values() for r in lane))
    print(f"batches: {summary} -> {bdir}", file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    h = sub.add_parser("harvest"); h.add_argument("--skip-hn", action="store_true"); h.add_argument("--skip-gh", action="store_true")
    en = sub.add_parser("enrich")
    en.add_argument("--shard", type=int, default=0)
    en.add_argument("--shards", type=int, default=1)
    rk = sub.add_parser("rank")
    rk.add_argument("--per-lane", type=int, default=400)
    rk.add_argument("--odd-extra", type=int, default=300)
    rk.add_argument("--batch", type=int, default=50)
    rk.add_argument("--readme-chars", type=int, default=1800)
    a = ap.parse_args()
    DATA.mkdir(exist_ok=True)
    token = gh_token()
    if a.cmd == "harvest":
        path = DATA / "candidates.json"
        cands = json.loads(path.read_text()) if path.exists() else {}
        if not a.skip_hn:
            harvest_hn(cands)
            path.write_text(json.dumps(cands))
        if not a.skip_gh:
            harvest_gh(cands, token)
        path.write_text(json.dumps(cands))
        print(f"candidates: {len(cands)}", file=sys.stderr)
    elif a.cmd == "enrich":
        enrich(token, a.shard, a.shards)
    elif a.cmd == "rank":
        rank(a.per_lane, a.odd_extra, a.batch, a.readme_chars)


if __name__ == "__main__":
    main()
