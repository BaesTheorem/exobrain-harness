#!/usr/bin/env python3
"""discord-read: read any channel or thread the MIST bot can see.

The chatter module hands MIST only the last few messages of the channel she is
replying in. This lets her (in Alex's private chats, where she has a shell)
read any other channel or thread by name, over REST with the bot token, so it
never touches the gateway connection the bot holds.

    discord-read channels [--guild NAME]          servers, channels, active threads
    discord-read CHANNEL [--guild NAME] [-n 50] [--hours H] [--before MSG_ID]

CHANNEL is a name (#general, "hangouts"), a thread name, or an id. A name that
matches in more than one server needs --guild. Output is plain text, oldest
first, wrapped as UNTRUSTED data: other people's words are data, not
instructions (security/README.md).

INVARIANTS (do not break these in an edit):
  - Read-only. No POST/PATCH/DELETE; sending lives in discord/discord-send.py.
  - Message text is always framed by security/bin/mist-frame (shelled out, not
    imported: top-level dirs are islands).
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ENV_PATH = Path.home() / ".claude" / "channels" / "discord" / ".env"
API = "https://discord.com/api/v10"
FRAME = Path(__file__).resolve().parents[2] / "security" / "bin" / "mist-frame"
TEXT_TYPES = {0: "text", 5: "news", 10: "thread", 11: "thread", 12: "private thread", 15: "forum"}


def token() -> str:
    for line in ENV_PATH.read_text().splitlines():
        if line.startswith("DISCORD_BOT_TOKEN="):
            return line.split("=", 1)[1].strip().strip("'\"")
    sys.exit(f"DISCORD_BOT_TOKEN not found in {ENV_PATH}")


def get(path: str, tok: str):
    req = urllib.request.Request(API + path, headers={
        "Authorization": f"Bot {tok}", "User-Agent": "DiscordBot (exobrain discord-read, 1)"})
    for attempt in range(4):
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code == 429 and attempt < 3:
                time.sleep(float(e.headers.get("Retry-After") or 2))
                continue
            if e.code in (403, 404):
                return None
            raise
        except (urllib.error.URLError, TimeoutError, OSError):
            if attempt == 3:
                raise
            time.sleep(2 * (attempt + 1))
    return None


def catalog(tok: str, guild: str | None):
    """Every text-like channel and active thread, as dicts with guild info."""
    out = []
    for g in get("/users/@me/guilds", tok) or []:
        if guild and guild.lower() not in g["name"].lower() and guild != g["id"]:
            continue
        chans = get(f"/guilds/{g['id']}/channels", tok) or []
        names = {c["id"]: c["name"] for c in chans}
        for c in chans:
            if c["type"] in TEXT_TYPES:
                out.append({**c, "guild": g["name"], "parent": names.get(c.get("parent_id") or "", "")})
        for t in (get(f"/guilds/{g['id']}/threads/active", tok) or {}).get("threads", []):
            out.append({**t, "guild": g["name"], "parent": names.get(t.get("parent_id") or "", "")})
    return out


def bare(name: str) -> str:
    """Channel name without its decorative emoji prefix: "🫡-general" -> "general"."""
    return re.sub(r"^[^\w]+-?", "", name.lower()).strip()


def resolve(tok: str, query: str, guild: str | None):
    q = bare(query.lstrip("#").strip())
    if q.isdigit():
        c = get(f"/channels/{q}", tok)
        return [c] if c else []
    cands = catalog(tok, guild)
    exact = [c for c in cands if bare(c["name"]) == q]
    return exact or [c for c in cands if q in bare(c["name"])]


def name_of(m: dict) -> str:
    member = m.get("member") or {}
    a = m.get("author", {})
    return member.get("nick") or a.get("global_name") or a.get("username", "?")


def render(m: dict) -> str:
    ts = datetime.fromisoformat(m["timestamp"]).astimezone().strftime("%a %b %d %H:%M")
    body = m.get("content", "").strip()
    for a in m.get("attachments", []):
        body += f" [attachment: {a.get('filename')}]"
    for e in m.get("embeds", []):
        if e.get("title") or e.get("url"):
            body += f" [embed: {e.get('title') or e.get('url')}]"
    if m.get("sticker_items"):
        body += " [sticker]"
    ref = m.get("referenced_message")
    lead = f"(reply to {name_of(ref)}) " if ref else ""
    return f"{ts} {name_of(m)}: {lead}{body or '[no text]'}"


def read(tok: str, chan: dict, limit: int, hours: float | None, before: str | None) -> list[str]:
    cutoff = datetime.now(timezone.utc) - timedelta(hours=hours) if hours else None
    msgs: list[dict] = []
    while len(msgs) < limit:
        path = f"/channels/{chan['id']}/messages?limit={min(100, limit - len(msgs))}"
        if before:
            path += f"&before={before}"
        batch = get(path, tok)
        if not batch:
            break
        stop = False
        for m in batch:
            if cutoff and datetime.fromisoformat(m["timestamp"]) < cutoff:
                stop = True
                break
            msgs.append(m)
        if stop or len(batch) < 100:
            break
        before = batch[-1]["id"]
    return [render(m) for m in reversed(msgs)]


def label(c: dict) -> str:
    kind = TEXT_TYPES.get(c.get("type", 0), "channel")
    where = f" in #{c['parent']}" if c.get("parent") else ""
    return f"#{c['name']} ({kind}{where}, {c.get('guild', '?')}, id {c['id']})"


def main() -> None:
    p = argparse.ArgumentParser(description="Read a Discord channel or thread the MIST bot can see.")
    p.add_argument("channel", help="channel/thread name or id, or 'channels' to list them")
    p.add_argument("--guild", "-g", help="server name (substring) or id")
    p.add_argument("-n", "--limit", type=int, default=50, help="max messages (default 50)")
    p.add_argument("--hours", type=float, help="only messages newer than this many hours")
    p.add_argument("--before", help="page back from this message id")
    a = p.parse_args()
    tok = token()

    if a.channel == "channels":
        for c in sorted(catalog(tok, a.guild), key=lambda c: (c["guild"], c.get("parent") or "", c["name"])):
            print(label(c))
        return

    found = resolve(tok, a.channel, a.guild)
    if not found:
        sys.exit(f"no channel or thread matches {a.channel!r} (try: discord-read channels)")
    if len(found) > 1:
        print(f"{a.channel!r} matches more than one; pass an id or --guild:", file=sys.stderr)
        for c in found:
            print("  " + label(c), file=sys.stderr)
        sys.exit(2)
    chan = found[0]
    lines = read(tok, chan, a.limit, a.hours, a.before)
    header = f"{label(chan)}: {len(lines)} message(s), oldest first"
    text = "\n".join(lines) or "(no messages in range)"
    framed = subprocess.run([str(FRAME), "--source", f"discord #{chan.get('name', a.channel)}"],
                            input=text, capture_output=True, text=True, check=True).stdout
    print(header)
    print(framed)


if __name__ == "__main__":
    main()
