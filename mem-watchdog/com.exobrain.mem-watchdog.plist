<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.mem-watchdog</string>
    <!-- Rooted in /bin/bash on purpose. TCC grants a launchd job the access of
         the program the plist declares, and the job's processes inherit it:
         bash holds Full Disk Access here, /usr/bin/python3 does not. Declared
         as python3, each call into the harness under ~/Documents (the notifier,
         the Discord DM) failed with "Operation not permitted" (2026-09 to
         2026-10-11). Verified with a two-job probe and the live job: bash
         exec-optimizes its single command, so the process image IS python3,
         and the grant still holds. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/alexhedtke/.local/bin/mist-launch</string>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>/usr/bin/python3 "/Users/alexhedtke/Library/Application Support/mem-watchdog/mem-watchdog.py"</string>
    </array>
    <!-- Login Items names a launchd job after its executable ("Bash") unless
         the job is associated with an app; this shows it as MIST Console. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.exobrain.mist-console</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Standard, not Background: the one process that must act under memory
         pressure should not be the lowest-priority process on the machine. -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Application Support/mem-watchdog/launchd-stderr.log</string>
    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Application Support/mem-watchdog/launchd-stderr.log</string>
</dict>
</plist>
