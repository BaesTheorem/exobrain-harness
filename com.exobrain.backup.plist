<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exobrain.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alexhedtke/Documents/Exobrain harness/backup-exobrain.sh</string>
    </array>

    <!-- Catch-up after power-off: launchd doesn't reliably refire missed
         StartCalendarInterval events after a cold boot, so RunAtLoad makes
         the agent fire on login/boot. The script's 20-hour freshness guard
         prevents duplicate backups during normal logins. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Daily at 2:00 AM (local time). Omitting Weekday makes it daily. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/backup.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/alexhedtke/Library/Logs/exobrain/backup.err</string>
</dict>
</plist>
