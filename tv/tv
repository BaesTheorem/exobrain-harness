#!/usr/bin/env python3
"""
tv — CLI for the 2nd-floor Samsung TV ("Mirror of Galadriel").

Usage:
  tv console                 Launch the full-screen TUI dashboard
  tv status                  Power state + model info
  tv on                      Wake-on-LAN (needs Network Standby enabled on TV)
  tv off                     Power off (KEY_POWER — see ./tv off warning)
  tv pause                   KEY_PAUSE
  tv play                    KEY_PLAY
  tv mute                    KEY_MUTE
  tv vol up [N]              Volume up N times (default 1)
  tv vol down [N]            Volume down N times (default 1)
  tv app <name|id>           Launch app: netflix, youtube, prime, plex, disney, hulu, max, spotify, apple — or raw app ID
  tv key <KEY>               Send any KEY_* code (see KEY codes ref)
  tv home                    KEY_HOME
  tv back                    KEY_RETURN
  tv up|down|left|right      Directional keys
  tv ok|enter                KEY_ENTER

Token lives in tv/token.json (gitignored). Re-pair with `tv pair`.
"""

import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import tv_control as t


HELP = __doc__


def cmd_status(args):
    s = t.status()
    if not s["reachable"]:
        print("TV is OFF (no response on control port)")
        sys.exit(1)
    print(f"name:       {s['name']}")
    print(f"model:      {s['model']}")
    print(f"power:      {s['power']}")
    print(f"resolution: {s['resolution']}")


def cmd_on(args):
    t.wake()
    print("Magic packet sent. If Network Standby is enabled, TV will wake in ~5s.")


def cmd_off(args):
    if "--force" not in args and "-f" not in args:
        print("WARNING: WSS power-off puts this TV (Samsung TU7000) into a deep-sleep state where")
        print("WoL stops working and ./tv on cannot wake it. Power back on requires the physical remote.")
        print("Samsung firmware quirk — see README. Pass --force to skip this prompt.")
        print()
        try:
            for i in range(5, 0, -1):
                print(f"  Continuing in {i}s (Ctrl+C to abort)...", end="\r", flush=True)
                time.sleep(1)
            print(" " * 50)
        except KeyboardInterrupt:
            print("\naborted")
            sys.exit(1)
    t.power_off()
    print("Sent KEY_POWER — TV will be unreachable until physically powered on.")


def cmd_pause(args):  t.send_key("KEY_PAUSE"); print("paused")
def cmd_play(args):   t.send_key("KEY_PLAY");  print("playing")
def cmd_mute(args):   t.send_key("KEY_MUTE");  print("muted")
def cmd_home(args):   t.send_key("KEY_HOME");  print("home")
def cmd_back(args):   t.send_key("KEY_RETURN"); print("back")
def cmd_up(args):     t.send_key("KEY_UP")
def cmd_down(args):   t.send_key("KEY_DOWN")
def cmd_left(args):   t.send_key("KEY_LEFT")
def cmd_right(args):  t.send_key("KEY_RIGHT")
def cmd_ok(args):     t.send_key("KEY_ENTER")


def cmd_vol(args):
    if not args or args[0] not in ("up", "down"):
        print("Usage: tv vol up|down [N]", file=sys.stderr)
        sys.exit(2)
    direction = args[0]
    n = int(args[1]) if len(args) > 1 else 1
    key = "KEY_VOLUP" if direction == "up" else "KEY_VOLDOWN"
    for _ in range(n):
        t.send_key(key)
        time.sleep(0.15)
    print(f"vol {direction} x{n}")


def cmd_app(args):
    if not args:
        print(f"Usage: tv app <name|id>\nKnown: {', '.join(sorted(t.APP_IDS))}", file=sys.stderr)
        sys.exit(2)
    t.launch_app(args[0])
    print(f"launched: {args[0]}")


def cmd_key(args):
    if not args:
        print("Usage: tv key KEY_NAME", file=sys.stderr)
        sys.exit(2)
    t.send_key(args[0])
    print(f"sent: {args[0]}")


def cmd_pair(args):
    t.pair()


def cmd_console(args):
    import subprocess
    here = Path(__file__).resolve().parent
    subprocess.run(["/opt/homebrew/bin/python3", str(here / "console" / "tv-console.py")])


COMMANDS = {
    "status": cmd_status, "on": cmd_on, "off": cmd_off,
    "pause": cmd_pause, "play": cmd_play, "mute": cmd_mute,
    "home": cmd_home, "back": cmd_back,
    "up": cmd_up, "down": cmd_down, "left": cmd_left, "right": cmd_right,
    "ok": cmd_ok, "enter": cmd_ok,
    "vol": cmd_vol, "app": cmd_app, "key": cmd_key,
    "pair": cmd_pair, "console": cmd_console,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(HELP)
        sys.exit(0)
    cmd = sys.argv[1]
    args = sys.argv[2:]
    fn = COMMANDS.get(cmd)
    if fn is None:
        print(f"Unknown command: {cmd}\n", file=sys.stderr)
        print(HELP, file=sys.stderr)
        sys.exit(2)
    fn(args)


if __name__ == "__main__":
    main()
