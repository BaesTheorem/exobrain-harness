#!/bin/sh
# Print a valid Google Health access token (the data source behind the `fitbit`
# MCP server). For scripts that call the Google Health API v4 directly.
# Exit 1 = consent needed (bin/fitbit-reauth), 2 = transient failure.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
NODE="$(command -v node || true)"
[ -x "$NODE" ] || NODE=/opt/homebrew/bin/node
[ -x "$NODE" ] || { echo "google-health-token: no node found" >&2; exit 2; }
exec "$NODE" "$DIR/scripts/print-token.mjs"
