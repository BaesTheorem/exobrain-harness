#!/bin/sh
# Launch the Fitbit MCP server (stdio). Registered with:
#   claude mcp add --scope user fitbit -- "<this file>"
# Secrets come from the gitignored harness .env, sourced below:
#   GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET (Google Health API v4)
# The OAuth token lives in ../.google-health-token.json (gitignored, written by
# bin/fitbit-reauth). See ../FORK.md for why this is no longer the upstream fork.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
HARNESS="$(cd "$DIR/.." && pwd)"
if [ -f "$HARNESS/.env" ]; then
    set -a
    . "$HARNESS/.env"
    set +a
fi
if [ ! -f "$DIR/build/index.js" ]; then
    echo "fitbit-mcp: build/ is missing. Run: cd '$DIR' && npm ci && npm run build" >&2
    exit 1
fi
NODE="$(command -v node || true)"
[ -x "$NODE" ] || NODE=/opt/homebrew/bin/node
[ -x "$NODE" ] || { echo "fitbit-mcp: no node on PATH and /opt/homebrew/bin/node is missing" >&2; exit 1; }
exec "$NODE" "$DIR/build/index.js"
